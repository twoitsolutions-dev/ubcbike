{%- assign c = section.settings.collection -%}
<section class="section container">
  <div class="section-head">
    <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
    {%- if c != blank -%}<a href="{{ c.url }}">{{ 'general.view_all' | t }}</a>{%- endif -%}
  </div>
  <ul class="grid">
    {%- if c != blank -%}
      {%- for product in c.products limit: section.settings.limit -%}
        <li>{% render 'product-card', product: product %}</li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <li><article class="card"><div class="card-media"><div class="placeholder">{{ 'products.no_image' | t }}</div></div><div class="card-body"><h3 class="card-title">{{ 'products.sample_product' | t }}</h3></div></article></li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Deals" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Products", "default": 8 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
