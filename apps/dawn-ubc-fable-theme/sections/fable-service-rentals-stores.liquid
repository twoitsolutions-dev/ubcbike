{%- comment -%}
  UBC Dawn V34 — Alafia Trailhead Rentals (#rentals) + Vibrant 4-Card Partner-Logo Financing & Trade-In (#financing)
  Preserves exact UBC brand palette (#FEFDF3, #FFFFFF, #14202D, #E04F33, #CCBB8D) & Anton/Barlow typography.
{%- endcomment -%}
{%- liquid
  assign alafia_phone = section.settings.alafia_phone | default: '(813) 459-8293'
  assign alafia_digits = alafia_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' | remove: '+'
  if alafia_digits.size == 10
    assign alafia_tel = '+1' | append: alafia_digits
  elsif alafia_digits != blank
    assign alafia_tel = '+' | append: alafia_digits
  else
    assign alafia_tel = '+18134598293'
  endif

  assign home_anchor = ''
  if template.name != 'index'
    assign home_anchor = routes.root_url
    unless home_anchor == '/'
      assign home_anchor = home_anchor | append: '/'
    endunless
  endif

  assign acima_href = section.settings.acima_url | default: 'https://ams.acimacredit.com/discover/new?lang=en.leases&location_guid=loca-703aa24e-31e6-4aec-8f39-c1d5c6147cf6&merchant_guid=merc-4949370c-a29b-41d5-b86a-894e8bd532aa'
  assign snap_href = section.settings.snap_url | default: 'https://bk.snapfinance.com/origination?paramId=3w%2FEWVFzVGcQioSdKn1vuqdr2hNr3A1xiMt4CtG%2BqOW6%2FoVDUYR%2B662lEkK1hZ0tog9ZSjNG2GyQln5HQrzShOzYiaK%2FnFnEZXfXtyBXVEw%3D'

  assign sync_logo = images['ubc-financing-synchrony-logo.png']
  assign acima_logo = images['ubc-financing-acima-logo.png']
  assign snap_logo = images['ubc-financing-snap-logo.png']
-%}

<style>
  /* 1. Compact Full-Width Editorial Alafia Rentals Split Card */
  .ubc-alafia-sec {
    background: #FEFDF3;
    padding: 44px 0 36px;
    font-family: var(--ubc-font-body, 'Barlow', sans-serif);
  }
  .ubc-alafia-wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .ubc-alafia-banner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    border-radius: 24px;
    overflow: hidden;
    background: #14202D;
    border: 1px solid rgba(20, 32, 45, 0.14);
    box-shadow: 0 20px 44px -26px rgba(20, 32, 45, 0.42);
  }
  .ubc-alafia-media {
    position: relative;
    min-height: 440px;
    background: #0E1824;
    overflow: hidden;
  }
  .ubc-alafia-media img {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block;
    transition: transform 0.55s ease;
  }
  .ubc-alafia-banner:hover .ubc-alafia-media img {
    transform: scale(1.03);
  }
  .ubc-alafia-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 32, 45, 0.08) 45%, rgba(20, 32, 45, 0.82) 100%);
    pointer-events: none;
  }
  .ubc-alafia-media-bar {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 18px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }
  .ubc-alafia-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(20, 32, 45, 0.82);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(254, 253, 243, 0.22);
    color: #FEFDF3;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 999px;
  }
  .ubc-alafia-tag--gold {
    background: #CCBB8D;
    color: #14202D;
    border-color: #CCBB8D;
  }

  .ubc-alafia-panel {
    padding: clamp(28px, 3.6vw, 44px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    color: #FEFDF3;
  }
  .ubc-alafia-kicker {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 12.5px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #E04F33;
  }
  .ubc-alafia-h2 {
    font-family: var(--ubc-font-display, 'Anton', sans-serif) !important;
    font-weight: 400 !important;
    font-size: clamp(34px, 3.6vw, 48px) !important;
    line-height: 1.02 !important;
    letter-spacing: 0.01em !important;
    text-transform: uppercase;
    color: #FEFDF3 !important;
    margin: 0 !important;
  }
  .ubc-alafia-h2 span {
    color: #CCBB8D;
    display: block;
  }
  .ubc-alafia-lead {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.5;
    color: rgba(254, 253, 243, 0.84);
  }
  .ubc-alafia-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 2px;
  }
  .ubc-alafia-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 22px;
    border-radius: 999px;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 14.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.16s ease, background-color 0.16s ease;
  }
  .ubc-alafia-btn--coral {
    background: #E04F33 !important;
    color: #FFFFFF !important;
  }
  .ubc-alafia-btn--coral:hover {
    background: #C73E23 !important;
    color: #FFFFFF !important;
    transform: translateY(-1px);
  }
  .ubc-alafia-btn--ghost {
    background: rgba(254, 253, 243, 0.08) !important;
    color: #FEFDF3 !important;
    border: 1.5px solid rgba(254, 253, 243, 0.3);
  }
  .ubc-alafia-btn--ghost:hover {
    background: rgba(254, 253, 243, 0.16) !important;
    border-color: #FEFDF3;
  }
  .ubc-alafia-trails {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding-top: 14px;
    margin-top: 4px;
    border-top: 1px solid rgba(254, 253, 243, 0.14);
  }
  .ubc-alafia-trail-link {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 11px 14px;
    border-radius: 14px;
    background: rgba(254, 253, 243, 0.06);
    border: 1px solid rgba(254, 253, 243, 0.12);
    text-decoration: none;
    transition: background-color 0.16s ease, border-color 0.16s ease;
  }
  .ubc-alafia-trail-link:hover {
    background: rgba(254, 253, 243, 0.12);
    border-color: #CCBB8D;
  }
  .ubc-alafia-trail-link strong {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #FEFDF3 !important;
  }
  .ubc-alafia-trail-link span {
    font-size: 12px;
    font-weight: 600;
    color: #CCBB8D !important;
  }

  /* 2. Vibrant Partner-Logo Financing & Trade-In Cards */
  .ubc-fin-sec {
    background: #F3F1E7;
    padding: 52px 0 56px;
    border-top: 1px solid rgba(20, 32, 45, 0.08);
    font-family: var(--ubc-font-body, 'Barlow', sans-serif);
  }
  .ubc-fin-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin-top: 26px;
  }
  .ubc-fin-card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: #FFFFFF;
    border: 1.5px solid rgba(20, 32, 45, 0.1);
    box-shadow: 0 10px 26px -18px rgba(20, 32, 45, 0.25);
    display: flex;
    flex-direction: column;
    padding: 22px 20px 20px;
    gap: 14px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .ubc-fin-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 34px -18px rgba(20, 32, 45, 0.3);
  }
  .ubc-fin-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
  }
  .ubc-fin-card--sync {
    background: #14202D;
    color: #FEFDF3;
    border-color: #14202D;
  }
  .ubc-fin-card--sync::before { background: linear-gradient(90deg, #CCBB8D, #E04F33); }
  .ubc-fin-card--acima::before { background: #E04F33; }
  .ubc-fin-card--snap::before { background: #1F6E43; }
  .ubc-fin-card--trade {
    background: #FEFDF3;
    border-color: rgba(204, 187, 141, 0.85);
  }
  .ubc-fin-card--trade::before { background: #CCBB8D; }

  .ubc-fin-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 44px;
  }
  .ubc-fin-logo-box {
    background: #FFFFFF;
    border-radius: 10px;
    padding: 6px 10px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(20, 32, 45, 0.08);
    max-width: 132px;
  }
  .ubc-fin-logo-box img {
    max-height: 24px;
    max-width: 112px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }
  .ubc-fin-brand-txt {
    font-family: var(--ubc-font-display, 'Anton', sans-serif);
    font-size: 16px;
    letter-spacing: 0.03em;
    color: #14202D;
    text-transform: uppercase;
  }
  .ubc-fin-badge {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 11.5px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .ubc-fin-card--sync .ubc-fin-badge { background: #CCBB8D; color: #14202D; }
  .ubc-fin-card--acima .ubc-fin-badge { background: rgba(224, 79, 51, 0.12); color: #C73E23; }
  .ubc-fin-card--snap .ubc-fin-badge { background: rgba(31, 110, 67, 0.12); color: #1F6E43; }
  .ubc-fin-card--trade .ubc-fin-badge { background: #E04F33; color: #FFFFFF; }

  .ubc-fin-highlight {
    font-family: var(--ubc-font-display, 'Anton', sans-serif);
    font-weight: 400;
    font-size: 28px;
    line-height: 1.04;
    text-transform: uppercase;
    margin: 0;
  }
  .ubc-fin-card--sync .ubc-fin-highlight { color: #CCBB8D; }
  .ubc-fin-card--acima .ubc-fin-highlight { color: #14202D; }
  .ubc-fin-card--snap .ubc-fin-highlight { color: #14202D; }
  .ubc-fin-card--trade .ubc-fin-highlight { color: #14202D; }

  .ubc-fin-sub {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 13.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: -8px 0 0;
  }
  .ubc-fin-card--sync .ubc-fin-sub { color: #FEFDF3; }
  .ubc-fin-card--acima .ubc-fin-sub { color: #E04F33; }
  .ubc-fin-card--snap .ubc-fin-sub { color: #1F6E43; }
  .ubc-fin-card--trade .ubc-fin-sub { color: #8A7548; }

  .ubc-fin-copy {
    margin: 0;
    font-size: 14px;
    line-height: 1.48;
    color: #4A5A6A;
    flex: 1 1 auto;
  }
  .ubc-fin-card--sync .ubc-fin-copy { color: rgba(254, 253, 243, 0.84); }

  .ubc-fin-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 16px;
    border-radius: 12px;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.16s ease, transform 0.16s ease;
  }
  .ubc-fin-card--sync .ubc-fin-btn { background: #E04F33 !important; color: #FFFFFF !important; }
  .ubc-fin-card--sync .ubc-fin-btn:hover { background: #C73E23 !important; }
  .ubc-fin-card--acima .ubc-fin-btn { background: #14202D !important; color: #FEFDF3 !important; }
  .ubc-fin-card--acima .ubc-fin-btn:hover { background: #E04F33 !important; }
  .ubc-fin-card--snap .ubc-fin-btn { background: #14202D !important; color: #FEFDF3 !important; }
  .ubc-fin-card--snap .ubc-fin-btn:hover { background: #1F6E43 !important; }
  .ubc-fin-card--trade .ubc-fin-btn { background: #14202D !important; color: #FEFDF3 !important; }
  .ubc-fin-card--trade .ubc-fin-btn:hover { background: #213549 !important; }

  @media (max-width: 1080px) {
    .ubc-fin-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .ubc-alafia-banner { grid-template-columns: 1fr; }
    .ubc-alafia-media { min-height: 260px; }
  }
  @media (max-width: 560px) {
    .ubc-alafia-sec { padding: 28px 0 24px; }
    .ubc-alafia-trails { grid-template-columns: 1fr; }
    .ubc-fin-grid { grid-template-columns: 1fr; }
  }
</style>

<div class="fb-scope">
  {%- comment -%} 1. Compact Full-Width Editorial Alafia Rentals Split Card {%- endcomment -%}
  <section class="ubc-alafia-sec" id="rentals" aria-label="Alafia River State Park Bike Rentals">
    <div class="ubc-alafia-wrap">
      <div class="ubc-alafia-banner">
        <div class="ubc-alafia-media">
          {%- if section.settings.rental_bike_image != blank -%}
            {{
              section.settings.rental_bike_image
              | image_url: width: 1200
              | image_tag: loading: 'lazy', alt: 'Mountain biker riding the iconic wooden bowl at Alafia River State Park'
            }}
          {%- else -%}
            <img
              src="{{ 'alafia-mtb-action.jpg' | asset_url }}"
              alt="Mountain biker carving the iconic wooden bowl at Alafia River State Park"
              loading="lazy"
            >
          {%- endif -%}
          <div class="ubc-alafia-media-bar">
            <span class="ubc-alafia-tag">Inside Alafia River State Park</span>
            <span class="ubc-alafia-tag ubc-alafia-tag--gold">Peak Season &middot; 28 Trails</span>
          </div>
        </div>

        <div class="ubc-alafia-panel">
          <span class="ubc-alafia-kicker" data-es="Rentas y Tienda &middot; Dentro de Alafia River State Park">Trailhead Shop &amp; Rentals &middot; Inside Alafia</span>
          <h2 class="ubc-alafia-h2" data-es="Alquila en el parque. <span>Rueda directo al sendero.</span>">
            Rent inside the park. <span>Roll straight onto the trail.</span>
          </h2>
          <p class="ubc-alafia-lead" data-es="Bicicletas MTB y e-MTB de doble suspensión calibradas a diario, casco incluido y asistencia mecánica justo al inicio de 20+ millas de senderos — sin portabicicletas.">
            Full-suspension MTB &amp; e-MTB rentals tuned daily by UBC mechanics, helmets included, steps from 20+ miles of Florida singletrack &mdash; no bike rack needed.
          </p>

          <div class="ubc-alafia-ctas">
            <a class="ubc-alafia-btn ubc-alafia-btn--coral" href="/pages/bike-rentals" data-es="Reservar Bicicleta &rarr;">Book Bike Rental &rarr;</a>
            <a class="ubc-alafia-btn ubc-alafia-btn--ghost" href="tel:{{ alafia_tel }}">Call {{ alafia_phone | escape }}</a>
          </div>

          <div class="ubc-alafia-trails">
            <a class="ubc-alafia-trail-link" href="/pages/alafia-interactive-map">
              <strong>Alafia River State Park</strong>
              <span>Primary Park &middot; Open Live Map &rarr;</span>
            </a>
            <a class="ubc-alafia-trail-link" href="/pages/balm-boyette-interactive-map">
              <strong>Balm-Boyette Preserve</strong>
              <span>Approved Cases &middot; Open Live Map &rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} 2. Vibrant Partner-Logo Financing & Bicycle Trade-In Section (#financing) {%- endcomment -%}
  <section class="ubc-fin-sec" id="financing" aria-label="Financing and Bicycle Trade-In Options">
    <div class="ubc-alafia-wrap">
      <div class="fb-sec-head split">
        <div>
          <span class="eyebrow reveal" data-es="Opciones de Pago &middot; En Línea o en Tienda">Flexible Ways to Ride &middot; Online or In-Store</span>
          <h2 class="h2 reveal" data-es="Estrena hoy. <em>Financiamiento 0% APR y Trade-In.</em>">
            Ride today. <em>0% APR financing &amp; bike trade-in.</em>
          </h2>
          <p class="lead reveal" data-es="Precalifica en minutos o combínalo con el valor de tu bici actual en nuestro showroom de Tampa.">
            Pre-qualify in minutes or combine instant trade-in credit with promotional financing on bikes, e-bikes, scooters and gear.
          </p>
        </div>
        <div class="fin-head-cta reveal">
          <a class="link-arrow" href="/pages/financing">
            <span data-es="Ver detalles de financiamiento">Full Financing Details</span>
            <svg aria-hidden="true"><use href="#i-arrow"/></svg>
          </a>
        </div>
      </div>

      <div class="ubc-fin-grid">
        <!-- Card 1: Synchrony (Featured Navy) -->
        <article class="ubc-fin-card ubc-fin-card--sync">
          <div class="ubc-fin-top">
            <div class="ubc-fin-logo-box">
              {%- if sync_logo != blank -%}
                {{ sync_logo | image_url: width: 240 | image_tag: alt: 'Synchrony Freedom to Ride', loading: 'lazy' }}
              {%- else -%}
                <span class="ubc-fin-brand-txt">Synchrony</span>
              {%- endif -%}
            </div>
            <span class="ubc-fin-badge">Most Popular</span>
          </div>
          <h3 class="ubc-fin-highlight">0% APR Promo</h3>
          <p class="ubc-fin-sub">6 to 12 Months Special Financing</p>
          <p class="ubc-fin-copy">
            Split qualifying bikes, e-bikes and gear into equal monthly payments with 0% APR promotional financing via Synchrony Freedom to Ride.
          </p>
          <a class="ubc-fin-btn" href="/pages/financing">
            <span>Apply In-Store or Call</span>
            <span>&rarr;</span>
          </a>
        </article>

        <!-- Card 2: Acima (Coral Accent) -->
        <article class="ubc-fin-card ubc-fin-card--acima">
          <div class="ubc-fin-top">
            <div class="ubc-fin-logo-box">
              {%- if acima_logo != blank -%}
                {{ acima_logo | image_url: width: 240 | image_tag: alt: 'Acima Leasing', loading: 'lazy' }}
              {%- else -%}
                <span class="ubc-fin-brand-txt">Acima</span>
              {%- endif -%}
            </div>
            <span class="ubc-fin-badge">No Credit Needed</span>
          </div>
          <h3 class="ubc-fin-highlight">Up to $5,000</h3>
          <p class="ubc-fin-sub">Flexible Lease-to-Own</p>
          <p class="ubc-fin-copy">
            Fast mobile approvals up to $5,000 with payment schedules matched to your payday and early purchase savings options.
          </p>
          <a class="ubc-fin-btn" href="{{ acima_href | escape }}" target="_blank" rel="noopener">
            <span>Apply Online at Acima</span>
            <span>&nearr;</span>
          </a>
        </article>

        <!-- Card 3: Snap Finance (Emerald Accent) -->
        <article class="ubc-fin-card ubc-fin-card--snap">
          <div class="ubc-fin-top">
            <div class="ubc-fin-logo-box">
              {%- if snap_logo != blank -%}
                {{ snap_logo | image_url: width: 240 | image_tag: alt: 'Snap Finance', loading: 'lazy' }}
              {%- else -%}
                <span class="ubc-fin-brand-txt">Snap Finance</span>
              {%- endif -%}
            </div>
            <span class="ubc-fin-badge">Instant Decision</span>
          </div>
          <h3 class="ubc-fin-highlight">Buy Now, Pay Later</h3>
          <p class="ubc-fin-sub">All Credit Welcome</p>
          <p class="ubc-fin-copy">
            Ideal for bikes, electric scooters, accessories or major workshop builds &mdash; apply online in minutes with instant approval decisions.
          </p>
          <a class="ubc-fin-btn" href="{{ snap_href | escape }}" target="_blank" rel="noopener">
            <span>Apply Online at Snap</span>
            <span>&nearr;</span>
          </a>
        </article>

        <!-- Card 4: Bicycle Blue Book Trade-In (Warm Gold Accent) -->
        <article class="ubc-fin-card ubc-fin-card--trade">
          <div class="ubc-fin-top">
            <div class="ubc-fin-logo-box">
              <span class="ubc-fin-brand-txt">Bicycle Blue Book</span>
            </div>
            <span class="ubc-fin-badge">Instant Credit</span>
          </div>
          <h3 class="ubc-fin-highlight">Bike Trade-In</h3>
          <p class="ubc-fin-sub">Official Partner Valuation</p>
          <p class="ubc-fin-copy">
            Bring your current bike to our Tampa showroom for a transparent valuation and apply instant trade-in credit toward your upgrade.
          </p>
          <a class="ubc-fin-btn" href="{{ home_anchor }}#stores">
            <span>Value Your Trade-In</span>
            <span>&rarr;</span>
          </a>
        </article>
      </div>

      <div class="fin-community-bar reveal" role="note" aria-label="Community In-Store Discounts" style="margin-top:22px;">
        <span class="fin-comm-badge" data-es="Beneficio Permanente UBC">Everyday In-Store Discounts</span>
        <p data-es="En nuestro showroom de Tampa (1220 E Fletcher Ave) honramos todos los días con descuento especial a <strong>Estudiantes, Veteranos y Policías</strong> presentando identificación vigente.">
          At our Tampa showroom (1220 E Fletcher Ave), we proudly honor <strong>Students, U.S. Veterans &amp; Police</strong> every day with special in-store discounts &mdash; just show valid ID at checkout.
        </p>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "UBC Rentals & Financing",
  "settings": [
    {
