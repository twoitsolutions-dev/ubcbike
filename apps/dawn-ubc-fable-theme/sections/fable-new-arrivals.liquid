{%- comment -%}
  UBC Dawn Ecommerce v21 — Unified Storefront Showcase + Promos, Discounts & Activities Hub (#new-arrivals)
  Consolidates Promos/Activities + New Arrivals + Helmets/Gear + Hydration + OEM Parts + Featured Bikes into ONE compact, zero-bloat section.
  Preserves Luminous Classic (#FEFDF3 / #F3F1E7) aesthetic across Classic, Black Friday, Christmas & July 4th editions · 100% Transparent PNGs.
{%- endcomment -%}
{%- liquid
  assign edition = settings.ubc_edition | default: 'classic'
  assign p_helmet = all_products['bell-z20-mips-road-helmet-medium'] | default: all_products['propero-4']
  assign p_tire = all_products['continental-grand-prix-5000-700x28c-tire'] | default: all_products['ground-control-control-2bliss-ready-t5-29-inch']
  assign p_tarmac = all_products['specialized-tarmac-sl7-sport-56cm'] | default: all_products['aethos-2-expert-di2']

  assign helmet_vid = ''
  assign helmet_url = routes.collections_url | append: '/all'
  assign helmet_price = 172.49
  if p_helmet != blank
    assign helmet_vid = p_helmet.selected_or_first_available_variant.id
    assign helmet_url = p_helmet.url
    assign helmet_price = p_helmet.price | divided_by: 100.0
  endif

  assign tire_vid = helmet_vid
  if collections['bicycle-tires'] != blank
    assign tire_url = collections['bicycle-tires'].url
  else
    assign tire_url = routes.collections_url | append: '/all'
  endif
  assign tire_price = 89.95
  if p_tire != blank
    assign tire_vid = p_tire.selected_or_first_available_variant.id
    assign tire_url = p_tire.url
    assign tire_price = p_tire.price | divided_by: 100.0
  endif

  if collections['bikes'] != blank
    assign tarmac_url = collections['bikes'].url
  else
    assign tarmac_url = routes.search_url | append: '?type=product&q=Specialized+Allez'
  endif
  if p_tarmac != blank
    assign tarmac_url = p_tarmac.url
  endif

  assign catalog_col = section.settings.catalog_collection
  assign catalog_url = catalog_col.url | default: routes.all_products_collection_url
  assign browse_label = section.settings.browse_label | default: 'Browse All 20,000+ Items'
-%}

<div class="fb-scope">
  <section class="fb-sec new-arrivals-sec" id="new-arrivals">
    <span id="shop" class="fb-anchor-alias" aria-hidden="true"></span>
    <span id="gear" class="fb-anchor-alias" aria-hidden="true"></span>
    <span id="instock" class="fb-anchor-alias" aria-hidden="true"></span>

    <div class="fb-wrap">
      <div class="fb-sec-head split">
        <div>
          {%- if edition == 'black_friday' -%}
            <span class="eyebrow reveal" data-es="Black Friday UBC &middot; Promos, Descuentos y Destacados">Black Friday Event &middot; Promos, Discounts &amp; Storewide Picks</span>
            <h2 class="h2 reveal" data-es="Ofertas Black Friday. <em>Toda la tienda activa.</em>">Black Friday deals. <em>Every department live.</em></h2>
          {%- elsif edition == 'christmas' -%}
            <span class="eyebrow reveal" data-es="Navidad en UBC &middot; Regalos, Apartados y Promos">Holiday Gift Hub &middot; Promos, Free Bike Hold &amp; Rider Gifts</span>
