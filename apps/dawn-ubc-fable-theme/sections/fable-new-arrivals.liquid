{% schema %}
{
  "name": "UBC Promos & Storefront",
  "max_blocks": 3,
  "settings": [
    {
      "type": "collection",
      "id": "catalog_collection",
      "label": "Full catalog link collection"
    },
    {
      "type": "text",
      "id": "browse_label",
      "label": "Browse all link label",
      "default": "Browse All 20,000+ Items"
    }
  ],
  "blocks": [
    {
      "type": "promo_card",
      "name": "Promo or Activity Card",
      "settings": [
        {
          "type": "select",
          "id": "tone",
          "label": "Card color style",
          "default": "paper",
          "options": [
            { "value": "navy", "label": "UBC Navy (#213549)" },
            { "value": "paper", "label": "UBC Dawn Cream (#FEFDF3)" },
            { "value": "gold", "label": "UBC Heritage Gold (#CCBB8D)" }
          ]
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Offer badge",
          "default": "15% OFF"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Department or date",
          "default": "In-Store & Online"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Card title",
          "default": "Helmet, Tire & Hydration Pack"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short description",
          "default": "Save 15% on hydration, tubes or lights when paired with any MIPS helmet or tire set."
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Link text",
          "default": "Shop Promo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Target URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UBC Promos & Storefront"
    }
  ]
}
