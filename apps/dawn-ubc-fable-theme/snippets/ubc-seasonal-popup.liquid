{%- comment -%}
  [UBC-MOD] Seasonal & Edition-Aware Promotional Popup
  Adapts automatically to all 7 UBC editions (classic, black_friday, christmas,
  july_4, spring, campus, veterans), uses real UBC Tampa & Alafia photos,
  supports live EN / ES switching, and auto-applies accessory-only Shopify
  discount codes via /discount/CODE?redirect=/collections/...
{%- endcomment -%}

{%- assign img_storefront = images['ubc-difference-storefront.jpg'] | image_url: width: 900 -%}
{%- if img_storefront == blank or img_storefront contains 'no-image' -%}
  {%- assign img_storefront = 'ubc-reel-carlos-story.jpg' | asset_url -%}
{%- endif -%}
{%- assign img_carlos = 'ubc-reel-carlos-story.jpg' | asset_url -%}
{%- assign img_alafia_mtb = 'alafia-mtb-action.jpg' | asset_url -%}
{%- assign img_alafia_trail = 'alafia-trails-hero.jpg' | asset_url -%}
{%- assign img_campus = 'ubc-reel-alec-ebike.jpg' | asset_url -%}
{%- assign img_manny = 'ubc-reel-manny-47yrs.jpg' | asset_url -%}

<style>
  .ubc-pop-backdrop {
    position: fixed;
    inset: 0;
    z-index: 99990;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: rgba(14, 23, 34, 0.62);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.28s ease, visibility 0.28s ease;
  }
  .ubc-pop-backdrop.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .ubc-pop-card {
    position: relative;
    width: 100%;
    max-width: 780px;
    display: grid;
    grid-template-columns: 44% 56%;
    background: #FEFDF3;
    color: #14202D;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 28px 70px rgba(10, 18, 28, 0.42), 0 0 0 1px rgba(255, 255, 255, 0.14);
    transform: translateY(18px) scale(0.97);
    transition: transform 0.34s cubic-bezier(0.22, 1, 0.36, 1);
    font-family: 'Barlow', -apple-system, BlinkMacSystemFont, sans-serif;
  }
  .ubc-pop-backdrop.is-open .ubc-pop-card {
    transform: translateY(0) scale(1);
  }
  .ubc-pop-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 4;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(20, 32, 45, 0.14);
    background: rgba(254, 253, 243, 0.94);
    color: #14202D;
    font-size: 20px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .ubc-pop-close:hover {
    background: #14202D;
    color: #FEFDF3;
    transform: scale(1.06);
  }
  .ubc-pop-media {
    position: relative;
    min-height: 390px;
    background: #14202D;
    overflow: hidden;
  }
  .ubc-pop-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ubc-pop-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 32, 45, 0.18) 0%, rgba(20, 32, 45, 0.08) 50%, rgba(20, 32, 45, 0.72) 100%);
    pointer-events: none;
  }
  .ubc-pop-offer-pill {
    position: absolute;
    left: 16px;
    bottom: 16px;
    z-index: 2;
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 14px;
    border-radius: 14px;
    background: var(--ubc-pop-accent, #E04F33);
    color: #FFFFFF;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.28);
  }
  .ubc-pop-offer-pill strong {
    font-family: 'Anton', 'Barlow Condensed', sans-serif;
    font-size: 26px;
    line-height: 1;
    letter-spacing: 0.02em;
    font-weight: 400;
  }
  .ubc-pop-offer-pill span {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.94;
  }
  .ubc-pop-body {
    padding: 28px 30px 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    border-top: 4px solid var(--ubc-pop-accent, #E04F33);
  }
  .ubc-pop-eyebrow {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ubc-pop-accent, #E04F33);
    padding-right: 32px;
  }
  .ubc-pop-title {
    margin: 0;
    font-family: 'Anton', 'Barlow Condensed', sans-serif;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.06;
    letter-spacing: 0.01em;
    color: #14202D;
    font-weight: 400;
  }
  .ubc-pop-desc {
    margin: 0;
    font-size: 15px;
    line-height: 1.48;
    color: #364759;
  }
  .ubc-pop-codebox {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 12px 10px 14px;
    border-radius: 12px;
    background: #FFFFFF;
    border: 1.5px dashed var(--ubc-pop-accent, #E04F33);
    margin-top: 2px;
  }
  .ubc-pop-code-meta {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .ubc-pop-code-label {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #5D6D7E;
  }
  .ubc-pop-code-val {
    font-family: 'Barlow Condensed', monospace;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #14202D;
  }
  .ubc-pop-copy {
    border: none;
    border-radius: 999px;
    padding: 8px 14px;
    background: #14202D;
    color: #FEFDF3;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.16s ease, transform 0.16s ease;
  }
  .ubc-pop-copy:hover {
    background: var(--ubc-pop-accent, #E04F33);
    transform: translateY(-1px);
  }
  .ubc-pop-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 4px;
  }
  .ubc-pop-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 13px 20px;
    border-radius: 999px;
    background: var(--ubc-pop-accent, #E04F33);
    color: #FFFFFF !important;
    text-decoration: none;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: filter 0.16s ease, transform 0.16s ease;
  }
  .ubc-pop-cta:hover {
    filter: brightness(0.92);
    transform: translateY(-1px);
    color: #FFFFFF !important;
  }
  .ubc-pop-subrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .ubc-pop-secondary {
    font-size: 13px;
    font-weight: 600;
    color: #14202D !important;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ubc-pop-dismiss {
    background: none;
    border: none;
    padding: 4px 0;
    font-size: 12.5px;
    color: #64748B;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .ubc-pop-dismiss:hover {
    color: #14202D;
  }
  .ubc-pop-fine {
    margin: 2px 0 0;
    font-size: 11.5px;
    line-height: 1.4;
    color: #64748B;
    border-top: 1px solid rgba(20, 32, 45, 0.1);
    padding-top: 10px;
  }

  @media (max-width: 720px) {
    .ubc-pop-card {
      grid-template-columns: 1fr;
      max-width: 400px;
      border-radius: 18px;
    }
    .ubc-pop-media {
      min-height: 165px;
      max-height: 180px;
    }
    .ubc-pop-body {
      padding: 18px 18px 16px;
      gap: 10px;
      border-top: none;
    }
    .ubc-pop-title {
      font-size: 24px;
    }
    .ubc-pop-desc {
      font-size: 13.5px;
    }
    .ubc-pop-offer-pill {
      left: 12px;
      bottom: 12px;
      padding: 7px 11px;
    }
    .ubc-pop-offer-pill strong {
      font-size: 20px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ubc-pop-backdrop,
    .ubc-pop-card {
      transition: none !important;
    }
  }
</style>

<div
  id="ubcSeasonalPopup"
  class="ubc-pop-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="ubcPopTitle"
  aria-hidden="true"
>
  <div class="ubc-pop-card" id="ubcPopCard">
    <button type="button" class="ubc-pop-close" id="ubcPopClose" aria-label="Close popup">&times;</button>
    <div class="ubc-pop-media">
      <img id="ubcPopImg" src="{{ img_storefront }}" alt="University Bicycle Center Tampa" loading="lazy" width="600" height="500">
      <div class="ubc-pop-offer-pill">
        <strong id="ubcPopBadgeBig">10% OFF</strong>
        <span id="ubcPopBadgeSub">Accessories &amp; Gear</span>
      </div>
    </div>
    <div class="ubc-pop-body">
      <div class="ubc-pop-eyebrow" id="ubcPopEyebrow">WELCOME TO UBC TAMPA · SINCE 1972</div>
      <h2 class="ubc-pop-title" id="ubcPopTitle">10% Off Accessories &amp; Gear</h2>
      <p class="ubc-pop-desc" id="ubcPopDesc"></p>

      <div class="ubc-pop-codebox">
        <div class="ubc-pop-code-meta">
          <span class="ubc-pop-code-label" id="ubcPopCodeLabel">Accessory Promo Code</span>
          <span class="ubc-pop-code-val" id="ubcPopCodeVal">UBC10GEAR</span>
        </div>
        <button type="button" class="ubc-pop-copy" id="ubcPopCopy">Copy Code</button>
      </div>

      <div class="ubc-pop-actions">
        <a href="/discount/UBC10GEAR?redirect=/collections/accessories-gear" class="ubc-pop-cta" id="ubcPopCta">
          Apply Code &amp; Shop Accessories &rarr;
        </a>
        <div class="ubc-pop-subrow">
          <a href="/collections/accessories-gear" class="ubc-pop-secondary" id="ubcPopSecondary" style="display:none;"></a>
          <button type="button" class="ubc-pop-dismiss" id="ubcPopDismiss">No thanks, continue browsing</button>
        </div>
      </div>

      <p class="ubc-pop-fine" id="ubcPopFine"></p>
    </div>
  </div>
</div>

<script>
(function () {
  var backdrop = document.getElementById('ubcSeasonalPopup');
  var card = document.getElementById('ubcPopCard');
  if (!backdrop || !card) return;

  var POPUPS = {
    classic: {
