<section class="hero">
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'hero-media', loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 2000', sizes: '100vw', alt: section.settings.image.alt | escape }}
  {%- endif -%}
  <div class="container hero-content">
    <h1>{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.text != blank -%}<div class="hero-text">{{ section.settings.text }}</div>{%- endif -%}
    <div class="hero-actions">
      {%- if section.settings.button_label != blank -%}<a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}
      {%- if section.settings.button2_label != blank -%}<a class="button button--secondary" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label | escape }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Use only photos UBC owns or is licensed to use" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ride further with University Bicycle Center" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Bikes, e-bikes, parts and expert service — in stock at UBC or ordered from our distributors for you.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop bikes" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label", "default": "Book a service" },
    { "type": "url", "id": "button2_link", "label": "Second button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
