        "Carrollwood, FL",
        "New Tampa, FL",
        "Lutz, FL",
        "Wesley Chapel, FL",
        "Brandon, FL",
        "Riverview, FL",
        "Lithia, FL"
      ],
      "sameAs": [
        "https://www.instagram.com/ubcbike.tampa/"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Bicycle Sales, Service & Tune-Up Packages",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
