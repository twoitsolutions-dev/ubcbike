          />
        </svg>
      {%- else -%}
        <svg class="foot-word-svg" viewBox="0 0 1400 260" fill="none" xmlns="http://www.w3.org/2000/svg" role="presentation">
          <text
            x="50%"
            y="220"
            text-anchor="middle"
            font-family="Anton, Impact, sans-serif"
            font-size="236"
            letter-spacing="4"
            fill="none"
            stroke="#ccbb8d"
            stroke-width="2"
            vector-effect="non-scaling-stroke"
          >{{ section.settings.giant_word | escape }}</text>
        </svg>
      {%- endif -%}
    </div>

    <div class="fb-wrap">
      <div class="foot-bottom">
        <span>&copy; {{ 'now' | date: '%Y' }} University Bicycle Center &middot; Tampa &amp; Lithia, Florida</span>
        <span>Built by <a href="https://www.twoitsolutions.com" target="_blank" rel="noopener" style="color:inherit;text-decoration:underline;text-underline-offset:3px">TwoIT Solutions LLC</a></span>
      </div>
    </div>
  </footer>
</div>

{% schema %}
{
  "name": "UBC Ecommerce Footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "giant_word",
      "label": "Monumental wordmark",
      "default": "SINCE 1972"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Footer showroom phone",
      "default": "(813) 971-2277"
    },
    {
      "type": "text",
      "id": "col1_heading",
      "label": "Column 1 heading",
      "default": "Shop & Promos"
    },
    {
      "type": "link_list",
      "id": "footer_menu_1",
      "label": "Column 1 menu (optional Shopify menu)"
    },
    {
      "type": "text",
      "id": "col2_heading",
      "label": "Column 2 heading",
      "default": "Workshop & Park"
    },
    {
      "type": "link_list",
      "id": "footer_menu_2",
      "label": "Column 2 menu (optional Shopify menu)"
    },
    {
      "type": "text",
      "id": "col3_heading",
      "label": "Column 3 heading",
      "default": "Family & Stores"
    },
    {
      "type": "link_list",
      "id": "footer_menu_3",
      "label": "Column 3 menu (optional Shopify menu)"
    }
  ],
  "presets": [
    {
      "name": "UBC Ecommerce Footer"
    }
  ]
}
{% endschema %}
