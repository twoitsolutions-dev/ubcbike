      {%- comment -%} Unified Storewide Department Tabs + Quick Search {%- endcomment -%}
      <div class="na-toolbar reveal">
        <div class="chips scroll-chips" id="newArrivalsTabs" role="group" aria-label="Filter store catalog by department">
          <button class="chip chip--sm" type="button" data-na-cat="all" aria-pressed="true" data-es="Destacados">All Featured</button>
          <button class="chip chip--sm" type="button" data-na-cat="deals" aria-pressed="false" data-es="Promos y Combos">Deals &amp; Bundles</button>
          <button class="chip chip--sm" type="button" data-na-cat="helmets" aria-pressed="false" data-es="Cascos y Luces">Helmets &amp; Lights</button>
          <button class="chip chip--sm" type="button" data-na-cat="nutrition" aria-pressed="false" data-es="Hidratación y Energía">Hydration &amp; Fuel</button>
          <button class="chip chip--sm" type="button" data-na-cat="parts" aria-pressed="false" data-es="Llantas y Piezas OEM">Tires &amp; OEM Parts</button>
          <button class="chip chip--sm" type="button" data-na-cat="bikes" aria-pressed="false" data-es="Bicis y E-Bikes">Bikes &amp; E-Bikes</button>
        </div>

        <div class="na-search-mini">
          <svg aria-hidden="true"><use href="#i-search"/></svg>
          <label class="sr-only" for="naSearchInput">Filter featured gear and bikes</label>
          <input
            id="naSearchInput"
            type="search"
            placeholder="Filter helmets, GP5000, Skratch…"
            data-es-placeholder="Filtrar cascos, GP5000, Skratch…"
            autocomplete="off"
          >
        </div>
      </div>

      <div class="grid-products na-grid" id="newArrivalsGrid" aria-live="polite"></div>

      <div class="na-more-row" id="naMoreWrap" hidden>
        <button type="button" class="fb-btn outline sm" id="naMoreBtn" aria-expanded="false">
          <span id="naMoreTxt" data-es="Mostrar 4 artículos más">Show 4 More Items</span>
          <svg aria-hidden="true"><use href="#i-chev"/></svg>
        </button>
        <a class="link-arrow" href="{{ routes.collections_url }}/all">
          <span data-es="Ver Todo el Catálogo en Stock">Browse All In-Stock Products</span>
          <svg aria-hidden="true"><use href="#i-arrow"/></svg>
        </a>
      </div>
    </div>

    <script type="application/json" id="FableNewArrivalsData">
      {%- if collections['all'] != blank and collections['all'].products_count > 0 -%}
        [
          {%- assign na_emitted = 0 -%}
          {%- assign na_sources = 'helmets:helmets:4,hydration-nutrition:nutrition:4,nutrition:nutrition:4,tires-tubes:parts:4,parts:parts:4,bikes:bikes:4,all:parts:8' | split: ',' -%}
          {%- assign na_seen_handles = ',' -%}
          {%- for src in na_sources -%}
            {%- if na_emitted >= 16 -%}{%- break -%}{%- endif -%}
            {%- assign sp = src | split: ':' -%}
            {%- assign sh = sp[0] -%}
            {%- assign scat = sp[1] -%}
            {%- assign smax = sp[2] | plus: 0 -%}
            {%- assign sc = collections[sh] -%}
            {%- if sc != blank and sc.products_count > 0 -%}
              {%- assign group_count = 0 -%}
              {%- for p in sc.products limit: 16 -%}
                {%- if group_count >= smax or na_emitted >= 16 -%}{%- break -%}{%- endif -%}
                {%- if p.featured_image == blank or p.available == false -%}{%- continue -%}{%- endif -%}
                {%- assign h_token = ',' | append: p.handle | append: ',' -%}
                {%- if na_seen_handles contains h_token -%}{%- continue -%}{%- endif -%}
                {%- assign na_seen_handles = na_seen_handles | append: p.handle | append: ',' -%}
                {%- liquid
                  assign v = p.selected_or_first_available_variant
                  assign price_num = v.price | divided_by: 100.0
                  assign bf_num = v.price | times: 88 | divided_by: 10000.0
                  assign xmas_num = v.price | times: 90 | divided_by: 10000.0
                  assign july_num = v.price | times: 90 | divided_by: 10000.0
                  assign is_pickup = false
                  assign vd = p.vendor | downcase
                  if scat == 'bikes' and vd == 'specialized'
                    assign is_pickup = true
                  endif
                  assign is_deal = false
                  if v.compare_at_price > v.price or group_count == 0
                    assign is_deal = true
                  endif
                  assign store_lbl_en = 'In Stock Today'
                  assign store_lbl_es = 'En Stock Hoy'
                  if p.tags contains 'ubc-tampa-stock' and p.tags contains 'ubc-alafia-stock'
                    assign store_lbl_en = 'Tampa & Alafia'
                    assign store_lbl_es = 'Tampa y Alafia'
                  elsif p.tags contains 'ubc-alafia-stock'
                    assign store_lbl_en = 'Alafia Park'
                    assign store_lbl_es = 'En Alafia'
                  elsif p.tags contains 'ubc-tampa-stock'
                    assign store_lbl_en = 'UBC Tampa'
                    assign store_lbl_es = 'En Tampa'
                  endif
                -%}
                {%- if na_emitted > 0 -%},{%- endif -%}
                {
                  "id": {{ p.handle | prepend: 'na-' | json }},
                  "cat": {{ scat | json }},
                  "promo": {{ is_deal | json }},
                  "b": {{ p.vendor | default: 'UBC' | json }},
                  "n": {{ p.title | json }},
                  "p": {{ price_num }},
                  "bfPrice": {{ bf_num }},
                  "xmasPrice": {{ xmas_num }},
                  "julyPrice": {{ july_num }},
                  "u": {{ p.url | json }},
                  "variantId": {{ v.id | json }},
                  "img": {{ p.featured_image | image_url: width: 800 | json }},
                  "pickupOnly": {{ is_pickup | json }},
                  "tagClassic": [{{ store_lbl_en | json }}, {{ store_lbl_es | json }}],
                  "tagBf": ["Black Friday Pick", "Selección BF"],
                  "tagXmas": ["Holiday Rider Gift", "Regalo Ciclista"],
                  "tagJuly": ["Summer Ride Pick", "Favorito Verano"]
                }
                {%- assign na_emitted = na_emitted | plus: 1 -%}
                {%- assign group_count = group_count | plus: 1 -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      {%- else -%}
      [
        {
          "id": "na-propero4",
          "cat": "helmets",
          "promo": true,
          "b": "Specialized",
          "n": "Propero 4 MIPS Helmet",
          "p": 199.99,
          "promoPrice": 179.99,
          "bfPrice": 159.99,
          "xmasPrice": 169.99,
          "julyPrice": 169.99,
          "u": {{ helmet_url | json }},
          "variantId": {{ helmet_vid | json }},
          "img": {{ 'spz-propero-4.png' | asset_url | json }},
          "pickupOnly": false,
          "tagClassic": ["10% Off · 5-Star VT", "10% Off · MIPS"],
          "tagBf": ["Save 20% · BF", "20% Off · BF"],
          "tagXmas": ["Top Rider Gift", "Regalo Estrella"],
          "tagJuly": ["Summer Aero Pick", "Oferta Verano"]
        },
        {
          "id": "na-skratch",
          "cat": "nutrition",
          "promo": true,
          "b": "Skratch Labs",
          "n": "Sport Hydration Drink Mix",
          "p": 24.95,
          "promoPrice": 21.95,
          "bfPrice": 19.95,
          "xmasPrice": 20.95,
          "julyPrice": 19.95,
          "u": {{ routes.collections_url | append: '/all' | json }},
          "variantId": {{ helmet_vid | json }},
          "img": {{ 'supp-skratch-hydration.png' | asset_url | json }},
          "pickupOnly": false,
          "tagClassic": ["Bundle Save 15%", "Combo -15%"],
          "tagBf": ["BF Fuel Deal", "Oferta BF"],
          "tagXmas": ["Stocking Stuffer", "Detalle Ciclista"],
          "tagJuly": ["3-for-2 Summer Fuel", "Promo Hidratación"]
        },
        {
          "id": "na-gp5000",
          "cat": "parts",
          "promo": true,
          "b": "Continental",
          "n": "Grand Prix 5000 700x28c Tire",
          "p": {{ tire_price | json }},
          "promoPrice": 79.95,
          "bfPrice": 69.95,
          "xmasPrice": 74.95,
          "julyPrice": 74.95,
          "u": {{ tire_url | json }},
          "variantId": {{ tire_vid | json }},
          "img": {{ 'spz-cannibal-tire.png' | asset_url | json }},
          "pickupOnly": false,
          "tagClassic": ["Pair Promo", "Promo Par"],
          "tagBf": ["Save $20 · BF", "Ahorra $20"],
          "tagXmas": ["Road Upgrade", "Regalo Ruta"],
          "tagJuly": ["Summer Miles Deal", "Oferta Ruta"]
        },
        {
          "id": "na-allez-2026",
          "cat": "bikes",
          "promo": false,
          "b": "Specialized",
          "n": "Allez 2026 Road Build",
          "p": 1599.99,
          "bfPrice": 1399.99,
