{%- comment -%}
  UBC Dawn Ecommerce v15 — Interactive Pro-Shop (Accessories, Hydration/Supplements & OEM Parts)
  Official UBC Brand Colors + Option A Coral (#E04F33) · 100% Real Studio Photos · Wired to Dawn Cart Drawer AJAX
{%- endcomment -%}
{%- liquid
  assign p_tire = all_products['continental-grand-prix-5000-700x28c-tire']
  assign p_helmet = all_products['bell-z20-mips-road-helmet-medium']

  assign tire_vid = ''
  assign tire_price = 79.99
  assign tire_url = routes.collections_url | append: '/all'
  if p_tire != blank
    assign tire_vid = p_tire.selected_or_first_available_variant.id
    assign tire_price = p_tire.price | divided_by: 100.0
    assign tire_url = p_tire.url
  endif

  assign helmet_vid = ''
  assign helmet_price = 189.99
  assign helmet_url = routes.collections_url | append: '/all'
  if p_helmet != blank
    assign helmet_vid = p_helmet.selected_or_first_available_variant.id
    assign helmet_price = p_helmet.price | divided_by: 100.0
    assign helmet_url = p_helmet.url
  endif
-%}

<div class="fb-scope">
  <section class="fb-sec gear-explorer" id="gear">
    <div class="fb-wrap">
      <div class="fb-sec-head split">
        <div>
          <span class="eyebrow reveal" data-es="Equipo, Suplementos y Repuestos">Gear, Supplements &amp; Parts</span>
          <h2 class="h2 reveal" data-es="Lo esencial <em>que cambia cada rodada.</em>">Small stuff. <em>Big difference.</em></h2>
        </div>
        <a class="link-arrow reveal" href="{{ routes.search_url }}?q=Specialized">
          <span data-es="Explorar más de 20,000 productos">Browse 20,000+ Catalog Items</span> <svg><use href="#i-arrow"/></svg>
        </a>
      </div>

      <div class="gear-shell reveal">
        <div class="gear-toolbar">
          <div class="gear-cat-tabs chips--wrap" id="gearCatTabs" role="tablist" aria-label="Equipment categories">
            <button type="button" class="gear-tab" role="tab" aria-selected="true" data-gcat="all">
              <span data-es="Todo el Equipo">All Gear</span> <small>12</small>
            </button>
            <button type="button" class="gear-tab" role="tab" aria-selected="false" data-gcat="accessories">
              <span data-es="Cascos y Luces">Helmets &amp; Lights</span> <small>4</small>
            </button>
            <button type="button" class="gear-tab" role="tab" aria-selected="false" data-gcat="supplements">
              <span data-es="Nutrición e Hidratación">Hydration &amp; Fuel</span> <small>4</small>
            </button>
            <button type="button" class="gear-tab" role="tab" aria-selected="false" data-gcat="parts">
              <span data-es="Partes y Llantas">Parts &amp; Tires</span> <small>4</small>
            </button>
          </div>

          <div class="gear-subbar">
            <div class="chips chips--wrap" id="gearTagPills" role="group" aria-label="Quick filters">
              <button type="button" class="chip chip--sm" data-gtag="all" aria-pressed="true" data-es="Todos">All</button>
              <button type="button" class="chip chip--sm" data-gtag="ebike" aria-pressed="false" data-es="Para E-Bike">E-Bike Ready</button>
              <button type="button" class="chip chip--sm" data-gtag="heat" aria-pressed="false" data-es="Clima de Florida">Florida Heat</button>
              <button type="button" class="chip chip--sm" data-gtag="tampa" aria-pressed="false" data-es="En Stock Tampa">In Stock Tampa</button>
            </div>

            <div class="gear-search">
              <svg><use href="#i-search"/></svg>
              <input
                type="search"
                id="gearSearchInput"
                enterkeyhint="search"
                placeholder="Filter gear (MIPS, Skratch, Power, GP5000…)"
                data-es-placeholder="Filtrar equipo (MIPS, Skratch, Power, GP5000…)"
                aria-label="Filter equipment items"
              >
            </div>
          </div>
        </div>

        <div class="gear-grid" id="gearInteractiveGrid" aria-live="polite"></div>
        <div class="gear-more-wrap" id="gearMoreWrap" hidden>
          <button type="button" class="fb-btn outline sm" id="gearShowMoreBtn" aria-expanded="false">
            <span id="gearShowMoreTxt">Show All 12 Pro-Shop Items (+8)</span>
          </button>
        </div>
      </div>
    </div>

    <script type="application/json" id="FableGearData">
      [
