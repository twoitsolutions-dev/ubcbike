# ============================================================================
# UBC COMMERCE HUB — PLUG-AND-PLAY ENVIRONMENT CONFIGURATION
# Default mode: APP_MODE=demo (safe for local & hosted demonstration).
# To connect live production systems once credentials are populated:
#   APP_MODE=live
#   LIVE_MODE_ACK=I_UNDERSTAND_THIS_CONNECTS_REAL_SYSTEMS
# NEVER paste secrets or tokens in chat or .env.example; keep secrets in .env!
# ============================================================================

APP_MODE=demo
# LIVE_MODE_ACK=I_UNDERSTAND_THIS_CONNECTS_REAL_SYSTEMS

DATABASE_URL=postgresql://ubc:ubc@127.0.0.1:5432/ubc_commerce_hub
PORT=8787
HOST=127.0.0.1
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
LOG_LEVEL=info
DEMO_WEBHOOK_SECRET=demo-webhook-secret-not-for-production

# ----------------------------------------------------------------------------
# 1. SHOPIFY (Trial/Basic Dev Store or Production Shopify Plus)
# Supported SHOPIFY_PLAN values: trial | basic | grow | standard | advanced | plus
#
# Authentication (2026+ Shopify Dev Dashboard Apps — Recommended):
#   Create an app in Shopify Dev Dashboard, grant scopes (read_products,
#   read_inventory, read_locations, read_orders; add write_* only when ready),
#   install it on the store, and set SHOPIFY_CLIENT_ID + SHOPIFY_CLIENT_SECRET
#   inside your local .env file.
# ----------------------------------------------------------------------------
SHOPIFY_PLAN=plus
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_WRITES_ENABLED=false
SHOPIFY_PHYSICAL_LOCATION_ID=
SHOPIFY_DELIVERY_CUSTOMIZATION_ENABLED=true

# ----------------------------------------------------------------------------
# 2. LIGHTSPEED RETAIL R-SERIES (Physical Store POS, Stock & Event Parity)
# Everyday promotions run online-only ('online'). In-store POS price parity
# ('online_and_pos') is opt-in strictly for major omnichannel events such as
# Black Friday, Christmas, or Annual Storewide Clearance.
# ----------------------------------------------------------------------------
LIGHTSPEED_R_CLIENT_ID=
LIGHTSPEED_R_CLIENT_SECRET=
LIGHTSPEED_R_REFRESH_TOKEN=
LIGHTSPEED_R_ACCOUNT_ID=
LIGHTSPEED_R_PHYSICAL_SHOP_ID=1
LIGHTSPEED_R_TOKEN_URL=https://cloud.lightspeedapp.com/auth/oauth/token
LIGHTSPEED_R_API_BASE=https://api.lightspeedapp.com/API/V3
LIGHTSPEED_R_POS_EVENT_WRITES_ENABLED=false
LIGHTSPEED_WRITES_ENABLED=false

# ----------------------------------------------------------------------------
# 3. AUTHORIZED SUPPLIERS (UBC Dealer Accounts Confirmed — Ready to Connect)
# ----------------------------------------------------------------------------

# Quality Bicycle Products (QBP)
QBP_ACCOUNT_NUMBER=
QBP_API_KEY=
QBP_API_BASE_URL=
QBP_DEALER_AUTHORIZED=true

# J&B Importers (JBI)
JBI_ACCOUNT_NUMBER=
JBI_FEED_URL=
JBI_FEED_CREDENTIAL=
JBI_DEALER_AUTHORIZED=true

# Specialized Bicycle Components (Strict MAP + In-Store Pickup for Complete Bikes)
SPECIALIZED_DEALER_ID=
SPECIALIZED_API_CREDENTIAL=
SPECIALIZED_DEALER_AUTHORIZED=true
SPECIALIZED_BIKES_PICKUP_ONLY=true
