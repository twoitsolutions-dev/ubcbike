{%- comment -%}
  Cinematic feature: full-bleed muted loop video (or photo), location chip, short paragraph,
  two-tone headline bottom-right. A pause button is always available (WCAG 2.2.2); reduced motion starts paused.
{%- endcomment -%}
<section class="cine" aria-labelledby="Cine-{{ section.id }}">
  <div class="cine-media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '1600x', class: 'cine-video', data-cine-video: '' }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'cine-video', loading: 'lazy', widths: '800, 1200, 1600, 2000', sizes: '100vw', alt: section.settings.image.alt | escape }}
    {%- endif -%}
  </div>
  <div class="container cine-inner">
    <div class="cine-top">
      {%- if section.settings.chip != blank -%}
        <p class="cine-chip">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14"><path d="M12 22s7-7.2 7-12.5A7 7 0 0 0 5 9.5C5 14.8 12 22 12 22Z" fill="currentColor"/><circle cx="12" cy="9.5" r="2.6" fill="var(--color-brand-dark)"/></svg>
          {{ section.settings.chip | escape }}
        </p>
      {%- endif -%}
      {%- if section.settings.text != blank -%}<p class="cine-text">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="ubc-btn ubc-btn--gold" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
    <h2 class="cine-title" id="Cine-{{ section.id }}">
      <span class="cine-title-muted">{{ section.settings.word_muted | escape }}</span>
      <span>{{ section.settings.word_bright | escape }}</span>
    </h2>
    {%- if section.settings.video != blank -%}
      <button class="cine-toggle" type="button" data-cine-toggle aria-pressed="false" aria-label="{{ 'ubc.motion.pause_video' | t }}">
        <svg class="cine-icon-pause" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
        <svg class="cine-icon-play" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path d="M8 5l11 7-11 7Z" fill="currentColor"/></svg>
      </button>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cinematic feature",
  "settings": [
    { "type": "video", "id": "video", "label": "Background video", "info": "Muted loop, 8–15 s, landscape. Upload to Shopify (Content → Files)." },
    { "type": "image_picker", "id": "image", "label": "Photo (used when there is no video)" },
    { "type": "text", "id": "chip", "label": "Location chip", "default": "Tampa, FL" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Rent a bike by the day or week. Fitted to you, tuned by our mechanics, ready when you arrive." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Book a rental" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "word_muted", "label": "Headline — first word (muted)", "default": "Bike" },
    { "type": "text", "id": "word_bright", "label": "Headline — second word", "default": "Rentals" }
  ],
  "presets": [{ "name": "Cinematic feature" }]
}
{% endschema %}
