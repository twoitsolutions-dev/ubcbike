{%- comment -%}
  "Inside the bike": every part of the bike is a point placed on the photo itself (positions are % of the image).
  Selecting a part zooms the bike towards it, dims the rest and pulls the part out into a magnified "exploded"
  lens joined by a leader line; the note below explains it, with previous/next to walk through every part.
  Hover/focus only shows the label. Escape or clicking the bike closes. Without JS every note is listed.
{%- endcomment -%}
{%- assign points = section.blocks | where: 'type', 'point' -%}
{%- assign notes = section.blocks | where: 'type', 'note' -%}
{%- if section.settings.image != blank -%}
  {%- assign ratio = section.settings.image.aspect_ratio -%}
{%- else -%}
  {%- assign ratio = section.settings.fallback_ratio | default: '1.647' -%}
{%- endif -%}
<section class="spots" data-spots aria-labelledby="Spots-{{ section.id }}">
  <div class="container spots-inner">
    <div class="spots-head">
      <h2 class="spots-title" id="Spots-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="spots-sub">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>

    <div class="spots-frame">
      <div class="spots-plane" style="aspect-ratio: {{ ratio }};" data-spots-plane>
        <div class="spots-stage" data-spots-stage>
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'spots-img', data-spots-base: '', loading: 'lazy', widths: '700, 1100, 1500, 2000', sizes: '(min-width: 1280px) 1240px, 100vw', alt: section.settings.image.alt | default: section.settings.heading | escape }}
          {%- elsif section.settings.fallback_image != blank -%}
            <img src="{{ section.settings.fallback_image | asset_url }}" class="spots-img" data-spots-base width="1400" height="850" loading="lazy" alt="{{ section.settings.heading | escape }}">
          {%- else -%}
            <div class="spots-img spots-img--drawn" data-spots-base>{% render 'ubc-bike-illustration' %}</div>
          {%- endif -%}
          {%- for block in points -%}
            {%- liquid
              assign detail = ''
              if block.settings.detail_image != blank
                assign detail = block.settings.detail_image | image_url: width: 900
              elsif block.settings.detail_asset != blank
                assign detail = block.settings.detail_asset | asset_url
              endif
            -%}
            <button class="spot" type="button" data-detail="{{ detail }}" data-spec="{{ block.settings.spec | escape }}" style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%;" data-spot="{{ forloop.index0 }}" data-x="{{ block.settings.x }}" data-y="{{ block.settings.y }}" aria-expanded="false" aria-controls="SpotNote-{{ block.id }}" {{ block.shopify_attributes }}>
              <span class="spot-dot" aria-hidden="true"><svg viewBox="0 0 24 24" width="12" height="12"><path d="M12 6v12M6 12h12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></span>
              <span class="spot-label">{{ block.settings.title | escape }}</span>
            </button>
          {%- endfor -%}
        </div>
        <svg class="spots-leader" aria-hidden="true" data-spots-leader><line x1="0" y1="0" x2="0" y2="0" pathLength="1"/></svg>
        <div class="spots-lens" aria-hidden="true" data-spots-lens>
          <span class="spots-lens-img" data-spots-lens-img></span>
          <span class="spots-lens-name" data-spots-lens-name></span>
          <span class="spots-lens-spec" data-spots-lens-spec></span>
        </div>
      </div>
    </div>

    <div class="spots-notes" data-spots-notes>
      {%- if points.size > 1 -%}
        <div class="spots-steps">
          <button type="button" class="spots-step" data-spots-prev aria-label="{{ 'ubc.motion.previous_part' | t }}">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <p class="spots-count"><span data-spots-current>—</span> / {{ points.size }}</p>
          <button type="button" class="spots-step" data-spots-next aria-label="{{ 'ubc.motion.next_part' | t }}">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <p class="spots-hint" data-spots-hint>{{ 'ubc.motion.parts_hint' | t }}</p>
        </div>
      {%- endif -%}
      {%- for block in points -%}
        <div class="spots-note" id="SpotNote-{{ block.id }}" data-spot-note="{{ forloop.index0 }}">
          <h3>{{ block.settings.title | escape }}</h3>
          {%- if block.settings.spec != blank -%}<p class="spots-note-spec">{{ block.settings.spec | escape }}</p>{%- endif -%}
          <div class="spots-note-text">{{ block.settings.text }}</div>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ 'ubc.motion.learn_more' | t }} <span aria-hidden="true">&rarr;</span></a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if notes.size > 0 -%}
      <ul class="spots-foot">
        {%- for block in notes -%}
          <li {{ block.shopify_attributes }}><strong>{{ block.settings.title | escape }}</strong>{{ block.settings.text | escape }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Interactive points",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "An e-bike, inside out." },
    { "type": "text", "id": "text", "label": "Text", "default": "Select a part to take a closer look." },
    { "type": "image_picker", "id": "image", "label": "Main image", "info": "Side view of the bike. Point positions are % of this image." },
    { "type": "text", "id": "fallback_image", "label": "Bundled bike (theme asset)", "default": "ubc-bike-turbo-vado-evo.webp" },
    { "type": "text", "id": "fallback_ratio", "label": "Bundled bike aspect ratio (width ÷ height)", "default": "1.647" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Part",
      "limit": 14,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Motor" },
        { "type": "richtext", "id": "text", "label": "Explanation", "default": "<p>Describe this part in plain language. Use only facts from the manufacturer's spec sheet.</p>" },
        { "type": "text", "id": "spec", "label": "Specification (short)", "info": "From the manufacturer's spec sheet" },
        { "type": "image_picker", "id": "detail_image", "label": "Detail photo of this part", "info": "Shown in the zoom lens" },
        { "type": "text", "id": "detail_asset", "label": "Bundled detail photo (theme asset)" },
        { "type": "range", "id": "x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Horizontal position on the photo", "default": 50 },
        { "type": "range", "id": "y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Vertical position on the photo", "default": 50 },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    },
    {
      "type": "note",
      "name": "Footer note",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Fit & service" },
        { "type": "text", "id": "text", "label": "Text", "default": "Every bike is assembled and checked by our mechanics." }
      ]
    }
  ],
  "presets": [{ "name": "Interactive points" }]
}
{% endschema %}
