{%- comment -%}
  [UBC-MOD] Isolated <head> bridge for University Bicycle Center on Shopify Dawn 16.1.1.
  - Self-hosts Anton + Barlow Condensed + Barlow when `settings.ubc_use_custom_brand_fonts` is enabled (default),
    preventing unnecessary `Assistant` downloads and wiring Dawn's `--font-*` tokens to Anton & Barlow.
  - When `settings.ubc_use_custom_brand_fonts` is disabled in the Theme Editor, bridges Dawn's `font_picker`
    variables (`--font-heading-family` / `--font-body-family`) directly into `--ubc-font-*`.
{%- endcomment -%}
{%- if settings.ubc_use_custom_brand_fonts != false -%}
  {{ 'fable-anton-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'fable-barlow-condensed-700.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  <style>
    @font-face { font-family: 'Anton'; font-style: normal; font-weight: 400; font-display: swap; src: url({{ 'fable-anton-400.woff2' | asset_url }}) format('woff2'); }
    @font-face { font-family: 'Barlow Condensed'; font-style: normal; font-weight: 600; font-display: swap; src: url({{ 'fable-barlow-condensed-600.woff2' | asset_url }}) format('woff2'); }
    @font-face { font-family: 'Barlow Condensed'; font-style: normal; font-weight: 700; font-display: swap; src: url({{ 'fable-barlow-condensed-700.woff2' | asset_url }}) format('woff2'); }
    @font-face { font-family: 'Barlow'; font-style: normal; font-weight: 400; font-display: swap; src: url({{ 'fable-barlow-400.woff2' | asset_url }}) format('woff2'); }
    @font-face { font-family: 'Barlow'; font-style: normal; font-weight: 500; font-display: swap; src: url({{ 'fable-barlow-500.woff2' | asset_url }}) format('woff2'); }
    @font-face { font-family: 'Barlow'; font-style: normal; font-weight: 600; font-display: swap; src: url({{ 'fable-barlow-600.woff2' | asset_url }}) format('woff2'); }
    @font-face { font-family: 'Barlow'; font-style: normal; font-weight: 700; font-display: swap; src: url({{ 'fable-barlow-700.woff2' | asset_url }}) format('woff2'); }
    :root {
      --font-heading-family: 'Anton', 'Barlow Condensed', 'Impact', sans-serif;
      --font-heading-style: normal;
      --font-heading-weight: 400;
      --font-body-family: 'Barlow', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-body-style: normal;
      --font-body-weight: 400;
      --font-body-weight-bold: 700;
      --ubc-font-display: 'Anton', 'Impact', 'Arial Narrow Bold', sans-serif;
      --ubc-font-label: 'Barlow Condensed', 'Arial Narrow', sans-serif;
      --ubc-font-body: 'Barlow', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }
  </style>
{%- else -%}
  <style>
    :root {
      --ubc-font-display: var(--font-heading-family);
      --ubc-font-label: var(--font-heading-family);
      --ubc-font-body: var(--font-body-family);
    }
  </style>
{%- endif -%}
<style>
  :root {
    --fb-pattern-url: url({{ 'fable-pattern.jpg' | asset_url }});
    --fb-ebike-tile-url: url({{ 'fable-ebike-tile.jpg' | asset_url }});
  }
</style>
{{ 'ubc-brand.css' | asset_url | stylesheet_tag }}
{{ 'ubc-sections.css' | asset_url | stylesheet_tag }}
{{ 'ubc-fable.css' | asset_url | stylesheet_tag }}
<link rel="apple-touch-icon" href="{{ 'ubc-apple-touch-icon.png' | asset_url }}">
<script src="{{ 'ubc-motion.js' | asset_url }}" defer="defer"></script>
