{%- comment -%}
  UBC Asymmetric Pill Workshop & Fitting Story (Pin 4 Bottom "WHAT'S NEW")
  - Left giant watermark + editorial Tampa fitting/service story + pill CTA
  - Right asymmetric rounded-left capsule (`border-radius: 999px 0 0 999px`) + overlapping coral badge
{%- endcomment -%}
{%- assign pill_asset = section.settings.fallback_asset | default: 'ubc-bike-aethos.webp' -%}
<section class="ub-pill-story" aria-label="{{ section.settings.heading | escape }}">
  <div class="ub-shell">
    <div class="ub-pill-story__grid">
      <div class="ub-pill-story__copy">
        <span class="ub-pill-story__watermark" aria-hidden="true">{{ section.settings.watermark | escape }}</span>
        <p class="ub-tech__kicker">{{ section.settings.kicker | escape }}</p>
        <h2 class="ub-tech__title">{{ section.settings.heading | escape }}</h2>
        <p class="ub-tech__desc">{{ section.settings.description | escape }}</p>

        <a
          href="{{ section.settings.button_url | default: routes.all_products_collection_url }}"
          class="ub-pill-btn"
        >
          <span>{{ section.settings.button_label | escape }}</span>
          <span aria-hidden="true">+</span>
        </a>
      </div>

      <div class="ub-pill-story__media-wrap">
        <div class="ub-pill-story__frame">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1160
              | image_tag: width: 1160, height: 730, loading: 'lazy', alt: section.settings.heading
            }}
          {%- else -%}
            <img
              src="{{ pill_asset | asset_url }}"
              width="1160"
              height="730"
              loading="lazy"
              alt="{{ section.settings.heading | escape }}"
            >
          {%- endif -%}
        </div>

        {%- if section.settings.badge_text != blank -%}
          <div class="ub-pill-story__badge">
            <span>{{ section.settings.badge_text | escape }}</span>
            <span aria-hidden="true">&rarr;</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UBC Workshop Pill Story",
  "tag": "section",
  "class": "section-ubc-workshop-pill",
  "settings": [
    {
      "type": "text",
      "id": "watermark",
      "label": "Background watermark",
      "default": "WORKSHOP"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow kicker",
      "default": "Precision Fitting & Master Service · Tampa, FL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BUILT, TORQUED & FITTED TO YOUR GEOMETRY"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Story copy",
      "default": "Every complete bicycle at University Bicycle Center includes certified mechanic assembly, hydraulic bleed verification, drivetrain indexing, and an individualized Tampa showroom rider fit since 1972."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "EXPLORE IN-STORE PICKUP"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Capsule image (optional)"
    },
    {
      "type": "text",
      "id": "fallback_asset",
      "label": "Bundled studio cutout filename",
      "default": "ubc-bike-aethos.webp"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Overlapping capsule badge",
      "default": "TAMPA, FL · SERVING RIDERS SINCE 1972"
    }
  ],
  "presets": [
    {
      "name": "UBC Workshop Pill Story"
    }
  ]
}
{% endschema %}
