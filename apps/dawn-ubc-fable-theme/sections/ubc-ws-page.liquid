          <script type="text/javascript" src="https://tradein-widget.bicyclebluebook.com/content/widgets/tradein/v2/jquery/jquery-3.3.1.min.js"></script>
          <script src="https://tradein-widget.bicyclebluebook.com/content/widgets/tradein/v2/select2/js/select2.min.js"></script>
