{%- comment -%}
  UBC Dark Architectural Stage (Pin 2 — "ARGON 18" Reference)
  - Matte charcoal-navy stage with vertical hairlines & outlined stroke years (`1972` / `2026`)
  - Giant sand-gold condensed model title behind the transparent bike cutout
  - Peeking next slide initial & bike wheel on the right edge
  - Bottom HUD bar: `01 [02] 03 04` left, `DISCOVER BIKE` + orange dot CTA center, `⟵ ⟶` thin arrows right
{%- endcomment -%}
<section class="ub-argon" data-ub-argon aria-label="{{ section.settings.aria_label | escape }}">
  {%- for block in section.blocks -%}
    {%- liquid
      assign slide_idx = forloop.index0
      assign total = section.blocks.size
      assign next_idx = slide_idx | plus: 1 | modulo: total
      assign next_block = section.blocks[next_idx]
      assign prod = block.settings.product
      if prod == blank and block.settings.default_handle != blank
        assign prod = all_products[block.settings.default_handle]
      endif
      assign bike_asset = block.settings.bike_asset | default: 'ubc-bike-tarmac-sl9.webp'
      assign next_asset = next_block.settings.bike_asset | default: 'ubc-bike-diverge.webp'
      assign peek_initial = next_block.settings.giant_name | slice: 0, 1 | upcase
      assign discover_url = prod.url | default: block.settings.discover_url | default: routes.all_products_collection_url
    -%}
    <div
      class="ub-argon__stage{% if forloop.first %} is-active{% endif %}"
      data-ub-slide
      {% unless forloop.first %}hidden{% endunless %}
      {{ block.shopify_attributes }}
    >
      <span class="ub-argon__rail-line ub-argon__rail-line--left" aria-hidden="true"></span>
      <span class="ub-argon__rail-line ub-argon__rail-line--right" aria-hidden="true"></span>
      <span class="ub-argon__stroke-year ub-argon__stroke-year--left" aria-hidden="true">{{ block.settings.year_left | escape }}</span>
      <span class="ub-argon__stroke-year ub-argon__stroke-year--right" aria-hidden="true">{{ block.settings.year_right | escape }}</span>

      <div class="ub-argon__center">
        <h2 class="ub-argon__giant-name">{{ block.settings.giant_name | escape }}</h2>

        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 1400
            | image_tag:
              class: 'ub-argon__bike',
              width: 1400,
              height: 880,
              loading: 'lazy',
              alt: block.settings.giant_name
          }}
        {%- elsif prod != blank and prod.featured_image != blank -%}
          {{
            prod.featured_image
            | image_url: width: 1400
            | image_tag:
              class: 'ub-argon__bike',
              width: 1400,
              height: 880,
              loading: 'lazy',
              alt: prod.title
          }}
        {%- else -%}
          <img
            src="{{ bike_asset | asset_url }}"
            class="ub-argon__bike"
            width="1400"
            height="880"
            loading="lazy"
            alt="{{ block.settings.giant_name | escape }}"
          >
        {%- endif -%}

        {%- if total > 1 -%}
          <div class="ub-argon__peek" aria-hidden="true">
            <span class="ub-argon__peek-letter">{{ peek_initial }}</span>
            <img
              src="{{ next_asset | asset_url }}"
              width="680"
              height="428"
              loading="lazy"
              alt=""
            >
          </div>
        {%- endif -%}
      </div>

      <div class="ub-argon__hud">
        <div class="ub-argon__nums" role="tablist" aria-label="Stage slides">
          {%- for hud_block in section.blocks -%}
            <button
              type="button"
              class="ub-argon__num"
              data-ub-go="{{ forloop.index0 }}"
              {% if forloop.index0 == slide_idx %}aria-current="true"{% endif %}
            >
              {{ forloop.index | prepend: '0' | slice: -2, 2 }}
            </button>
          {%- endfor -%}
        </div>

        <a href="{{ discover_url }}" class="ub-argon__discover">
          <span>{{ block.settings.discover_label | escape }}</span>
          <span class="ub-argon__discover-dot" aria-hidden="true"></span>
        </a>

        <div class="ub-argon__arrows">
          <button type="button" class="ub-argon__line-arrow" data-ub-prev aria-label="Previous stage bike">
            &larr;
          </button>
          <button type="button" class="ub-argon__line-arrow" data-ub-next aria-label="Next stage bike">
            &rarr;
          </button>
        </div>
      </div>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "UBC Dark Stage Showcase",
  "tag": "section",
  "class": "section-ubc-argon-stage",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessible region label",
      "default": "Architectural bicycle showcase"
    }
  ],
  "blocks": [
    {
      "type": "stage_bike",
      "name": "Stage bicycle",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Linked Shopify product"
        },
        {
          "type": "text",
          "id": "default_handle",
          "label": "Auto-bind product handle (fallback)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom cutout image (optional)"
        },
        {
          "type": "text",
          "id": "bike_asset",
          "label": "Bundled studio cutout filename",
          "default": "ubc-bike-tarmac-sl9.webp"
        },
        {
          "type": "text",
          "id": "giant_name",
          "label": "Monumental backdrop model name",
          "default": "TARMAC SL9"
        },
        {
          "type": "text",
          "id": "year_left",
          "label": "Left vertical stroke label",
          "default": "1972"
        },
        {
          "type": "text",
          "id": "year_right",
          "label": "Right vertical stroke label",
          "default": "2026"
        },
        {
          "type": "text",
          "id": "discover_label",
          "label": "Center HUD CTA label",
          "default": "DISCOVER BIKE"
        },
        {
          "type": "url",
          "id": "discover_url",
          "label": "Fallback CTA link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UBC Dark Stage Showcase",
      "blocks": [
        {
          "type": "stage_bike"
        }
      ]
    }
  ]
}
{% endschema %}
