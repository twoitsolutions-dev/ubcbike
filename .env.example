# UBC Commerce Hub — environment variables (copy to .env; never commit real values)

# --- Mode -------------------------------------------------------------------
# demo: fictitious data + simulated adapters. live: real connectors (requires LIVE_MODE_ACK).
APP_MODE=demo
# Must be exactly I_UNDERSTAND_THIS_CONNECTS_REAL_SYSTEMS for APP_MODE=live
LIVE_MODE_ACK=

# --- Server -----------------------------------------------------------------
DATABASE_URL=postgres://ubc:ubc_dev@127.0.0.1:5432/ubc_hub
TEST_DATABASE_URL=postgres://ubc:ubc_dev@127.0.0.1:5432/ubc_hub_test
PORT=8787
HOST=127.0.0.1
# true behind HTTPS (production)
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
LOG_LEVEL=info
# Run the job worker inside the API process (set false when running `npm run worker` separately)
RUN_WORKER=true

# --- Seed (DEMO only). If empty, strong passwords are generated and printed once.
SEED_CARLOS_PASSWORD=
SEED_ADMIN_PASSWORD=

# --- Shopify (Admin GraphQL API; custom app on a DEVELOPMENT store first) ----
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Pin a stable version; verify at https://shopify.dev/docs/api/usage/versioning
SHOPIFY_API_VERSION=2026-10
SHOPIFY_WEBHOOK_SECRET=
# Leave false until writes are tested on a dev store and authorised
SHOPIFY_WRITES_ENABLED=false

# --- Lightspeed Retail R-Series (NOT X-Series). Read-only in this phase. -----
LIGHTSPEED_R_CLIENT_ID=
LIGHTSPEED_R_CLIENT_SECRET=
LIGHTSPEED_R_REFRESH_TOKEN=
LIGHTSPEED_R_ACCOUNT_ID=
# Confirm both URLs in the official R-Series developer docs during app registration
LIGHTSPEED_R_TOKEN_URL=
LIGHTSPEED_R_API_BASE=

# --- Suppliers (endpoints are NOT hard-coded; provided by each supplier) -----
QBP_API_KEY=
QBP_API_BASE_URL=
QBP_ACCOUNT_NUMBER=
JBI_ACCOUNT_NUMBER=
JBI_FEED_URL=
JBI_FEED_CREDENTIAL=
SPECIALIZED_DEALER_ID=
SPECIALIZED_API_CREDENTIAL=
