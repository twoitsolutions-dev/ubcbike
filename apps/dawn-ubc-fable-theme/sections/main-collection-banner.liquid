{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .ubc-col-banner-wrap {
    background: #FFFFFF;
    padding: 2.2rem 1.5rem 0.6rem;
  }
  @media screen and (min-width: 990px) {
    .ubc-col-banner-wrap {
      max-width: calc(var(--page-width) + 28rem);
      margin: 0 auto;
      padding: 2.6rem 5rem 0.8rem;
    }
  }
  .ubc-col-banner-wrap .ubc-ws-hero {
    margin-bottom: 0;
  }
  .ubc-col-banner-wrap .ubc-ws-title {
    font-family: var(--label, "Barlow Condensed", sans-serif) !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    font-size: clamp(2.8rem, 4.2vw, 4.2rem) !important;
    line-height: 1.08 !important;
    color: #14202D !important;
    margin: 0 0 0.8rem !important;
    letter-spacing: 0.02em !important;
  }
  .ubc-col-banner-wrap .ubc-ws-lead {
    font-family: var(--ubc-font-body, "Barlow", sans-serif) !important;
    font-size: 1.55rem;
    line-height: 1.55;
    color: #4A5A6A;
    margin: 0;
    max-width: 68ch;
  }
  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
    }
  }
{%- endstyle -%}

<div class="ubc-col-banner-wrap">
  <header class="ubc-ws-hero{% unless section.settings.show_collection_image and collection.image %} ubc-ws-hero--text-only{% endunless %} ubc-ws-hero--compact">
    <div>
      <span class="ubc-ws-kicker">
        {%- if collection.handle == 'black-friday-deals' or collection.handle == 'sales-closeouts' or collection.handle == 'eoy-2026' -%}
          LIMITED-TIME DEALS &amp; CLEARANCE &middot; TAMPA &amp; ALAFIA
        {%- else -%}
          UNIVERSITY BICYCLE CENTER &middot; TAMPA &amp; ALAFIA SINCE 1972
        {%- endif -%}
      </span>
      <h1 class="ubc-ws-title">
        <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
        {{- collection.title | escape -}}
      </h1>

      {%- if section.settings.show_collection_description and collection.description != blank -%}
        <div class="ubc-ws-lead rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_collection_image and collection.image -%}
      <div class="ubc-ws-hero-media">
        <img
          srcset="
            {%- if collection.image.width >= 360 -%}{{ collection.image | image_url: width: 360 }} 360w,{%- endif -%}
            {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if collection.image.width >= 1070 -%}{{ collection.image | image_url: width: 1070 }} 1070w,{%- endif -%}
            {{ collection.image | image_url }} {{ collection.image.width }}w
          "
          src="{{ collection.image | image_url: width: 750 }}"
          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
          alt="{{ collection.image.alt | escape }}"
          width="{{ collection.image.width }}"
          height="{{ collection.image.height }}"
        >
      </div>
    {%- endif -%}
  </header>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
