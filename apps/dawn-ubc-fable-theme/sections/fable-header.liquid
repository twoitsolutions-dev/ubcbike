  <header class="fb-header" id="fbHeader">
    <div class="fb-wrap">
      <div class="fb-logo-group">
        <a class="fb-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} — home">
          {%- if settings.logo != blank -%}
            {{
              settings.logo
              | image_url: width: 520
              | image_tag: width: 172, height: 35, alt: shop.name
            }}
          {%- else -%}
            <img
              class="fb-logo-dark"
              src="{{ 'fable-logo-navy.png' | asset_url }}"
              width="172"
              height="35"
              alt="{{ shop.name | escape }}"
            >
            <img
              class="fb-logo-light"
              src="{{ 'fable-logo-white.png' | asset_url }}"
              width="172"
              height="35"
              alt="{{ shop.name | escape }}"
            >
          {%- endif -%}
        </a>
        <span class="fb-partner-pill fb-partner-pill--campus" aria-hidden="true">
          <img src="{{ 'usf-bulls-logo.png' | asset_url }}" width="28" height="22" alt="">
          <span>USF CAMPUS</span>
        </span>
        <span class="fb-partner-pill fb-partner-pill--vet" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><polygon points="12,2 14.9,8.3 21.8,9.1 16.7,13.8 18.1,20.6 12,17.2 5.9,20.6 7.3,13.8 2.2,9.1 9.1,8.3"/></svg>
          <span>VETERAN FOUNDED</span>
        </span>
      </div>

      <ul class="fb-nav" id="fbNav">
        {%- assign shop_menu = linklists['main-menu'].links.first -%}
        {%- if section.settings.menu != blank and section.settings.menu.links.size > 3 -%}
          {%- for link in section.settings.menu.links -%}
            {%- if link.links != blank -%}
              <li class="has-mega">
                <button type="button" aria-expanded="false" aria-controls="megaNav-{{ forloop.index }}">
                  <span>{{ link.title | escape }}</span>
                  <svg aria-hidden="true"><use href="#i-chev"/></svg>
                </button>
                <div class="mega" id="megaNav-{{ forloop.index }}">
                  <div class="fb-wrap">
                    {%- for childlink in link.links -%}
                      <div>
                        <h4><a href="{{ childlink.url }}">{{ childlink.title | escape }}</a></h4>
                        {%- if childlink.links != blank -%}
                          <ul>
                            {%- for grandchildlink in childlink.links -%}
                              <li>
                                <a href="{{ grandchildlink.url }}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                                  {{ grandchildlink.title | escape }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              </li>
            {%- else -%}
              <li>
                <a
                  {% if forloop.first %}class="nav-accent"{% endif %}
                  href="{{ link.url }}"
                  {% if link.current %}aria-current="page"{% endif %}
                >
                  {%- if forloop.first -%}<i aria-hidden="true"></i>{%- endif -%}
                  <span>{{ link.title | escape }}</span>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <li class="has-mega">
            <button type="button" aria-expanded="false" aria-controls="megaBikes">
              <span data-es="Categorías">Shop</span>
              <svg aria-hidden="true"><use href="#i-chev"/></svg>
            </button>
            <div class="mega" id="megaBikes">
              <div class="fb-wrap{% if shop_menu != blank and shop_menu.links.size >= 4 %} mega-split{% endif %}">
                {%- if shop_menu != blank and shop_menu.links.size >= 4 -%}
                  <div class="mega-rail" role="tablist" aria-label="Shop Departments">
                    {%- for childlink in shop_menu.links -%}
                      <button
                        type="button"
                        class="mega-tab{% if forloop.first %} is-active{% endif %}"
                        role="tab"
                        aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                        data-mega-tab="{{ forloop.index0 }}"
                      >
                        <span class="mega-tab-title">{{ childlink.title | escape }}</span>
                        <span class="mega-tab-meta">
                          <svg aria-hidden="true"><use href="#i-chev"/></svg>
                        </span>
                      </button>
                    {%- endfor -%}
                    <a class="mega-rail-all" href="{{ routes.all_products_collection_url }}">
                      <span data-es="Ver Todo en Stock">Shop All In-Stock</span>
                      <svg aria-hidden="true"><use href="#i-arrow"/></svg>
                    </a>
                  </div>

                  <div class="mega-panels">
                    {%- for childlink in shop_menu.links -%}
                      <div
                        class="mega-panel{% if forloop.first %} is-active{% endif %}"
                        role="tabpanel"
                        data-mega-panel="{{ forloop.index0 }}"
                        {% unless forloop.first %}hidden{% endunless %}
                      >
                        <div class="mega-panel-head">
                          <h4><a href="{{ childlink.url }}">{{ childlink.title | escape }}</a></h4>
                          <a class="mega-panel-all" href="{{ childlink.url }}">
                            <span data-es="Ver todo">View all {{ childlink.title | escape }}</span>
                            <svg aria-hidden="true"><use href="#i-arrow"/></svg>
                          </a>
                        </div>
                        {%- if childlink.links != blank -%}
                          <ul class="mega-grid{% if childlink.links.size <= 8 %} is-2col{% endif %}">
                            {%- for grandchildlink in childlink.links -%}
                              <li>
                                <a href="{{ grandchildlink.url }}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                                  {{ grandchildlink.title | escape }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  </div>

                  {%- liquid
                    assign ed_img = 'ubc-pop-classic.jpg'
                    assign ed_badge = 'Since 1972'
                    assign ed_badge_es = 'Desde 1972'
                    assign ed_title = 'Walk-In Service & 0% APR Financing'
