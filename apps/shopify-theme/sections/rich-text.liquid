<section class="section container rich-text">
  {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  {{ section.settings.text }}
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story.</p>" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
