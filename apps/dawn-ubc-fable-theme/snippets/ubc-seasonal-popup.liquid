{%- comment -%}
  [UBC-MOD] Seasonal & Edition-Aware Promotional Popup
  Adapts automatically to all 7 UBC editions (classic, black_friday, christmas,
  july_4, spring, campus, veterans), uses real UBC Tampa & Alafia photos,
  supports live EN / ES switching, and auto-applies accessory-only Shopify
  discount codes via /discount/CODE?redirect=/collections/...
{%- endcomment -%}

{%- assign img_storefront = 'ubc-pop-classic.jpg' | asset_url -%}
{%- assign img_showroom = 'ubc-pop-bf.jpg' | asset_url -%}
{%- assign img_carlos = 'ubc-pop-christmas.jpg' | asset_url -%}
{%- assign img_alafia_trail = 'ubc-pop-july4.jpg' | asset_url -%}
{%- assign img_alafia_mtb = 'ubc-pop-spring.jpg' | asset_url -%}
{%- assign img_campus = 'ubc-pop-campus.jpg' | asset_url -%}
{%- assign img_manny = 'ubc-pop-veterans.jpg' | asset_url -%}

<style>
  .ubc-pop-backdrop {
    position: fixed;
    inset: 0;
    z-index: 99990;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: rgba(14, 23, 34, 0.62);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.28s ease, visibility 0.28s ease;
  }
  .ubc-pop-backdrop.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .ubc-pop-card {
    position: relative;
    width: 100%;
    max-width: 780px;
    display: grid;
    grid-template-columns: 44% 56%;
    background: #FEFDF3;
    color: #14202D;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 28px 70px rgba(10, 18, 28, 0.42), 0 0 0 1px rgba(255, 255, 255, 0.14);
    transform: translateY(18px) scale(0.97);
    transition: transform 0.34s cubic-bezier(0.22, 1, 0.36, 1);
    font-family: 'Barlow', -apple-system, BlinkMacSystemFont, sans-serif;
  }
  .ubc-pop-backdrop.is-open .ubc-pop-card {
    transform: translateY(0) scale(1);
  }
  .ubc-pop-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 4;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(20, 32, 45, 0.14);
    background: rgba(254, 253, 243, 0.94);
    color: #14202D;
    font-size: 20px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .ubc-pop-close:hover {
    background: #14202D;
    color: #FEFDF3;
    transform: scale(1.06);
  }
  .ubc-pop-media {
    position: relative;
    min-height: 390px;
    background: #14202D;
    overflow: hidden;
  }
  .ubc-pop-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    display: block;
  }
  .ubc-pop-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 32, 45, 0.18) 0%, rgba(20, 32, 45, 0.08) 50%, rgba(20, 32, 45, 0.72) 100%);
    pointer-events: none;
  }
  .ubc-pop-offer-pill {
    position: absolute;
    left: 16px;
    bottom: 16px;
    z-index: 2;
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 14px;
    border-radius: 14px;
    background: var(--ubc-pop-accent, #E04F33);
    color: #FFFFFF;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.28);
  }
  .ubc-pop-offer-pill strong {
    font-family: 'Anton', 'Barlow Condensed', sans-serif;
    font-size: 26px;
    line-height: 1;
    letter-spacing: 0.02em;
    font-weight: 400;
  }
  .ubc-pop-offer-pill span {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.94;
  }
  .ubc-pop-body {
    padding: 28px 30px 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    border-top: 4px solid var(--ubc-pop-accent, #E04F33);
  }
  .ubc-pop-eyebrow {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ubc-pop-accent, #E04F33);
    padding-right: 32px;
  }
  .ubc-pop-title {
    margin: 0;
    font-family: 'Anton', 'Barlow Condensed', sans-serif;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.06;
    letter-spacing: 0.01em;
    color: #14202D;
    font-weight: 400;
  }
  .ubc-pop-desc {
    margin: 0;
    font-size: 15px;
    line-height: 1.48;
    color: #364759;
  }
  .ubc-pop-codebox {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 12px 10px 14px;
    border-radius: 12px;
    background: #FFFFFF;
    border: 1.5px dashed var(--ubc-pop-accent, #E04F33);
    margin-top: 2px;
  }
  .ubc-pop-code-meta {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .ubc-pop-code-label {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #5D6D7E;
  }
  .ubc-pop-code-val {
    font-family: 'Barlow Condensed', monospace;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #14202D;
  }
  .ubc-pop-copy {
    border: none;
    border-radius: 999px;
    padding: 8px 14px;
    background: #14202D;
    color: #FEFDF3;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.16s ease, transform 0.16s ease;
  }
  .ubc-pop-copy:hover {
    background: var(--ubc-pop-accent, #E04F33);
    transform: translateY(-1px);
  }
  .ubc-pop-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 4px;
  }
  .ubc-pop-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 13px 20px;
    border-radius: 999px;
    background: var(--ubc-pop-accent, #E04F33);
    color: #FFFFFF !important;
    text-decoration: none;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: filter 0.16s ease, transform 0.16s ease;
  }
  .ubc-pop-cta:hover {
    filter: brightness(0.92);
    transform: translateY(-1px);
    color: #FFFFFF !important;
  }
  .ubc-pop-subrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .ubc-pop-secondary {
    font-size: 13px;
    font-weight: 600;
    color: #14202D !important;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ubc-pop-dismiss {
    background: none;
    border: none;
    padding: 4px 0;
    font-size: 12.5px;
    color: #64748B;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .ubc-pop-dismiss:hover {
    color: #14202D;
  }
  .ubc-pop-fine {
    margin: 2px 0 0;
    font-size: 11.5px;
    line-height: 1.4;
    color: #64748B;
    border-top: 1px solid rgba(20, 32, 45, 0.1);
    padding-top: 10px;
  }

  @media (max-width: 720px) {
    .ubc-pop-card {
      grid-template-columns: 1fr;
      max-width: 400px;
      border-radius: 18px;
    }
    .ubc-pop-media {
      min-height: 165px;
      max-height: 180px;
    }
    .ubc-pop-body {
      padding: 18px 18px 16px;
      gap: 10px;
      border-top: none;
    }
    .ubc-pop-title {
      font-size: 24px;
    }
    .ubc-pop-desc {
      font-size: 13.5px;
    }
    .ubc-pop-offer-pill {
      left: 12px;
      bottom: 12px;
      padding: 7px 11px;
    }
    .ubc-pop-offer-pill strong {
      font-size: 20px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ubc-pop-backdrop,
    .ubc-pop-card {
      transition: none !important;
    }
  }
</style>

<div
  id="ubcSeasonalPopup"
  class="ubc-pop-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="ubcPopTitle"
  aria-hidden="true"
>
  <div class="ubc-pop-card" id="ubcPopCard">
    <button type="button" class="ubc-pop-close" id="ubcPopClose" aria-label="Close popup">&times;</button>
    <div class="ubc-pop-media">
      <img id="ubcPopImg" src="{{ img_storefront }}" alt="University Bicycle Center Tampa" loading="lazy" width="600" height="500">
      <div class="ubc-pop-offer-pill">
        <strong id="ubcPopBadgeBig">10% OFF</strong>
        <span id="ubcPopBadgeSub">Accessories &amp; Gear</span>
      </div>
    </div>
    <div class="ubc-pop-body">
      <div class="ubc-pop-eyebrow" id="ubcPopEyebrow">WELCOME TO UBC TAMPA · SINCE 1972</div>
      <h2 class="ubc-pop-title" id="ubcPopTitle">In-Stock Bikes, Gear &amp; Walk-In Workshop</h2>
      <p class="ubc-pop-desc" id="ubcPopDesc"></p>

      <div class="ubc-pop-actions">
        <a href="/collections/all" class="ubc-pop-cta" id="ubcPopCta">
          Browse In-Stock Catalog &rarr;
        </a>
        <div class="ubc-pop-subrow">
          <a href="/collections/accessories-gear" class="ubc-pop-secondary" id="ubcPopSecondary" style="display:none;"></a>
          <button type="button" class="ubc-pop-dismiss" id="ubcPopDismiss">No thanks, continue browsing</button>
        </div>
      </div>

      <p class="ubc-pop-fine" id="ubcPopFine"></p>
    </div>
  </div>
</div>

<script>
(function () {
  var backdrop = document.getElementById('ubcSeasonalPopup');
  var card = document.getElementById('ubcPopCard');
  if (!backdrop || !card) return;

  var POPUPS = {
    classic: {
      accent: '#E04F33',
      img: {{ img_storefront | json }},
      redirect: '/collections/all',
      en: {
        badgeBig: '20,000+',
        badgeSub: 'Items In Stock',
        eyebrow: 'Welcome to UBC Tampa · Since 1972',
        title: 'In-Stock Bikes, Gear & Walk-In Workshop',
        desc: 'Explore assembled bikes, helmets, lights, locks, hydration & parts ready today in Tampa — plus 0% APR financing and walk-in repair service.',
        cta: 'Browse Full Catalog →',
        secLabel: 'Walk-In Workshop',
        secHref: '/pages/bike-service-repair'
      },
      es: {
        badgeBig: '20,000+',
        badgeSub: 'Artículos en Stock',
        eyebrow: 'Bienvenido a UBC Tampa · Desde 1972',
        title: 'Bicis, Equipo y Taller Sin Cita en Tampa',
        desc: 'Explora bicicletas armadas, cascos, luces, candados, hidratación y repuestos listos hoy en tienda — además de financiamiento 0% APR.',
        cta: 'Ver Catálogo Completo →',
        secLabel: 'Taller Sin Cita',
        secHref: '/pages/bike-service-repair'
      }
    },
    black_friday: {
      accent: '#E04F33',
      img: {{ img_showroom | json }},
      redirect: '/collections/black-friday-deals',
      en: {
        badgeBig: 'UP TO 60%',
        badgeSub: 'Black Friday 2026',
        eyebrow: 'Black Friday 2026 · Tampa Showroom & Online',
        title: 'Up to $3,500 Off Bikes & Up to 60% Off Gear',
        desc: 'Shop direct showroom markdowns on in-stock bikes, e-bikes, MIPS helmets, shoes, and pro parts — plus free holiday hold until Dec 24.',
        cta: 'Shop Black Friday Deals →',
        secLabel: 'Full Store Catalog',
        secHref: '/collections/all'
      },
      es: {
        badgeBig: 'HASTA 60%',
        badgeSub: 'Black Friday 2026',
        eyebrow: 'Black Friday 2026 · Tienda Tampa y Online',
        title: 'Hasta $3,500 Off en Bicis y 60% Off en Equipo',
        desc: 'Descuentos directos en bicis, e-bikes, cascos MIPS, zapatos y repuestos en stock — más apartado navideño gratis hasta el 24 de dic.',
        cta: 'Ver Ofertas Black Friday →',
        secLabel: 'Toda la Tienda',
        secHref: '/collections/all'
      }
    },
    christmas: {
      accent: '#C81E2B',
      img: {{ img_carlos | json }},
      redirect: '/collections/bikes',
      en: {
        badgeBig: 'DEC 24',
        badgeSub: 'Free Holiday Hold',
        eyebrow: 'Holiday Gift Event · Tampa Showroom',
        title: 'Free Holiday Bike Assembly & Warehouse Hold',
        desc: 'Pick their dream bike today; Manny & Ashton’s mechanics assemble, safety-check, and store it hidden in our Tampa warehouse until Christmas Eve.',
        cta: 'Browse Gift Bikes →',
        secLabel: 'Helmets & Gifts',
        secHref: '/collections/accessories-gear'
      },
      es: {
        badgeBig: 'DIC 24',
        badgeSub: 'Apartado Gratis',
        eyebrow: 'Especial de Navidad · Tienda Tampa',
        title: 'Armado Profesional y Apartado Gratis hasta Dic 24',
        desc: 'Elige hoy la bici perfecta; nuestro equipo la arma, revisa y guarda en bodega hasta Nochebuena.',
        cta: 'Ver Bicicletas →',
        secLabel: 'Cascos y Regalos',
        secHref: '/collections/accessories-gear'
      }
    },
    july_4: {
      accent: '#1D4ED8',
      img: {{ img_alafia_trail | json }},
      redirect: '/collections/hydration-nutrition',
      en: {
        badgeBig: 'SINCE 1972',
        badgeSub: 'Summer & Honor',
        eyebrow: 'July 4th Summer Event · Honoring Veterans & Police',
        title: 'Summer Hydration, Gear & In-Store Service Perks',
        desc: 'Stock up on summer hydration, lights & trail essentials — plus everyday in-store appreciation savings for U.S. Veterans & Police.',
        cta: 'Shop Summer Gear →',
        secLabel: 'Locations & Hours',
        secHref: '/pages/locations'
      },
      es: {
        badgeBig: 'DESDE 1972',
        badgeSub: 'Verano y Honor',
        eyebrow: 'Especial 4 de Julio · Honor a Veteranos y Policías',
        title: 'Hidratación de Verano y Beneficios en Tienda',
        desc: 'Equípate con botellas, luces y accesorios de verano — más descuentos en tienda para Veteranos y Policías.',
        cta: 'Ver Equipo de Verano →',
        secLabel: 'Horarios y Sedes',
        secHref: '/pages/locations'
      }
    },
    spring: {
      accent: '#0F766E',
      img: {{ img_alafia_mtb | json }},
      redirect: '/pages/bike-rentals',
      en: {
        badgeBig: '28 TRAILS',
        badgeSub: 'Alafia Peak Season',
        eyebrow: 'Spring Riding Season · Alafia & Bayshore',
        title: 'Alafia Trailhead MTB Rentals & Spring Gear',
        desc: 'Roll straight onto Alafia’s 28 trails from our on-site park shop — or gear up in Tampa with tires, hydration, and walk-in tune-ups.',
        cta: 'Explore Alafia Rentals →',
        secLabel: 'Trail Maps',
        secHref: '/pages/maps-trails'
      },
      es: {
        badgeBig: '28 SENDEROS',
        badgeSub: 'Temporada Alafia',
        eyebrow: 'Temporada de Primavera · Alafia y Bayshore',
        title: 'Rentas MTB en Alafia y Equipo de Primavera',
        desc: 'Sal directo a los 28 senderos desde nuestra sede dentro del parque — o equípate en Tampa con llantas, hidratación y taller sin cita.',
        cta: 'Ver Rentas Alafia →',
        secLabel: 'Mapas de Senderos',
        secHref: '/pages/maps-trails'
      }
    },
    campus: {
      accent: '#006747',
      img: {{ img_campus | json }},
      redirect: '/collections/lights-locks',
      en: {
        badgeBig: '5 MIN',
        badgeSub: 'From USF Campus',
        eyebrow: 'Go Bulls · 1220 E Fletcher Ave',
        title: 'USF Campus Commuter Gear & Student Perks',
        desc: 'Show your valid USF Student ID in-store for student discounts on U-locks, USB lights, helmets, and same-day flat & scooter repairs.',
        cta: 'Shop Locks & Lights →',
        secLabel: 'Walk-In Repairs',
        secHref: '/pages/bike-service-repair'
      },
      es: {
        badgeBig: '5 MIN',
        badgeSub: 'De USF Campus',
        eyebrow: 'Go Bulls · 1220 E Fletcher Ave',
        title: 'Equipo Campus USF y Descuento Estudiantil',
        desc: 'Presenta tu carnet USF en tienda para descuento estudiantil en candados, luces USB, cascos y reparación el mismo día.',
        cta: 'Ver Candados y Luces →',
        secLabel: 'Taller Sin Cita',
        secHref: '/pages/bike-service-repair'
      }
    },
    veterans: {
      accent: '#B8862D',
      img: {{ img_manny | json }},
      redirect: '/pages/about-us',
      en: {
        badgeBig: '1972',
        badgeSub: 'Veteran-Founded',
        eyebrow: 'Veteran-Founded by Manny · Since 1972',
        title: 'Honoring U.S. Veterans & Law Enforcement',
        desc: 'Show your military, veteran, or police ID in our Tampa showroom for everyday in-store appreciation savings on bikes, gear & service.',
        cta: 'Our 1972 Story →',
        secLabel: 'Visit Tampa Showroom',
        secHref: '/pages/locations'
      },
      es: {
        badgeBig: '1972',
        badgeSub: 'Fundada por Veterano',
        eyebrow: 'Fundada por Manny (Veterano) · Desde 1972',
        title: 'Honor a Veteranos y Fuerzas del Orden',
        desc: 'Presenta tu identificación militar, de veterano o policial en nuestra tienda de Tampa para descuentos permanentes en bicis, equipo y taller.',
        cta: 'Nuestra Historia →',
        secLabel: 'Visitar Tienda Tampa',
        secHref: '/pages/locations'
      }
    }
  };

  var currentEd = 'classic';

  function getLang() {
    var pressed = document.querySelector('.fb-lang button[aria-pressed="true"]');
    if (pressed) return pressed.getAttribute('data-lang') === 'es' ? 'es' : 'en';
    try {
      if (localStorage.getItem('ubc-lang') === 'es') return 'es';
    } catch (e) {}
    return 'en';
  }

  function detectEdition() {
    try {
      var m = window.location.search.match(/[?&]edition=([a-z0-9_]+)/i);
      if (m && POPUPS[m[1]]) return m[1];
    } catch (e) {}
    if (document.getElementById('bf-deals')) return 'black_friday';
    var attr = document.body ? document.body.getAttribute('data-ubc-edition') : '';
    if (attr && POPUPS[attr]) return attr;
    return 'classic';
  }

  function renderPopup(edKey) {
    var key = POPUPS[edKey] ? edKey : 'classic';
    currentEd = key;
    var cfg = POPUPS[key];
    var lang = getLang();
    var copy = cfg[lang] || cfg.en;

    card.style.setProperty('--ubc-pop-accent', cfg.accent);
    var imgEl = document.getElementById('ubcPopImg');
    if (imgEl && imgEl.getAttribute('src') !== cfg.img) imgEl.setAttribute('src', cfg.img);

    document.getElementById('ubcPopBadgeBig').textContent = copy.badgeBig;
    document.getElementById('ubcPopBadgeSub').textContent = copy.badgeSub;
    document.getElementById('ubcPopEyebrow').textContent = copy.eyebrow;
    document.getElementById('ubcPopTitle').textContent = copy.title;
    document.getElementById('ubcPopDesc').textContent = copy.desc;

    var ctaEl = document.getElementById('ubcPopCta');
    ctaEl.textContent = copy.cta;
    ctaEl.setAttribute('href', cfg.redirect);

    var secEl = document.getElementById('ubcPopSecondary');
    if (copy.secLabel && copy.secHref) {
      secEl.textContent = copy.secLabel;
      secEl.setAttribute('href', copy.secHref);
      secEl.style.display = 'inline';
    } else {
      secEl.style.display = 'none';
    }

    document.getElementById('ubcPopDismiss').textContent = lang === 'es'
      ? 'No gracias, seguir viendo'
      : 'No thanks, continue browsing';

    document.getElementById('ubcPopFine').textContent = lang === 'es'
      ? 'University Bicycle Center · 1220 E Fletcher Ave, Tampa FL y Alafia River State Park.'
      : 'University Bicycle Center · 1220 E Fletcher Ave, Tampa FL & Alafia River State Park.';
  }

  function markSeen(edKey) {
    try {
      localStorage.setItem('ubc_popup_seen_' + edKey, String(Date.now()));
    } catch (e) {}
  }

  function wasSeenRecently(edKey) {
    try {
      var ts = Number(localStorage.getItem('ubc_popup_seen_' + edKey) || '0');
      if (!ts) return false;
      var sevenDays = 7 * 24 * 60 * 60 * 1000;
      return (Date.now() - ts) < sevenDays;
    } catch (e) {
      return false;
    }
  }

  function openPopup(edKey) {
    renderPopup(edKey || detectEdition());
    backdrop.classList.add('is-open');
    backdrop.setAttribute('aria-hidden', 'false');
    if (document.body) document.body.style.overflow = 'hidden';
  }

  function closePopup() {
    backdrop.classList.remove('is-open');
    backdrop.setAttribute('aria-hidden', 'true');
    if (document.body) document.body.style.overflow = '';
    markSeen(currentEd);
  }

  document.getElementById('ubcPopClose').addEventListener('click', closePopup);
  document.getElementById('ubcPopDismiss').addEventListener('click', closePopup);
  document.getElementById('ubcPopCta').addEventListener('click', function () {
    markSeen(currentEd);
  });
  backdrop.addEventListener('click', function (e) {
    if (e.target === backdrop) closePopup();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && backdrop.classList.contains('is-open')) closePopup();
  });

  window.ubcOpenPopup = openPopup;

  var path = window.location.pathname || '';
  if (path.indexOf('/cart') === 0 || path.indexOf('/checkouts') === 0) return;

  var forcePopup = /[?&]popup=1\b/i.test(window.location.search || '');
  var ed = detectEdition();
  if (forcePopup) {
    setTimeout(function () { openPopup(ed); }, 450);
  } else if (!wasSeenRecently(ed)) {
    setTimeout(function () {
      if (!wasSeenRecently(ed)) openPopup(ed);
    }, 4500);
  }
})();
</script>
