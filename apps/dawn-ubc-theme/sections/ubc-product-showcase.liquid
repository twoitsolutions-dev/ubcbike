{%- comment -%}
  Product showcase: one product at a time on a tall navy card (watermark letters behind the bike),
  neighbouring products peeking at the sides, a buy panel (sizes, price, add to cart) and a thumbnail rail.
  Works without JS: first product shown, add to cart posts the native form. theme.js adds the slider
  (arrows, thumbnails, keyboard, swipe) and AJAX add to cart.
{%- endcomment -%}
{%- assign c = section.settings.collection -%}
{%- assign count = 0 -%}
{%- if c != blank -%}{%- assign count = c.products.size | at_most: section.settings.limit -%}{%- endif -%}
{%- assign added_label = 'ubc.products.added' | t -%}
<section class="showcase showcase--{{ section.settings.scheme }} showcase--{{ section.settings.media_style }}" data-showcase{% if count > 1 %} aria-roledescription="carousel"{% endif %} aria-labelledby="Showcase-{{ section.id }}">
  {%- if section.settings.side_text != blank -%}<p class="showcase-side" aria-hidden="true">{{ section.settings.side_text | escape }}</p>{%- endif -%}
  <div class="container showcase-inner">
    <div class="showcase-head">
      <h1 class="visually-hidden" id="Showcase-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
    </div>

    {%- if count > 0 -%}
      {%- for product in c.products limit: section.settings.limit -%}
        {%- assign v = product.selected_or_first_available_variant -%}
        {%- assign size_option = nil -%}
        {%- for option in product.options_with_values -%}
          {%- assign oname = option.name | downcase -%}
          {%- if size_option == nil -%}{%- if oname contains 'size' or oname contains 'talla' -%}{%- assign size_option = option -%}{%- endif -%}{%- endif -%}
        {%- endfor -%}
        <article class="showcase-slide{% if forloop.first %} is-active{% endif %}" data-slide aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ count }}"{% unless forloop.first %} hidden{% endunless %}>
          <div class="showcase-copy">
            <h2 class="showcase-title">{{ product.title | escape }}</h2>
            <p class="showcase-vendor">{{ product.vendor | escape }}{% if product.type != blank %} · {{ product.type | escape }}{% endif %}</p>
            {%- if product.description != blank -%}<p class="showcase-text">{{ product.description | strip_html | truncatewords: 22 }}</p>{%- endif -%}
            <a class="showcase-details" href="{{ v.url | default: product.url }}">{{ 'ubc.showcase.details' | t }} <span aria-hidden="true">&rarr;</span></a>
          </div>

          <div class="showcase-stage">
            <div class="showcase-card">
              <div class="showcase-float">
                {%- if product.featured_media -%}
                  {%- if forloop.first -%}
                    {{ product.featured_media | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: product.featured_media.alt | default: product.title | escape }}
                  {%- else -%}
                    {{ product.featured_media | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: product.featured_media.alt | default: product.title | escape }}
                  {%- endif -%}
                {%- else -%}
                  {%- assign ptype_down = product.type | downcase -%}
                  {%- assign ptitle_down = product.title | downcase -%}
                  {%- if ptitle_down contains 'tarmac' or ptype_down contains 'road' -%}
                    <img src="{{ 'ubc-bike-tarmac-sl9.webp' | asset_url }}" width="1400" height="850" loading="lazy" alt="{{ product.title | escape }}">
                  {%- elsif ptitle_down contains 'gravel' or ptype_down contains 'gravel' or ptype_down contains 'frame' -%}
                    <img src="{{ 'ubc-bike-diverge.webp' | asset_url }}" width="1400" height="850" loading="lazy" alt="{{ product.title | escape }}">
                  {%- elsif ptype_down contains 'tire' -%}
                    <img src="{{ 'ubc-part-tires.webp' | asset_url }}" width="900" height="600" loading="lazy" alt="{{ product.title | escape }}">
                  {%- else -%}
                    {% render 'ubc-bike-illustration' %}
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>
          </div>

          <div class="showcase-meta">
            <div class="showcase-prices">
              {%- if v.compare_at_price > v.price -%}
                <s class="showcase-compare"><span class="visually-hidden">{{ 'ubc.products.regular_price' | t }}</span>{{ v.compare_at_price | money }}</s>
              {%- endif -%}
              <p class="showcase-price">{{ v.price | money }}</p>
            </div>
            {%- form 'product', product, class: 'showcase-form', data-quick-add: '', data-added-label: added_label -%}
              {%- if size_option != nil -%}
                <fieldset class="option-pills">
                  <legend>{{ 'ubc.showcase.choose_size' | t }}</legend>
                  {%- for value in size_option.values -%}
                    <label class="size-pill">
                      <input type="radio" name="id" value="{{ value.variant.id | default: v.id }}"{% if value.selected %} checked{% endif %}{% unless value.available %} disabled{% endunless %}>
                      <span>{{ value.name | escape }}</span>
                    </label>
                  {%- endfor -%}
                </fieldset>
              {%- else -%}
                <input type="hidden" name="id" value="{{ v.id }}">
              {%- endif -%}
              <input type="hidden" name="quantity" value="1">
              <button class="ubc-btn showcase-add" type="submit"{% unless v.available %} disabled{% endunless %}>
                <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round"/></svg>
                {%- if v.available -%}{{ 'ubc.products.add_to_cart' | t }}{%- else -%}{{ 'ubc.products.sold_out' | t }}{%- endif -%}
              </button>
              <p class="form-message" data-form-message role="status"></p>
            {%- endform -%}
            {% render 'ubc-availability', variant: v %}
          </div>
        </article>
      {%- endfor -%}


      {%- if count > 1 -%}
        <div class="showcase-controls showcase-controls--under">
          <button class="showcase-arrow" type="button" data-showcase-prev aria-label="{{ 'ubc.showcase.previous' | t }}">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <p class="showcase-counter"><span data-showcase-current>01</span> / {% if count < 10 %}0{% endif %}{{ count }}</p>
          <button class="showcase-arrow" type="button" data-showcase-next aria-label="{{ 'ubc.showcase.next' | t }}">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      {%- endif -%}
      {%- if count > 1 -%}
        <ul class="showcase-thumbs">
          {%- for product in c.products limit: section.settings.limit -%}
            <li>
              <button type="button" class="showcase-thumb" data-showcase-go="{{ forloop.index0 }}"{% if forloop.first %} aria-current="true"{% endif %}>
                {%- if product.featured_media -%}
                  {{ product.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                {%- endif -%}
                <span class="visually-hidden">{{ product.title | escape }}</span>
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- else -%}
      <article class="showcase-slide is-active">
        <div class="showcase-copy">
          <h2 class="showcase-title">{{ section.settings.fallback_title | escape }}</h2>
          {%- if section.settings.fallback_text != blank -%}<p class="showcase-text">{{ section.settings.fallback_text | escape }}</p>{%- endif -%}
          <a class="ubc-btn" href="{{ section.settings.fallback_link | default: routes.all_products_collection_url }}">{{ 'ubc.showcase.shop_now' | t }} <span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="showcase-stage">
          <div class="showcase-card" data-watermark="{{ section.settings.background_word | default: 'UBC' | escape }}" data-peek-prev="{{ section.settings.fallback_prev | escape }}" data-peek-next="{{ section.settings.fallback_next | escape }}">
            <div class="showcase-float">{% if section.settings.fallback_image != blank %}<img src="{{ section.settings.fallback_image | asset_url }}" class="" width="1400" height="850" loading="lazy" alt="{{ section.settings.fallback_title | escape }}">{% else %}{% render 'ubc-bike-illustration' %}{% endif %}</div>
          </div>
        </div>
        <div class="showcase-meta">
          <ul class="showcase-facts">
            <li><strong>{{ 'ubc.showcase.fact_stock_title' | t }}</strong>{{ 'ubc.showcase.fact_stock' | t }}</li>
            <li><strong>{{ 'ubc.showcase.fact_service_title' | t }}</strong>{{ 'ubc.showcase.fact_service' | t }}</li>
            <li><strong>{{ 'ubc.showcase.fact_pickup_title' | t }}</strong>{{ 'ubc.showcase.fact_pickup' | t }}</li>
          </ul>
        </div>
      </article>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product showcase",
  "settings": [
    { "type": "text", "id": "heading", "label": "Page heading (screen readers and SEO)", "default": "University Bicycle Center · Tampa" },
    { "type": "collection", "id": "collection", "label": "Products from collection", "info": "Bikes look best as photos with a transparent background (PNG/WebP)" },
    { "type": "range", "id": "limit", "min": 1, "max": 8, "step": 1, "label": "Products", "default": 5 },
    { "type": "select", "id": "scheme", "label": "Colour scheme", "default": "light", "options": [
      { "value": "light", "label": "Light (off-white page, navy card)" },
      { "value": "dark", "label": "Dark (navy page)" }
    ] },
    { "type": "select", "id": "media_style", "label": "Product photo style", "default": "cutout", "options": [
      { "value": "cutout", "label": "Floating (transparent cut-outs)" },
      { "value": "panel", "label": "Light panel (photos on white background)" }
    ] },
    { "type": "text", "id": "background_word", "label": "Watermark word (empty collection)", "default": "UBC" },
    { "type": "text", "id": "side_text", "label": "Vertical side text", "default": "Tampa, Florida · Since 1972" },
    { "type": "header", "content": "Shown while the collection is empty" },
    { "type": "text", "id": "fallback_image", "label": "Bundled bike (theme asset)", "default": "ubc-bike-diverge.webp" },
    { "type": "text", "id": "fallback_prev", "label": "Bundled bike, left (theme asset)", "default": "ubc-bike-tarmac-sl9.webp" },
    { "type": "text", "id": "fallback_next", "label": "Bundled bike, right (theme asset)", "default": "ubc-bike-epic-9.webp" },
    { "type": "text", "id": "fallback_title", "label": "Title", "default": "Ride further." },
    { "type": "text", "id": "fallback_text", "label": "Text", "default": "Bikes, e-bikes, parts and expert service — in stock at UBC or ordered from our distributors for you." },
    { "type": "url", "id": "fallback_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Product showcase" }]
}
{% endschema %}
