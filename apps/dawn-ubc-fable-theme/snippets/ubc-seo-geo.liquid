{%- if request.page_type == 'index' or page.handle == 'about-us' or page.handle == 'bike-service-repair' or page.handle == 'bike-rentals' or page.handle == 'locations' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Where is University Bicycle Center located in Tampa and at Alafia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our Tampa Showroom & Walk-In Workshop is at 1220 E Fletcher Ave, Tampa, FL 33612 (near USF), reachable at (813) 971-2277. Our trailhead MTB & e-MTB rental shop is inside Alafia River State Park at 14326 S County Rd 39, Lithia, FL 33547, reachable at (813) 459-8293."
      }
    },
    {
      "@type": "Question",
      "name": "What bike tune-up packages and repair services does UBC Tampa offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "UBC Tampa offers walk-in bike repair with most repairs completed within 24 hours, including Level 1 Tune-Up ($100), Level 2 Tune-Up ($160), and Complete Overhaul ($250), plus e-bike diagnostics, suspension service, and wheel truing."
      }
    },
    {
      "@type": "Question",
      "name": "What complimentary service and warranty comes with a new bike from University Bicycle Center?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every new bicycle includes road-ready professional assembly, complimentary check-overs at 30-90 days, 6 months, and 1 year, ongoing basic brake, gear, and bearing adjustments for the original owner, and a 1-year warranty covering parts and labor (used bikes include a 30-day warranty)."
      }
    },
    {
      "@type": "Question",
      "name": "Can I rent a mountain bike or e-MTB inside Alafia River State Park?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. UBC at Alafia River State Park rents tuned full-suspension mountain bikes and e-MTBs directly at the trailhead inside the park, with helmets and trailside mechanical support."
      }
    },
    {
      "@type": "Question",
      "name": "Does University Bicycle Center offer a Low Price Guarantee and trade-ins?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Under our Low Price Guarantee, if you find the identical item advertised for less and in stock at a competing retailer, we will do our best to match their price. We are also an official BicycleBlueBook.com partner offering instant in-store trade-in credit."
      }
    }
  ]
}
</script>
{%- endif -%}

{%- if request.page_type == 'product' and product -%}
  {%- assign seo_v = product.selected_or_first_available_variant -%}
  {%- assign seo_mpn = seo_v.metafields.ubc.mpn.value | default: seo_v.sku -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": "{{ shop.url }}{{ product.url }}#ubc-product",
    "name": {{ product.title | json }},
    "url": "{{ shop.url }}{{ product.url }}",
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    "sku": {{ seo_mpn | json }},
    "mpn": {{ seo_mpn | json }}{% if seo_v.barcode != blank %},
    "gtin": {{ seo_v.barcode | json }}{% endif %},
    "offers": {
      "@type": "Offer",
      "url": "{{ shop.url }}{{ seo_v.url }}",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ seo_v.price | divided_by: 100.0 | json }},
      "availability": "https://schema.org/{% if seo_v.available %}InStock{% else %}OutOfStock{% endif %}",
      "itemCondition": "https://schema.org/NewCondition"
    }
  }
  </script>
{%- endif -%}
