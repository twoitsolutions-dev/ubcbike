                      when 'christmas'
                        assign ed_img = 'ubc-pop-christmas.jpg'
                        assign ed_badge = 'Free Holiday Hold'
                        assign ed_badge_es = 'Apartado Navideño Gratis'
                        assign ed_title = 'Free Holiday Assembly & Warehouse Hold'
                        assign ed_title_es = 'Armado y Apartado Navideño Gratis'
