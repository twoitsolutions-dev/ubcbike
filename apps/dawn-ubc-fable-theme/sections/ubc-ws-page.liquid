        </div>
        {%- if sync_card -%}
          <div class="ubc-ws-hero-media">
            {{ sync_card | image_url: width: 900 | image_tag: loading: 'eager', alt: 'Synchrony Freedom to Ride Credit Card' }}
          </div>
        {%- endif -%}
      </section>

      <section class="ubc-ws-section" id="financing-options">
        <h2 class="ubc-ws-h2">Your Financing Options</h2>
        {%- liquid
          assign fin_down = page.content | strip_html | downcase
          assign show_acima = true
          assign show_sync = true
          assign show_snap = true
          if page.content != blank
            unless fin_down contains 'acima'
              assign show_acima = false
            endunless
            unless fin_down contains 'synchrony'
              assign show_sync = false
            endunless
            unless fin_down contains 'snap'
              assign show_snap = false
            endunless
          endif
          assign fin_count = 0
          if show_acima
            assign fin_count = fin_count | plus: 1
          endif
          if show_sync
            assign fin_count = fin_count | plus: 1
          endif
          if show_snap
            assign fin_count = fin_count | plus: 1
          endif
        -%}
        {%- assign fin_partners = shop.metaobjects.ubc_financing_partner.values | sort: 'sort_order' -%}
        {%- if fin_partners.size > 0 -%}
        <div class="ubc-ws-grid{% if fin_partners.size <= 2 %} ubc-ws-grid--2{% endif %}">
          {%- for fp in fin_partners -%}
            {%- assign fp_handle = fp.system.handle -%}
            {%- assign fp_logo = blank -%}
            {%- if fp_handle contains 'acima' -%}{%- assign fp_logo = images['ubc-financing-acima-logo.png'] -%}
            {%- elsif fp_handle contains 'synchrony' -%}{%- assign fp_logo = images['ubc-financing-synchrony-logo.png'] -%}
            {%- elsif fp_handle contains 'snap' -%}{%- assign fp_logo = images['ubc-financing-snap-logo.png'] -%}
            {%- endif -%}
            <article class="ubc-ws-card{% if fp.featured.value %} ubc-ws-card--featured{% endif %}">
              <div>
                {%- if fp_logo != blank -%}<div class="ubc-ws-card-media ubc-ws-card-media--logo">{{ fp_logo | image_url: width: 420 | image_tag: loading: 'lazy', alt: fp.name.value }}</div>{%- endif -%}
                <h3>{{ fp.name.value }}</h3>
                {%- if fp.summary.value != blank -%}<p class="ubc-ws-note">{{ fp.summary.value }}</p>{%- endif -%}
              </div>
              <div class="ubc-ws-actions">
                {%- if fp.apply_url.value != blank -%}
                  <a class="ubc-ws-btn" href="{{ fp.apply_url.value }}" target="_blank" rel="noopener">{{ fp.apply_label.value | default: 'Apply Now' }}</a>
                {%- endif -%}
                {%- if fp.secondary_url.value != blank -%}
                  <a class="ubc-ws-btn ubc-ws-btn--ghost" href="{{ fp.secondary_url.value }}" target="_blank" rel="noopener">{{ fp.secondary_label.value | default: 'Learn More' }}</a>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>
        {%- else -%}
        <div class="ubc-ws-grid{% if fin_count <= 2 %} ubc-ws-grid--2{% endif %}">
          {%- if show_acima -%}
          {%- assign acima_logo = images['ubc-financing-acima-logo.png'] -%}
          <article class="ubc-ws-card">
            <div>
              {%- if acima_logo -%}<div class="ubc-ws-card-media ubc-ws-card-media--logo">{{ acima_logo | image_url: width: 420 | image_tag: loading: 'lazy', alt: 'Acima' }}</div>{%- endif -%}
              <h3>Acima</h3>
              <p class="ubc-ws-note">Flexible Monthly Payments — lease-to-own options designed to help you ride home today.</p>
            </div>
            <a class="ubc-ws-btn" href="https://ams.acimacredit.com/discover/new?lang=en.leases&location_guid=loca-703aa24e-31e6-4aec-8f39-c1d5c6147cf6&merchant_guid=merc-4949370c-a29b-41d5-b86a-894e8bd532aa&utm_campaign=merchant&utm_source=web&utm_term=mktg_lp#/about_leasing" target="_blank" rel="noopener">Apply Now</a>
          </article>
          {%- endif -%}

          {%- if show_sync -%}
          {%- assign sync_logo = images['ubc-financing-synchrony-logo.png'] -%}
          <article class="ubc-ws-card ubc-ws-card--featured" id="synchrony">
            <div>
              {%- if sync_logo -%}<div class="ubc-ws-card-media ubc-ws-card-media--logo">{{ sync_logo | image_url: width: 420 | image_tag: loading: 'lazy', alt: 'Synchrony' }}</div>{%- endif -%}
              <h3>Synchrony — Freedom to Ride</h3>
              <p class="ubc-ws-note">0% Interest Financing options. Prequalify without impacting your credit bureau score or apply directly.</p>
            </div>
            <div class="ubc-ws-actions">
              <a class="ubc-ws-btn" href="https://www.synchrony.com/mmc/FT186212409?sitecode=acewel401" target="_blank" rel="noopener">Apply Now</a>
              <a class="ubc-ws-btn ubc-ws-btn--ghost" href="https://www.synchrony.com/consumer-resources/payment-calculator/syfhome" target="_blank" rel="noopener">Payment Calculator</a>
            </div>
          </article>
          {%- endif -%}

          {%- if show_snap -%}
          {%- assign snap_logo = images['ubc-financing-snap-logo.png'] -%}
          <article class="ubc-ws-card">
            <div>
              {%- if snap_logo -%}<div class="ubc-ws-card-media ubc-ws-card-media--logo">{{ snap_logo | image_url: width: 420 | image_tag: loading: 'lazy', alt: 'Snap Finance' }}</div>{%- endif -%}
              <h3>Snap Finance</h3>
              <p class="ubc-ws-note">Buy Now, Pay Later — quick online decision with convenient payment schedules.</p>
            </div>
            <a class="ubc-ws-btn" href="https://bk.snapfinance.com/origination?paramId=3w%2FEWVFzVGcQioSdKn1vuqdr2hNr3A1xiMt4CtG%2BqOW6%2FoVDUYR%2B662lEkK1hZ0tog9ZSjNG2GyQln5HQrzShOzYiaK%2FnFnEZXfXtyBXVEw%3D" target="_blank" rel="noopener">Apply Now</a>
          </article>
          {%- endif -%}
        </div>
      {%- endif -%}

      <section class="ubc-ws-section" id="trade-in" style="margin-top:3.2rem;">
        <div class="ubc-ws-card" style="padding:clamp(2.2rem,3.5vw,3.6rem);">
          <div style="margin-bottom:1.6rem;">
            <img src="{{ 'logo-bicycle-blue-book.png' | asset_url }}" alt="BicycleBlueBook.com" loading="lazy" style="max-height:36px;width:auto;display:block;margin-bottom:1rem;">
