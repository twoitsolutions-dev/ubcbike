<section class="container cart">
  <h1>{{ 'cart.title' | t }}</h1>
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-form">
      <ul class="cart-lines">
        {%- for item in cart.items -%}
          <li class="cart-line">
            <a href="{{ item.url }}" class="cart-line-title">{{ item.product.title | escape }}</a>
            {%- unless item.product.has_only_default_variant -%}<span class="muted">{{ item.variant.title | escape }}</span>{%- endunless -%}
            {% render 'availability', variant: item.variant %}
            <label class="field field--qty">
              <span class="visually-hidden">{{ 'products.quantity' | t }}</span>
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
            </label>
            <span class="cart-line-price">{{ item.final_line_price | money }}</span>
            <a href="{{ item.url_to_remove }}" class="link">{{ 'cart.remove' | t }}</a>
          </li>
        {%- endfor -%}
      </ul>
      <div class="cart-summary">
        <p class="cart-total">{{ 'cart.subtotal' | t }}: <strong>{{ cart.total_price | money }}</strong></p>
        <p class="muted">{{ 'cart.taxes_shipping' | t }}</p>
        <p class="muted">{{ 'cart.special_order_note' | t }}</p>
        <button type="submit" name="update" class="button button--secondary">{{ 'cart.update' | t }}</button>
        <button type="submit" name="checkout" class="button">{{ 'cart.checkout' | t }}</button>
      </div>
    </form>
  {%- else -%}
    <p>{{ 'cart.empty' | t }}</p>
    <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
  {%- endif -%}
</section>

{% schema %}
{ "name": "Cart" }
{% endschema %}
