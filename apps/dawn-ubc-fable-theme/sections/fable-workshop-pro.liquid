{%- comment -%}
  UBC Dawn V34 — Visual Walk-In Repair Workshop Showcase (#service)
  Features real UBC Tampa workshop photography (`ubc-service-wheel-truing.jpg`), compact 2x2 capability cards,
  4-tier tune-up pricing bar, collapsible checklist, and direct Ikeono SMS trigger.
{%- endcomment -%}
{%- liquid
  assign edition = settings.ubc_edition | default: 'classic'
  assign ws_phone = section.settings.phone | default: '(813) 971-2277'
  assign ws_digits = ws_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' | remove: '+'
  if ws_digits.size == 10
    assign ws_tel = '+1' | append: ws_digits
  elsif ws_digits != blank
    assign ws_tel = '+' | append: ws_digits
  else
    assign ws_tel = '+18139712277'
  endif
  assign p_lvl1 = section.settings.level1_price | default: '$100'
  assign p_lvl2 = section.settings.level2_price | default: '$160'
  assign p_lvl3 = section.settings.level3_price | default: '$250'
  assign ws_photo = images['ubc-service-wheel-truing.jpg']
-%}

<style>
  .ubc-wsp-split {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: clamp(22px, 3.2vw, 40px);
    align-items: stretch;
    margin-bottom: 24px;
  }
  .ubc-wsp-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
  }
  .ubc-wsp-caps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 6px;
  }
  .ubc-wsp-cap {
    background: #FFFFFF;
    border: 1px solid rgba(20, 32, 45, 0.1);
    border-radius: 14px;
    padding: 13px 15px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .ubc-wsp-cap--dark {
    background: #14202D;
    border-color: #14202D;
    color: #FEFDF3;
  }
  .ubc-wsp-cap__k {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #E04F33;
  }
  .ubc-wsp-cap--dark .ubc-wsp-cap__k { color: #CCBB8D; }
  .ubc-wsp-cap strong {
    font-size: 14.5px;
    font-weight: 800;
    color: #14202D;
    line-height: 1.2;
  }
  .ubc-wsp-cap--dark strong { color: #FEFDF3; }
  .ubc-wsp-cap span.ubc-wsp-cap__s {
    font-size: 12.5px;
    color: #4A5A6A;
    line-height: 1.35;
  }
  .ubc-wsp-cap--dark span.ubc-wsp-cap__s { color: rgba(254, 253, 243, 0.78); }

  .ubc-wsp-photo {
    position: relative;
    border-radius: 22px;
    overflow: hidden;
    background: #14202D;
    border: 1px solid rgba(20, 32, 45, 0.12);
    box-shadow: 0 18px 36px -22px rgba(20, 32, 45, 0.35);
    min-height: 340px;
  }
  .ubc-wsp-photo img {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block;
  }
  .ubc-wsp-photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 32, 45, 0.05) 45%, rgba(20, 32, 45, 0.84) 100%);
    pointer-events: none;
  }
  .ubc-wsp-photo-bar {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }
  .ubc-wsp-pill {
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    border-radius: 999px;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(20, 32, 45, 0.84);
    border: 1px solid rgba(254, 253, 243, 0.22);
    color: #FEFDF3;
  }
  .ubc-wsp-pill--gold {
    background: #CCBB8D;
    border-color: #CCBB8D;
    color: #14202D;
  }
  @media (max-width: 900px) {
    .ubc-wsp-split { grid-template-columns: 1fr; }
    .ubc-wsp-photo { min-height: 250px; }
  }
  @media (max-width: 540px) {
    .ubc-wsp-caps { grid-template-columns: 1fr; }
  }
</style>

<div class="fb-scope">
  <section class="fb-sec ws-sec" id="service">
    <div class="fb-wrap">
      <div class="ubc-wsp-split">
        <div class="ubc-wsp-left">
          <div class="ws-live-row reveal">
            <span class="ws-live-pill">
              <i aria-hidden="true"></i>
              <span data-es="Taller Sin Cita Todo el Día &middot; Entrega Estándar ~24h">{{ section.settings.live_status | escape }}</span>
            </span>
          </div>

          <h2 class="h2 reveal" data-es="De una bici diaria o scooter a carbono pro: <em>reparamos lo que sea.</em>">
            From a flat or scooter to pro carbon: <em>we fix anything.</em>
          </h2>
          <p class="lead reveal" data-es="Liderado por Manny (47 &frac12;+ años) y su nieto Ashton (MTB &amp; Ruta) junto a técnicos con 13–28+ años de oficio. Trae cualquier reto mecánico sin cita.">
            Led by founder <strong>Manny</strong> (47&frac12;+ yrs at the bench) &amp; grandson <strong>Ashton</strong> (Lead MTB &amp; Road Tech) with a veteran crew of 13&ndash;28+ yrs experience.
          </p>

          <div class="ubc-wsp-caps reveal">
            <div class="ubc-wsp-cap">
              <span class="ubc-wsp-cap__k">Quick Turnaround</span>
              <strong data-es="Bicis Diarias y Niños">Everyday &amp; Campus Bikes</strong>
              <span class="ubc-wsp-cap__s">Flats, brakes, chains &amp; safety checks.</span>
            </div>
            <div class="ubc-wsp-cap">
              <span class="ubc-wsp-cap__k">Multi-Brand Bay</span>
              <strong data-es="E-Bikes y Scooters">E-Bikes &amp; Scooters</strong>
              <span class="ubc-wsp-cap__s">Tires, hydraulic bleeds &amp; diagnostics.</span>
            </div>
            <div class="ubc-wsp-cap">
              <span class="ubc-wsp-cap__k">Ashton &middot; MTB &amp; Road</span>
              <strong data-es="Carbono Pro y MTB">Pro Carbon &amp; Full MTB</strong>
              <span class="ubc-wsp-cap__s">AXS, Di2, suspension &amp; tubeless builds.</span>
            </div>
            <div class="ubc-wsp-cap ubc-wsp-cap--dark">
              <span class="ubc-wsp-cap__k">Manny &middot; 47&frac12;+ Yrs</span>
              <strong data-es="Retos y Restauración">Tough &amp; Custom Fixes</strong>
              <span class="ubc-wsp-cap__s">Hand-built wheels &amp; vintage restorations.</span>
            </div>
          </div>
        </div>

        <div class="ubc-wsp-photo reveal">
          {%- if ws_photo != blank -%}
            {{ ws_photo | image_url: width: 1100 | image_tag: alt: 'University Bicycle Center Tampa mechanic truing a bicycle wheel', loading: 'lazy' }}
          {%- else -%}
            <img src="{{ 'alafia-mtb-action.jpg' | asset_url }}" alt="University Bicycle Center Service Center" loading="lazy" width="1200" height="800">
          {%- endif -%}
          <div class="ubc-wsp-photo-bar">
            <span class="ubc-wsp-pill">Tampa Service Center &middot; Since 1972</span>
            <span class="ubc-wsp-pill ubc-wsp-pill--gold">13&ndash;28+ Yrs Techs</span>
          </div>
        </div>
      </div>

      {%- comment -%} Compact Tune-Up Pricing + Collapsible Checklist + Direct Ikeono SMS Service Center Action {%- endcomment -%}
      <div class="ws-bar reveal">
        <div class="ws-tiers">
          <div class="ws-tier">
            <span class="ws-tier-kicker" data-es="Nivel 1">Level 1</span>
            <strong>{{ p_lvl1 | escape }}</strong>
            <span class="ws-tier-name" data-es="Ajuste Básico y Seguridad">Basic Safety Tune</span>
          </div>
          <div class="ws-tier ws-tier--hot">
            <span class="ws-tier-kicker" data-es="Nivel 2 &middot; Más Pedido">Level 2 &middot; Most Popular</span>
            <strong>{{ p_lvl2 | escape }}</strong>
            <span class="ws-tier-name" data-es="Tune-Up Completo + Lavado">Complete Tune + Drivetrain Wash</span>
          </div>
          <div class="ws-tier">
            <span class="ws-tier-kicker" data-es="Nivel 3">Level 3</span>
            <strong>{{ p_lvl3 | escape }}</strong>
            <span class="ws-tier-name" data-es="Overhaul Total a Cuadro">Full Strip-to-Frame Overhaul</span>
          </div>
          <div class="ws-tier ws-tier--free">
            <span class="ws-tier-kicker" data-es="Comprada en UBC">Bought at UBC</span>
            <strong data-es="Gratis">Free</strong>
            <span class="ws-tier-name" data-es="Ajustes de por vida (dueño orig.)">Lifetime Adjustments (Orig. Owner)</span>
          </div>
        </div>

        <div class="ws-bar-foot">
          <details class="ws-checklist">
            <summary>
              <svg aria-hidden="true"><use href="#i-wrench"/></svg>
              <span data-es="Ver los puntos que cubren Ashton y el equipo en un Tune-Up">See what Ashton &amp; our mechanics cover in a UBC Tune-Up</span>
              <svg class="ws-chev" aria-hidden="true"><use href="#i-chev"/></svg>
            </summary>
            <ul class="ws-check-grid">
              <li><svg aria-hidden="true"><use href="#i-check"/></svg> <span data-es="Centrado de ruedas lateral y vertical">Wheel truing — lateral &amp; vertical</span></li>
              <li><svg aria-hidden="true"><use href="#i-check"/></svg> <span data-es="Ajuste fino de mazas (hubs)">Front &amp; rear hub adjustments</span></li>
              <li><svg aria-hidden="true"><use href="#i-check"/></svg> <span data-es="Calibración de desviador delantero y trasero">Front &amp; rear derailleur calibration</span></li>
              <li><svg aria-hidden="true"><use href="#i-check"/></svg> <span data-es="Ajuste y torque de dirección (headset)">Headset bearing &amp; stem torque check</span></li>
              <li><svg aria-hidden="true"><use href="#i-check"/></svg> <span data-es="Limpieza profunda y lubricación de transmisión">Deep ultrasonic drivetrain cleaning &amp; lube</span></li>
              <li><svg aria-hidden="true"><use href="#i-check"/></svg> <span data-es="Cinta de manubrio, frenos, presión y prueba de ruta">Fresh bar tape, brake bleed/align &amp; test ride</span></li>
            </ul>
          </details>

          <div class="ws-actions">
            <button
              type="button"
              class="fb-btn coral sm"
              data-ws-ikeono="Hi UBC Service Center! I have a repair / tune-up question (bike / scooter / e-bike):"
              data-ws-ikeono-es="Hola Taller UBC, tengo una consulta de reparación o tune-up (bici / scooter / e-bike):"
            >
              <svg aria-hidden="true"><use href="#i-chat"/></svg>
              <span data-es="Enviar Texto / Foto al Taller">Text Service Center (Ikeono)</span>
            </button>
            <a class="fb-btn outline sm" href="tel:{{ ws_tel }}">
              <svg aria-hidden="true"><use href="#i-phone"/></svg>
              <span>{{ ws_phone | escape }}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "UBC Service Center",
  "settings": [
    {
      "type": "text",
      "id": "live_status",
      "label": "Service Center status badge",
      "default": "Walk-In All Day · No Appointment · ~24h Standard Turnaround"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Service Center phone number",
      "default": "(813) 971-2277"
    },
    {
      "type": "text",
      "id": "level1_price",
      "label": "Level 1 Tune-Up price",
      "default": "$100"
    },
    {
      "type": "text",
      "id": "level2_price",
      "label": "Level 2 Tune-Up price",
      "default": "$160"
    },
    {
      "type": "text",
      "id": "level3_price",
      "label": "Level 3 Overhaul price",
      "default": "$250"
    }
  ],
  "presets": [
    {
      "name": "UBC Service Center"
    }
  ]
}
{% endschema %}
