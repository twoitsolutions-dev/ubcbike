<header class="site-header">
  <div class="container header-inner">
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="SiteNav" data-menu-toggle>
      <span class="visually-hidden">{{ 'general.menu' | t }}</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
    </button>
    <a class="logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 360 | image_tag: alt: shop.name, width: section.settings.logo_width, loading: 'eager' }}
      {%- else -%}
        <span class="logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>
    <form class="header-search" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="HeaderSearch">{{ 'general.search' | t }}</label>
      <input id="HeaderSearch" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}">
      <input type="hidden" name="options[prefix]" value="last">
    </form>
    <nav id="SiteNav" class="site-nav" aria-label="{{ 'general.main_navigation' | t }}">
      <ul>
        {%- for link in section.settings.menu.links -%}
          <li class="{% if link.links != blank %}has-children{% endif %}">
            <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
            {%- if link.links != blank -%}
              <ul class="submenu">
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
    <div class="header-actions">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="icon-link">{{ 'general.account' | t }}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="icon-link cart-link" data-cart-link>
        {{ 'general.cart' | t }} <span class="cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "min": 80, "max": 300, "step": 10, "unit": "px", "label": "Logo width", "default": 160 },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Shop Bikes, Electric Bikes, Parts, Accessories, Brands, Deals, Bike Services, Rentals, About, Contact, FAQ" }
  ]
}
{% endschema %}
