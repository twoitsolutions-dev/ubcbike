{%- paginate collection.products by section.settings.per_page -%}
<section class="container collection">
  <div class="collection-head">
    <h1>{{ collection.title | escape }}</h1>
    {%- if collection.description != blank -%}<div class="rte">{{ collection.description }}</div>{%- endif -%}
  </div>
  <div class="collection-layout">
    <details class="filters" open>
      <summary>{{ 'collections.filters' | t }}</summary>
      <form data-filter-form action="{{ collection.url }}" method="get">
        {%- for filter in collection.filters -%}
          <fieldset class="filter">
            <legend>{{ filter.label | escape }}</legend>
            {%- case filter.type -%}
              {%- when 'price_range' -%}
                <div class="price-range">
                  <label>{{ 'collections.from' | t }} <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | remove: ',' }}" placeholder="0" min="0" step="1" inputmode="numeric"></label>
                  <label>{{ 'collections.to' | t }} <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | remove: ',' }}" placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}" min="0" step="1" inputmode="numeric"></label>
                </div>
              {%- else -%}
                {%- for value in filter.values limit: 30 -%}
                  <label class="check">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                    {{ value.label | escape }} <span class="count">({{ value.count }})</span>
                  </label>
                {%- endfor -%}
            {%- endcase -%}
          </fieldset>
        {%- endfor -%}
        <label class="field">
          <span>{{ 'collections.sort_by' | t }}</span>
          <select name="sort_by">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </label>
        <noscript><button class="button" type="submit">{{ 'collections.apply' | t }}</button></noscript>
        <a class="link" href="{{ collection.url }}?sort_by={{ collection.sort_by }}">{{ 'collections.clear' | t }}</a>
      </form>
    </details>
    <div>
      <p class="muted">{{ 'collections.count' | t: count: collection.products_count }}</p>
      <ul class="grid">
        {%- for product in collection.products -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- else -%}
          <li class="empty">{{ 'collections.empty' | t }}</li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "min": 8, "max": 48, "step": 4, "label": "Products per page", "default": 24 }
  ]
}
{% endschema %}
