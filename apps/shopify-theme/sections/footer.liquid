<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-title">{{ shop.name }}</p>
      {%- if section.settings.address != blank -%}<p>{{ section.settings.address }}</p>{%- endif -%}
      {%- if section.settings.hours != blank -%}<p>{{ section.settings.hours }}</p>{%- endif -%}
    </div>
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <p class="footer-title">{{ block.settings.heading | escape }}</p>
        <ul class="footer-links">
          {%- for link in block.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>
  <div class="container footer-bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    {%- if settings.demo_mode -%}<span>{{ 'general.demo_notice' | t }}</span>{%- endif -%}
    {{ powered_by_link }}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "address", "label": "Store address", "info": "Confirm with UBC before publishing" },
    { "type": "text", "id": "hours", "label": "Opening hours" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
