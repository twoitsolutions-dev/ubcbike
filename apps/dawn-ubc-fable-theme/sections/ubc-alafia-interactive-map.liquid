    const COLORS = {
      easiest: '#EA580C',
      easy: '#16A34A',
      intermediate: '#2563EB',
      advanced: '#111827',
      expert: '#DC2626',
    };
    const LABELS = {
      easiest: 'Easiest / Adaptive',
      easy: 'Easy',
      intermediate: 'Intermediate',
      advanced: 'Advanced',
      expert: 'Expert',
    };

    const map = L.map('map', { zoomControl: true }).setView([27.772, -82.148], 14);
    const styles = {
      clean: L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}', {
        maxZoom: 19, attribution: 'Tiles &copy; Esri &mdash; OpenStreetMap &amp; Florida DEP'
      }),
      sat: L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
        maxZoom: 19, attribution: 'Tiles &copy; Esri Satellite'
      }),
    };
    let activeTile = styles.clean.addTo(map);

    // Subtle official Florida DEP State Park Boundary
    L.geoJSON(BOUNDARY, {
      style: { color: '#16A34A', weight: 1.6, dashArray: '5 5', fillColor: '#16A34A', fillOpacity: 0.04 },
      interactive: false,
    }).addTo(map);

    // Key Interactive Park Pins (matching Carlos's official Alafia map!)
    const POIS = [
      {
        coords: [27.78490, -82.13775],
        cls: 'shop',
        label: '&#128690; UBC Bike Shop',
        anchor: [10, 14],
        popup:
          '<div style="min-width:215px;">' +
          '<strong style="font-size:14px;color:#14202D;">UBC at Alafia River State Park</strong><br>' +
          '<span style="font-size:12px;color:#475569;">14326 S County Rd 39, Lithia, FL 33547</span><br>' +
          '<div style="margin:6px 0;font-size:12px;line-height:1.45;">' +
          '<b>Wed&ndash;Fri:</b> 10am&ndash;5pm &middot; <b>Sat&ndash;Sun:</b> 8am&ndash;5pm<br>' +
          '<b>Mon&ndash;Tue:</b> Closed / Appointment<br>' +
          'Phone: <a href="tel:+18134598293">(813) 459-8293</a>' +
          '</div>' +
          '<a href="/pages/bike-rentals" style="display:inline-block;background:#E04F33;color:#fff;font-weight:700;font-size:12px;padding:6px 12px;border-radius:999px;text-decoration:none;">Book Bike Rental &rarr;</a>' +
          '</div>',
      },
      {
        coords: [27.78519, -82.13821],
        cls: 'parking',
        label: '&#127359; Trailhead Parking',
        anchor: [130, 22],
        popup:
          '<strong>Main MTB Trailhead &amp; Parking</strong><br>' +
          '<span style="font-size:12px;color:#475569;">Main day-use parking lot, restrooms, water fountain &amp; bike wash.<br>Direct start for <b>Turtle Two Track</b>, <b>Sand Pine</b>, <b>North Creek</b> &amp; <b>Rollercoaster</b>.</span>',
      },
      {
        coords: [27.78011, -82.14403],
        cls: 'entrance',
        label: '&#128679; Park Entrance',
        anchor: [62, 15],
        popup:
          '<strong>Alafia River State Park Entrance &amp; Toll Booth (CR-39)</strong><br>' +
          '<span style="font-size:12px;color:#475569;">Main entrance off S County Rd 39 (14326 S CR 39).<br>Ranger Station: <a href="tel:+18136725320">(813) 672-5320</a><br>State Park entry fee applies at gate.</span>',
      },
      {
        coords: [27.77834, -82.13891],
        cls: 'camp',
        label: '&#9978; Campground',
        anchor: [58, 15],
        popup:
          '<strong>Alafia River State Park Campground</strong><br>' +
          '<span style="font-size:12px;color:#475569;">Restrooms, picnic area &amp; direct ride-in trail access via <b>Campground Connector</b> (0.70 mi, Easy).</span>',
      },
    ];

    const poiGroup = L.featureGroup().addTo(map);
    POIS.forEach((p) => {
      L.circleMarker(p.coords, {
        radius: 5,
        color: '#FFFFFF',
        weight: 2,
        fillColor: p.cls === 'shop' ? '#E04F33' : p.cls === 'parking' ? '#2563EB' : p.cls === 'camp' ? '#15803D' : '#14202D',
        fillOpacity: 1,
      }).addTo(poiGroup);
      const icon = L.divIcon({
        className: '',
        html: '<div class="poi-pin ' + p.cls + '">' + p.label + '</div>',
        iconSize: null,
        iconAnchor: p.anchor || [58, 15],
      });
      L.marker(p.coords, { icon }).addTo(poiGroup).bindPopup(p.popup);
    });

    const groupAll = L.featureGroup().addTo(map);
    const layers = new Map();
    let selected = null;
    let activeDiff = 'all';

    TRAILS.forEach((t) => {
      const grp = L.featureGroup();
      const baseWeight = t.featured ? 4.2 : 2.2;
      const baseDash = t.featured ? null : '4 5';
      t.segments.forEach((seg) => {
        const l = L.polyline(seg, {
          color: COLORS[t.difficulty],
          weight: baseWeight,
          opacity: t.featured ? 0.92 : 0.45,
          dashArray: baseDash,
          lineCap: 'round',
        });
        l.on('click', () => pickTrail(t.name, false));
        l.on('mouseover', () => { if (selected !== t.name) grp.setStyle({ weight: 6.5, opacity: 1 }); });
        l.on('mouseout', () => { if (selected !== t.name) grp.setStyle({ weight: baseWeight, opacity: t.featured ? 0.92 : 0.45 }); });
        l.addTo(grp);
      });
      grp.addTo(groupAll);
      layers.set(t.name, grp);
    });

    map.fitBounds(groupAll.getBounds().extend(poiGroup.getBounds()).pad(0.1));

    const toast = document.getElementById('toast');
    const toastTitle = document.getElementById('toastTitle');
    const toastMeta = document.getElementById('toastMeta');
    const toastDesc = document.getElementById('toastDesc');

    function clearSelection() {
      if (selected && layers.has(selected)) {
        const prev = TRAILS.find((x) => x.name === selected);
        layers.get(selected).setStyle({
          color: COLORS[prev.difficulty],
          weight: prev.featured ? 4.2 : 2.2,
          opacity: prev.featured ? 0.92 : 0.45,
        });
      }
      selected = null;
      toast.classList.remove('show');
      document.querySelectorAll('.row').forEach((r) => r.classList.remove('active'));
    }

    function pickTrail(name, zoom) {
      clearSelection();
      const t = TRAILS.find((x) => x.name === name);
      const grp = layers.get(name);
      if (!t || !grp) return;
      selected = name;
      grp.setStyle({ color: '#F97316', weight: 7.5, opacity: 1 });
      grp.bringToFront();
      if (zoom) map.fitBounds(grp.getBounds().pad(0.42), { maxZoom: 16 });
      toastTitle.textContent = t.name;
      toastMeta.innerHTML =
        '<span class="tag ' + t.difficulty + '">' + LABELS[t.difficulty] + '</span>' +
        '<span>' + t.miles.toFixed(2) + ' mi</span>' +
        (t.oneway ? '<span>&middot; One-Way</span>' : '');
      toastDesc.textContent = t.desc || 'Tap another trail or pin to explore Alafia River State Park.';
      toast.classList.add('show');
      document.querySelectorAll('.row').forEach((r) => {
        const isHit = r.dataset.name === name;
        r.classList.toggle('active', isHit);
        if (isHit) r.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      });
    }

    document.getElementById('toastClose').addEventListener('click', clearSelection);

    const listEl = document.getElementById('list');
    const searchEl = document.getElementById('search');

    function render() {
      const q = (searchEl.value || '').trim().toLowerCase();
      listEl.innerHTML = '';
      TRAILS.forEach((t) => {
        const matchDiff = activeDiff === 'all' || t.difficulty === activeDiff;
        const matchQ = !q || t.name.toLowerCase().includes(q);
        const grp = layers.get(t.name);
        if (matchDiff && matchQ) {
          if (!groupAll.hasLayer(grp)) groupAll.addLayer(grp);
          if (t.featured || q) {
            const row = document.createElement('div');
            row.className = 'row' + (selected === t.name ? ' active' : '');
            row.dataset.name = t.name;
            row.innerHTML =
              '<div class="row-left"><span class="sym ' + t.difficulty + '"></span><span class="row-name">' + t.name + '</span></div>' +
              '<span class="row-mi">' + t.miles.toFixed(2) + ' mi</span>';
            row.addEventListener('click', () => pickTrail(t.name, true));
            listEl.appendChild(row);
          }
        } else {
          if (groupAll.hasLayer(grp)) groupAll.removeLayer(grp);
        }
      });
    }
    render();

    searchEl.addEventListener('input', render);
    document.querySelectorAll('.pill').forEach((p) => {
      p.addEventListener('click', () => {
        document.querySelectorAll('.pill').forEach((x) => x.classList.remove('active'));
        p.classList.add('active');
        activeDiff = p.dataset.diff;
        clearSelection();
        render();
      });
    });

    document.querySelectorAll('.toggle-btn').forEach((b) => {
      b.addEventListener('click', () => {
        document.querySelectorAll('.toggle-btn').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        map.removeLayer(activeTile);
        activeTile = styles[b.dataset.style].addTo(map);
      });
    });

    // Optional live GPS location button for riders at the park
    let userPin = null;
    document.getElementById('gpsBtn').addEventListener('click', () => {
      if (!navigator.geolocation) return alert('GPS location is not supported on this browser.');
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const ll = [pos.coords.latitude, pos.coords.longitude];
          if (userPin) map.removeLayer(userPin);
          userPin = L.circleMarker(ll, { radius: 8, color: '#fff', weight: 3, fillColor: '#2563EB', fillOpacity: 1 })
            .addTo(map).bindPopup('<strong>You are here</strong>').openPopup();
          map.setView(ll, 16);
        },
        () => alert('Please allow location access to see where you are on the trail.'),
        { enableHighAccuracy: true }
      );
    });
  }
initUbcAlafiaMap();
});
</script>

