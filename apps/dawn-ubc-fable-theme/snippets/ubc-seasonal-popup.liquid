        desc: 'Save on lights, locks, bottles, bags, pumps & tools — in stock in Tampa or shipped fast. Backed by our 110% Price Guarantee.',
        cta: 'Apply 10% & Shop Accessories →',
        secLabel: '',
        secHref: ''
      },
      es: {
        badgeBig: '10% OFF',
        badgeSub: 'Accesorios y Equipo',
        eyebrow: 'Bienvenido a UBC Tampa · Desde 1972',
        title: '10% Off en Accesorios y Equipo',
        desc: 'Ahorra en luces, candados, botellas, bolsos, bombas y herramientas — en stock en Tampa o envío rápido con 110% Precio Garantizado.',
        cta: 'Aplicar 10% y Ver Accesorios →',
        secLabel: '',
        secHref: ''
      }
    },
    black_friday: {
      accent: '#E04F33',
      img: {{ img_storefront | json }},
      code: 'BF15GEAR',
      redirect: '/collections/accessories-gear',
      en: {
        badgeBig: '15% OFF',
        badgeSub: 'Accessories Bonus',
        eyebrow: 'Black Friday 2026 · Tampa Showroom & Online',
        title: '15% Off Accessories + Up to $3,500 Off Bikes',
        desc: 'Unlock 15% off lights, locks, bottles, bags & tools — plus lock in Black Friday bike deals with free holiday hold until Dec 24.',
        cta: 'Apply 15% & Shop Accessories →',
        secLabel: 'Jump to Bike Deals',
        secHref: '/collections/black-friday-deals'
      },
      es: {
        badgeBig: '15% OFF',
        badgeSub: 'Bono en Accesorios',
        eyebrow: 'Black Friday 2026 · Tienda Tampa y Online',
        title: '15% Off en Accesorios + Hasta $3,500 Off en Bicis',
        desc: 'Activa 15% off en luces, candados, botellas, bolsos y herramientas — además asegura ofertas Black Friday en bicis con apartado gratis hasta el 24 de dic.',
        cta: 'Aplicar 15% y Ver Accesorios →',
        secLabel: 'Ver Bicis Black Friday',
        secHref: '/collections/black-friday-deals'
      }
    },
    christmas: {
      accent: '#C81E2B',
      img: {{ img_carlos | json }},
      code: 'HOLIDAY10GEAR',
      redirect: '/collections/accessories-gear',
      en: {
        badgeBig: '10% OFF',
        badgeSub: 'Rider Gifts & Gear',
        eyebrow: 'Holiday Gift Event · Free Hold Until Dec 24',
        title: '10% Off Stocking Stuffers & Rider Gifts',
        desc: 'Save on lights, locks, bottles, tools & bags ready to wrap — plus free holiday bike assembly & hidden warehouse hold until Christmas Eve.',
        cta: 'Apply 10% & Shop Rider Gifts →',
        secLabel: '',
        secHref: ''
      },
      es: {
        badgeBig: '10% OFF',
        badgeSub: 'Regalos Ciclistas',
        eyebrow: 'Especial de Navidad · Apartado Gratis hasta Dic 24',
        title: '10% Off en Regalos y Accesorios Ciclistas',
        desc: 'Ahorra en luces, candados, botellas, herramientas y bolsos listos para regalar — más armado profesional y apartado gratis en bicis hasta Nochebuena.',
        cta: 'Aplicar 10% y Ver Regalos →',
        secLabel: '',
        secHref: ''
      }
    },
    july_4: {
      accent: '#1D4ED8',
      img: {{ img_alafia_trail | json }},
      code: 'JULY4GEAR',
      redirect: '/collections/hydration-nutrition',
      en: {
        badgeBig: '10% OFF',
        badgeSub: 'Summer Gear & Fuel',
        eyebrow: 'July 4th Summer Event · Honoring Veterans & Police',
        title: '10% Off Summer Hydration, Lights & Accessories',
        desc: 'Beat the Florida heat with bottles, hydration, tools & gear — plus everyday in-store discounts for U.S. Veterans & Police.',
        cta: 'Apply 10% & Shop Summer Gear →',
        secLabel: 'All Eligible Accessories',
        secHref: '/collections/accessories-gear'
      },
      es: {
        badgeBig: '10% OFF',
        badgeSub: 'Verano e Hidratación',
        eyebrow: 'Especial 4 de Julio · Honor a Veteranos y Policías',
        title: '10% Off en Hidratación, Luces y Accesorios',
        desc: 'Vence el calor de Florida con botellas, hidratación y accesorios — más descuentos permanentes en tienda para Veteranos y Policías.',
        cta: 'Aplicar 10% y Ver Verano →',
        secLabel: 'Todos los Accesorios',
        secHref: '/collections/accessories-gear'
      }
    },
    spring: {
      accent: '#0F766E',
      img: {{ img_alafia_mtb | json }},
      code: 'SPRING10GEAR',
      redirect: '/collections/accessories-gear',
      en: {
        badgeBig: '10% OFF',
        badgeSub: 'Trail & Spring Gear',
        eyebrow: 'Spring Riding Season · Alafia & Bayshore',
        title: '10% Off Trail Accessories, Tools & Hydration',
        desc: 'Dial in your kit for peak Florida trail weather — lights, bags, bottles, pumps & tools. Plus full-suspension rentals inside Alafia.',
        cta: 'Apply 10% & Shop Spring Gear →',
        secLabel: 'Alafia Rentals',
        secHref: '/pages/bike-rentals'
      },
      es: {
        badgeBig: '10% OFF',
        badgeSub: 'Equipo de Sendero',
        eyebrow: 'Temporada de Primavera · Alafia y Bayshore',
        title: '10% Off en Accesorios, Herramientas e Hidratación',
        desc: 'Prepara tu equipo para la mejor temporada de senderos en Florida — luces, bolsos, botellas y bombas. Más rentas MTB dentro de Alafia.',
        cta: 'Aplicar 10% y Ver Equipo →',
        secLabel: 'Rentas en Alafia',
        secHref: '/pages/bike-rentals'
      }
    },
    campus: {
      accent: '#006747',
      img: {{ img_campus | json }},
      code: 'USF15GEAR',
      redirect: '/collections/lights-locks',
      en: {
        badgeBig: '15% OFF',
        badgeSub: 'USF Campus Perks',
        eyebrow: 'Go Bulls · 5 Min From USF on E Fletcher Ave',
        title: '15% Off Campus Locks, Lights & Accessories',
        desc: 'Protect your campus ride with U-locks, USB lights, racks & bags — or show your USF Student ID in-store for same-day service perks.',
        cta: 'Apply 15% & Shop Locks & Lights →',
        secLabel: 'All Accessories',
        secHref: '/collections/accessories-gear'
      },
      es: {
        badgeBig: '15% OFF',
        badgeSub: 'Beneficio USF',
        eyebrow: 'Go Bulls · A 5 Min de USF en E Fletcher Ave',
