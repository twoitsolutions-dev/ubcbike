{%- comment -%}
  UBC Commerce Hub — Shopify Dawn (OS 2.0) Product Fulfillment & Pickup Module
  =============================================================================
  Designed for UBC's modern storefront built on top of Shopify's Dawn base theme.

  Reads the clean primitives published by UBC Commerce Hub's Intermediary Engine:
    - variant.metafields.ubc.availability           ('in_stock' | 'special_order' | 'unavailable')
    - variant.metafields.ubc.lead_time_days         (integer business days)
    - variant.metafields.ubc.click_and_collect_only (boolean — e.g. complete Specialized bikes)

  HOW TO INSTALL IN DAWN:
    Option A (Zero theme file edits — instant test in Shopify Admin):
      Online Store -> Themes -> Customize (Dawn) -> Product template ->
      Product information -> Add block -> Custom Liquid -> Paste this file.

    Option B (Modernized Dawn codebase — recommended for production):
      1. Copy this file to Dawn's `snippets/ubc-dawn-fulfillment.liquid`.
      2. Render inside `sections/main-product.liquid` right below the price or
         variant picker:
           {% render 'ubc-dawn-fulfillment', product: product %}
{%- endcomment -%}

{%- liquid
  assign v = product.selected_or_first_available_variant
  assign status = v.metafields.ubc.availability.value
  if status == blank
    if v.available and v.inventory_quantity > 0
      assign status = 'in_stock'
    elsif v.available
      assign status = 'special_order'
    else
      assign status = 'unavailable'
    endif
  endif
  assign lead_days = v.metafields.ubc.lead_time_days.value
  assign pickup_only = v.metafields.ubc.click_and_collect_only.value
-%}

<style>
  .ubc-fulfillment-card {
    margin: 1.2rem 0;
    padding: 1.2rem 1.4rem;
    border-radius: 0.8rem;
    border: 1px solid rgba(var(--color-foreground, 18, 18, 18), 0.12);
    background: rgba(var(--color-foreground, 18, 18, 18), 0.02);
    font-family: var(--font-body-family, inherit);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .ubc-fulfillment-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.4rem;
    line-height: 1.4;
    font-weight: 600;
  }
  .ubc-dot {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .ubc-fulfillment--in_stock .ubc-dot { background: #15803d; box-shadow: 0 0 0 3px rgba(21, 128, 61, 0.18); }
  .ubc-fulfillment--in_stock .ubc-status-text { color: #166534; }
  .ubc-fulfillment--special_order .ubc-dot { background: #6d28d9; box-shadow: 0 0 0 3px rgba(109, 40, 217, 0.18); }
  .ubc-fulfillment--special_order .ubc-status-text { color: #5b21b6; }
  .ubc-fulfillment--unavailable .ubc-dot { background: #b91c1c; }
  .ubc-fulfillment--unavailable .ubc-status-text { color: #991b1b; }
  .ubc-fulfillment-sub {
    font-size: 1.25rem;
    color: rgba(var(--color-foreground, 18, 18, 18), 0.72);
    margin: 0;
    padding-left: 1.7rem;
  }
  .ubc-pickup-notice {
    margin-top: 0.4rem;
    padding: 0.8rem 1rem;
    border-radius: 0.6rem;
    background: #fef3c7;
    border: 1px solid #f59e0b;
    color: #92400e;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.4;
  }
  .ubc-pickup-notice[hidden] { display: none !important; }
</style>

<div
  class="ubc-fulfillment-card ubc-fulfillment--{{ status }}"
  id="UbcDawnFulfillment-{{ section.id }}"
  data-ubc-dawn-root
>
  <div class="ubc-fulfillment-row">
    <span class="ubc-dot" aria-hidden="true"></span>
    <span class="ubc-status-text" data-ubc-status-text>
      {%- case status -%}
        {%- when 'in_stock' -%}
          In Stock at UBC — Ready for In-Store Pickup or Fast Shipping
        {%- when 'special_order' -%}
          {%- if lead_days != blank -%}
            Available to Order — Estimated {{ lead_days }} Business Days
          {%- else -%}
            Available to Order from Authorized Distributor (3–5 Business Days)
          {%- endif -%}
        {%- else -%}
          Currently Unavailable
      {%- endcase -%}
    </span>
  </div>

  <p class="ubc-fulfillment-sub" data-ubc-status-sub>
    {%- case status -%}
      {%- when 'in_stock' -%}
        Physically on hand at University Bicycle Center.
      {%- when 'special_order' -%}
        Ordered directly from our authorized U.S. cycling distributor upon checkout.
      {%- else -%}
        Out of stock in store and across authorized distributors.
    {%- endcase -%}
  </p>

  <div class="ubc-pickup-notice" data-ubc-pickup-notice{% unless pickup_only %} hidden{% endunless %}>
    <strong>In-Store Pickup Only (Click &amp; Collect):</strong> Per authorized brand policy, complete bicycles include professional UBC assembly &amp; safety inspection and must be picked up at our store.
  </div>

  <script type="application/json" data-ubc-variants-json>
    {
      {%- for variant in product.variants -%}
        {%- liquid
          assign vs = variant.metafields.ubc.availability.value
          if vs == blank
            if variant.available and variant.inventory_quantity > 0
              assign vs = 'in_stock'
            elsif variant.available
              assign vs = 'special_order'
            else
              assign vs = 'unavailable'
            endif
          endif
          assign vl = variant.metafields.ubc.lead_time_days.value
          assign vp = variant.metafields.ubc.click_and_collect_only.value
        -%}
        "{{ variant.id }}": {
          "status": {{ vs | json }},
          "leadDays": {{ vl | default: null | json }},
          "pickupOnly": {{ vp | default: false | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  </script>
</div>

<script>
  (function () {
    'use strict';
    var root = document.getElementById('UbcDawnFulfillment-{{ section.id }}');
    if (!root) return;
    var jsonEl = root.querySelector('[data-ubc-variants-json]');
    var map = null;
    try { map = JSON.parse(jsonEl.textContent); } catch (e) { map = null; }
    if (!map) return;

    var statusText = root.querySelector('[data-ubc-status-text]');
    var statusSub = root.querySelector('[data-ubc-status-sub]');
    var pickupEl = root.querySelector('[data-ubc-pickup-notice]');

    function applyVariant(variantId) {
      var info = map[String(variantId)];
      if (!info) return;
      root.className = 'ubc-fulfillment-card ubc-fulfillment--' + info.status;
      if (info.status === 'in_stock') {
        statusText.textContent = 'In Stock at UBC — Ready for In-Store Pickup or Fast Shipping';
        statusSub.textContent = 'Physically on hand at University Bicycle Center.';
      } else if (info.status === 'special_order') {
        statusText.textContent = info.leadDays
          ? 'Available to Order — Estimated ' + info.leadDays + ' Business Days'
          : 'Available to Order from Authorized Distributor (3–5 Business Days)';
        statusSub.textContent = 'Ordered directly from our authorized U.S. cycling distributor upon checkout.';
      } else {
        statusText.textContent = 'Currently Unavailable';
        statusSub.textContent = 'Out of stock in store and across authorized distributors.';
      }
      if (pickupEl) {
        pickupEl.hidden = !info.pickupOnly;
      }
    }

    document.addEventListener('change', function (e) {
      var form = e.target && e.target.closest ? e.target.closest('form[action*="/cart/add"]') : null;
      if (form) {
        var idInput = form.querySelector('input[name="id"], select[name="id"]');
        if (idInput && idInput.value) applyVariant(idInput.value);
      }
      setTimeout(function () {
        var params = new URLSearchParams(window.location.search);
        var vid = params.get('variant');
        if (vid) applyVariant(vid);
      }, 60);
    });
  })();
</script>
