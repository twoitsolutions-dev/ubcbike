  <header class="fb-header" id="fbHeader">
    <div class="fb-wrap">
      <div class="fb-logo-group">
        <a class="fb-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} — home">
          {%- if settings.logo != blank -%}
            {{
              settings.logo
              | image_url: width: 520
              | image_tag: width: 172, height: 35, alt: shop.name
            }}
          {%- else -%}
            <img
              class="fb-logo-dark"
              src="{{ 'fable-logo-navy.png' | asset_url }}"
              width="172"
              height="35"
              alt="{{ shop.name | escape }}"
            >
            <img
              class="fb-logo-light"
              src="{{ 'fable-logo-white.png' | asset_url }}"
              width="172"
              height="35"
              alt="{{ shop.name | escape }}"
            >
          {%- endif -%}
        </a>
        <span class="fb-partner-pill fb-partner-pill--campus" aria-hidden="true">
          <img src="{{ 'usf-bulls-logo.png' | asset_url }}" width="28" height="22" alt="">
          <span>USF CAMPUS</span>
        </span>
        <span class="fb-partner-pill fb-partner-pill--vet" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><polygon points="12,2 14.9,8.3 21.8,9.1 16.7,13.8 18.1,20.6 12,17.2 5.9,20.6 7.3,13.8 2.2,9.1 9.1,8.3"/></svg>
          <span>VETERAN FOUNDED</span>
        </span>
      </div>

      <ul class="fb-nav" id="fbNav">
        {%- if section.settings.menu != blank and section.settings.menu.links.size > 3 -%}
          {%- for link in section.settings.menu.links -%}
            {%- if link.links != blank -%}
              <li class="has-mega">
                <button type="button" aria-expanded="false" aria-controls="megaNav-{{ forloop.index }}">
                  <span>{{ link.title | escape }}</span>
                  <svg aria-hidden="true"><use href="#i-chev"/></svg>
                </button>
                <div class="mega" id="megaNav-{{ forloop.index }}">
                  <div class="fb-wrap">
                    {%- for childlink in link.links -%}
                      <div>
                        <h4><a href="{{ childlink.url }}">{{ childlink.title | escape }}</a></h4>
                        {%- if childlink.links != blank -%}
                          <ul>
                            {%- for grandchildlink in childlink.links -%}
                              <li>
                                <a href="{{ grandchildlink.url }}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                                  {{ grandchildlink.title | escape }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              </li>
            {%- else -%}
              <li>
                <a
                  {% if forloop.first %}class="nav-accent"{% endif %}
                  href="{{ link.url }}"
                  {% if link.current %}aria-current="page"{% endif %}
                >
                  {%- if forloop.first -%}<i aria-hidden="true"></i>{%- endif -%}
                  <span>{{ link.title | escape }}</span>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
