{%- comment -%}
  Editorial hero (accessories): full-bleed photo, three short text columns at the top,
  a giant wordmark rising from the bottom edge, a paragraph and tag on the right.
{%- endcomment -%}
<section class="editorial" data-scroll-progress data-reveal aria-labelledby="Editorial-{{ section.id }}">
  <div class="editorial-media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2200 | image_tag: loading: 'lazy', widths: '800, 1200, 1600, 2200', sizes: '100vw', alt: section.settings.image.alt | escape }}
    {%- endif -%}
  </div>
  <div class="container editorial-inner">
    <ul class="editorial-cols">
      {%- if section.settings.col1 != blank -%}<li>{{ section.settings.col1 | escape }}</li>{%- endif -%}
      {%- if section.settings.col2 != blank -%}<li>{{ section.settings.col2 | escape }}</li>{%- endif -%}
      {%- if section.settings.col3 != blank -%}<li>{{ section.settings.col3 | escape }}</li>{%- endif -%}
    </ul>
    <div class="editorial-bottom">
      <h2 class="editorial-word" id="Editorial-{{ section.id }}"><span>{{ section.settings.word | escape }}</span></h2>
      <div class="editorial-side">
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="ubc-btn ubc-btn--light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Close-up of a rider with helmet or glasses; only photos UBC owns or is licensed to use" },
    { "type": "text", "id": "col1", "label": "Top text 1", "default": "Helmets" },
    { "type": "text", "id": "col2", "label": "Top text 2", "default": "Eyewear & lights" },
    { "type": "text", "id": "col3", "label": "Top text 3", "default": "Fitted in store" },
    { "type": "text", "id": "word", "label": "Giant word", "default": "Gear up" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The kit that makes every ride safer and more comfortable — tried on and adjusted at UBC." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop accessories" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Editorial hero" }]
}
{% endschema %}
