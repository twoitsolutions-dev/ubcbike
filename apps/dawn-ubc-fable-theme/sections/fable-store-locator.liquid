            { "days": [1, 2, 3, 4, 5], "label": ["Mon – Fri", "Lun – Vie"], "time": ["10:00am – 6:00pm", "10:00am – 6:00pm"] },
            { "days": [6], "label": ["Sat", "Sáb"], "time": ["9:00am – 5:00pm", "9:00am – 5:00pm"] },
            { "days": [0], "label": ["Sun", "Dom"], "time": ["Closed", "Cerrado"] }
