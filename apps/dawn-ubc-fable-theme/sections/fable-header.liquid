              <span data-es="Tienda">Shop All</span>
              <svg aria-hidden="true"><use href="#i-chev"/></svg>
            </button>
            <div class="mega" id="megaBikes">
              <div class="fb-wrap">
                <div>
                  <h4 data-es="Bicicletas y Eléctricas">Bikes &amp; Electric</h4>
                  <ul>
                    <li><a href="{{ road_href }}" data-ride-jump="road" data-es="Bicis de Ruta y Gravel">Road &amp; Gravel Bikes</a></li>
                    <li><a href="{{ mtb_href }}" data-ride-jump="mtb" data-es="Bicis de Montaña">Mountain Bikes</a></li>
                    <li><a href="{{ hybrid_href }}" data-ride-jump="fitness" data-es="Híbridas y Urbanas">Hybrid &amp; Urban Bikes</a></li>
                    <li><a href="{% if collections['kids-bikes'] != blank %}{{ collections['kids-bikes'].url }}{% else %}{{ all_bikes_href }}{% endif %}" data-es="Bicis para Niños y BMX">Children's &amp; BMX Bikes</a></li>
                    <li><a href="{{ ebike_href }}" data-ride-jump="electric" data-es="Bicicletas Eléctricas">Electric Bikes</a></li>
                    <li><a href="{{ all_bikes_href }}" data-es="Todas las Bicis">All Bikes</a></li>
                  </ul>
                </div>
                <div>
                  <h4 data-es="Componentes">Components</h4>
