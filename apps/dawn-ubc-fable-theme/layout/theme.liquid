<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FEFDF3">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#14202D">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/png" sizes="32x32" href="{{ 'fable-favicon.png' | asset_url }}">
    {%- endif -%}

    {%- if settings.ubc_use_custom_brand_fonts == false -%}
      {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
        <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {%- endunless -%}
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <script type="module">
      import * as StandardEvents from 'https://cdn.shopify.com/storefront/standard-events.js';

      window.StandardEvents = StandardEvents;

      customElements.define('collection-component', StandardEvents.createViewEventElement());
      customElements.define(
        'product-component',
        StandardEvents.createViewEventElement(HTMLElement, { defaultTrigger: 'intersect' }),
      );

      document.addEventListener('DOMContentLoaded', () => {
        const template = document.querySelector('main[data-template]')?.dataset.template || '';
        document.dispatchEvent(
          new StandardEvents.PageViewEvent({
            page: { template, title: document.title, url: window.location.href },
          })
        );
      }, { once: true });
    </script>

    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart-disclosure-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart-disclosure-tooltip.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-disclosure.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'standard-actions-override.js' | asset_url }}" defer="defer"></script>

    {%- if settings.animations_reveal_on_scroll -%}
      <script src="{{ 'animations.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {{ content_for_header }}

    {%- liquid
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
    %}

    {% style %}
      {%- if settings.ubc_use_custom_brand_fonts == false -%}
        {{ settings.type_body_font | font_face: font_display: 'swap' }}
        {{ body_font_bold | font_face: font_display: 'swap' }}
        {{ body_font_italic | font_face: font_display: 'swap' }}
        {{ body_font_bold_italic | font_face: font_display: 'swap' }}
        {{ settings.type_header_font | font_face: font_display: 'swap' }}
      {%- endif -%}

      {%- liquid
        assign ubc_active_edition = settings.ubc_edition | default: 'classic'
        assign ubc_fb_bg = '254,253,243'
        assign ubc_fb_hex = '#FEFDF3'
        assign ubc_fb_fg = '20,32,45'
        assign ubc_fb_contrast = '195,191,152'
        assign ubc_fb_btn = '33,53,73'
        assign ubc_fb_btn_txt = '254,253,243'
        assign ubc_fb_sec = '33,53,73'
        if ubc_active_edition == 'black_friday'
          assign ubc_fb_bg = '241,243,246'
          assign ubc_fb_hex = '#F1F3F6'
          assign ubc_fb_fg = '7,11,16'
          assign ubc_fb_btn = '18,27,38'
          assign ubc_fb_btn_txt = '241,243,246'
          assign ubc_fb_sec = '18,27,38'
        elsif ubc_active_edition == 'christmas'
          assign ubc_fb_bg = '243,247,243'
          assign ubc_fb_hex = '#F3F7F3'
          assign ubc_fb_fg = '9,30,21'
          assign ubc_fb_btn = '20,59,42'
          assign ubc_fb_btn_txt = '254,253,243'
          assign ubc_fb_sec = '20,59,42'
        elsif ubc_active_edition == 'july_4'
          assign ubc_fb_bg = '241,246,253'
          assign ubc_fb_hex = '#F1F6FD'
          assign ubc_fb_fg = '8,23,46'
          assign ubc_fb_btn = '22,56,107'
          assign ubc_fb_btn_txt = '254,253,243'
          assign ubc_fb_sec = '22,56,107'
        endif

        assign body_scale_safe = settings.body_scale | default: 100 | plus: 0
        if body_scale_safe <= 0
          assign body_scale_safe = 100
        endif
        assign heading_scale_safe = settings.heading_scale | default: 100 | plus: 0
        if heading_scale_safe <= 0
          assign heading_scale_safe = 100
        endif
        assign page_width_safe = settings.page_width | default: 1200 | plus: 0
        if page_width_safe <= 0
          assign page_width_safe = 1200
        endif
        assign spacing_sections_safe = settings.spacing_sections | default: 0 | plus: 0
        assign grid_v_safe = settings.spacing_grid_vertical | default: 8 | plus: 0
        assign grid_h_safe = settings.spacing_grid_horizontal | default: 8 | plus: 0
        assign buttons_radius_safe = settings.buttons_radius | default: 40 | plus: 0
        assign buttons_border_thick_safe = settings.buttons_border_thickness | default: 1 | plus: 0
        assign buttons_border_op_safe = settings.buttons_border_opacity | default: 100 | plus: 0
        assign buttons_shadow_op_safe = settings.buttons_shadow_opacity | default: 0 | plus: 0
        assign inputs_radius_safe = settings.inputs_radius | default: 12 | plus: 0
        assign inputs_border_thick_safe = settings.inputs_border_thickness | default: 1 | plus: 0
        assign inputs_border_op_safe = settings.inputs_border_opacity | default: 55 | plus: 0
        assign inputs_shadow_op_safe = settings.inputs_shadow_opacity | default: 0 | plus: 0
        assign inputs_shadow_v_safe = settings.inputs_shadow_vertical_offset | default: 4 | plus: 0
      -%}

      :root,
      .color-scheme-1 {
        --color-background: {{ ubc_fb_bg }};
        --gradient-background: {{ ubc_fb_hex }};
        --color-foreground: {{ ubc_fb_fg }};
        --color-background-contrast: {{ ubc_fb_contrast }};
        --color-shadow: {{ ubc_fb_btn }};
        --color-button: {{ ubc_fb_btn }};
        --color-button-text: {{ ubc_fb_btn_txt }};
        --color-secondary-button: {{ ubc_fb_bg }};
        --color-secondary-button-text: {{ ubc_fb_sec }};
        --color-link: {{ ubc_fb_sec }};
        --color-badge-foreground: {{ ubc_fb_fg }};
        --color-badge-background: {{ ubc_fb_bg }};
        --color-badge-border: {{ ubc_fb_fg }};
        --payment-terms-background-color: rgb({{ ubc_fb_bg }});
      }

      {% for scheme in settings.color_schemes -%}
        {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
        {% if forloop.index == 1 -%}
          :root,
        {%- endif %}
        .color-{{ scheme.id }} {
          --color-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
        {% if scheme.settings.background_gradient != empty %}
          --gradient-background: {{ scheme.settings.background_gradient }};
        {% else %}
          --gradient-background: {{ scheme.settings.background }};
        {% endif %}

        {% liquid
          assign background_color = scheme.settings.background
          assign background_color_brightness = background_color | color_brightness
          if background_color_brightness <= 26
            assign background_color_contrast = background_color | color_lighten: 50
          elsif background_color_brightness <= 65
            assign background_color_contrast = background_color | color_lighten: 5
          else
            assign background_color_contrast = background_color | color_darken: 25
          endif
        %}

        --color-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
        --color-background-contrast: {{ background_color_contrast.red }},{{ background_color_contrast.green }},{{ background_color_contrast.blue }};
        --color-shadow: {{ scheme.settings.shadow.red }},{{ scheme.settings.shadow.green }},{{ scheme.settings.shadow.blue }};
        --color-button: {{ scheme.settings.button.red }},{{ scheme.settings.button.green }},{{ scheme.settings.button.blue }};
        --color-button-text: {{ scheme.settings.button_label.red }},{{ scheme.settings.button_label.green }},{{ scheme.settings.button_label.blue }};
        --color-secondary-button: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
        --color-secondary-button-text: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};
        --color-link: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};
        --color-badge-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
        --color-badge-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
        --color-badge-border: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
        --payment-terms-background-color: rgb({{ scheme.settings.background.rgb }});
      }
      {% endfor %}

      {{ scheme_classes | prepend: 'body' }} {
        color: rgba(var(--color-foreground), 0.75);
        background-color: rgb(var(--color-background));
      }

      :root {
        --font-body-family: {{ settings.type_body_font.family | default: 'Barlow' }}, {{ settings.type_body_font.fallback_families | default: 'sans-serif' }};
        --font-body-style: {{ settings.type_body_font.style | default: 'normal' }};
        --font-body-weight: {{ settings.type_body_font.weight | default: 400 }};
        --font-body-weight-bold: {{ settings.type_body_font.weight | default: 400 | plus: 300 | at_most: 1000 }};

        --font-heading-family: {{ settings.type_header_font.family | default: 'Anton' }}, {{ settings.type_header_font.fallback_families | default: 'sans-serif' }};
        --font-heading-style: {{ settings.type_header_font.style | default: 'normal' }};
        --font-heading-weight: {{ settings.type_header_font.weight | default: 400 }};

        --font-body-scale: {{ body_scale_safe | divided_by: 100.0 }};
        --font-heading-scale: {{ heading_scale_safe | times: 1.0 | divided_by: body_scale_safe }};

        --media-padding: {{ settings.media_padding | default: 0 }}px;
        --media-border-opacity: {{ settings.media_border_opacity | default: 5 | divided_by: 100.0 }};
        --media-border-width: {{ settings.media_border_thickness | default: 1 }}px;
        --media-radius: {{ settings.media_radius | default: 16 }}px;
        --media-shadow-opacity: {{ settings.media_shadow_opacity | default: 0 | divided_by: 100.0 }};
        --media-shadow-horizontal-offset: {{ settings.media_shadow_horizontal_offset | default: 0 }}px;
        --media-shadow-vertical-offset: {{ settings.media_shadow_vertical_offset | default: 4 }}px;
        --media-shadow-blur-radius: {{ settings.media_shadow_blur | default: 5 }}px;
        --media-shadow-visible: {% if settings.media_shadow_opacity > 0 %}1{% else %}0{% endif %};

        --page-width: {{ page_width_safe | divided_by: 10 }}rem;
        --page-width-margin: {% if page_width_safe == 1600 %}2{% else %}0{% endif %}rem;

        --product-card-image-padding: {{ settings.card_image_padding | default: 0 | divided_by: 10.0 }}rem;
        --product-card-corner-radius: {{ settings.card_corner_radius | default: 16 | divided_by: 10.0 }}rem;
        --product-card-text-alignment: {{ settings.card_text_alignment | default: 'left' }};
        --product-card-border-width: {{ settings.card_border_thickness | default: 0 | divided_by: 10.0 }}rem;
        --product-card-border-opacity: {{ settings.card_border_opacity | default: 10 | divided_by: 100.0 }};
        --product-card-shadow-opacity: {{ settings.card_shadow_opacity | default: 0 | divided_by: 100.0 }};
        --product-card-shadow-visible: {% if settings.card_shadow_opacity > 0 %}1{% else %}0{% endif %};
        --product-card-shadow-horizontal-offset: {{ settings.card_shadow_horizontal_offset | default: 0 | divided_by: 10.0 }}rem;
        --product-card-shadow-vertical-offset: {{ settings.card_shadow_vertical_offset | default: 4 | divided_by: 10.0 }}rem;
        --product-card-shadow-blur-radius: {{ settings.card_shadow_blur | default: 5 | divided_by: 10.0 }}rem;

        --collection-card-image-padding: {{ settings.collection_card_image_padding | default: 0 | divided_by: 10.0 }}rem;
        --collection-card-corner-radius: {{ settings.collection_card_corner_radius | default: 16 | divided_by: 10.0 }}rem;
        --collection-card-text-alignment: {{ settings.collection_card_text_alignment | default: 'left' }};
        --collection-card-border-width: {{ settings.collection_card_border_thickness | default: 0 | divided_by: 10.0 }}rem;
        --collection-card-border-opacity: {{ settings.collection_card_border_opacity | default: 10 | divided_by: 100.0 }};
        --collection-card-shadow-opacity: {{ settings.collection_card_shadow_opacity | default: 0 | divided_by: 100.0 }};
        --collection-card-shadow-visible: {% if settings.collection_card_shadow_opacity > 0 %}1{% else %}0{% endif %};
        --collection-card-shadow-horizontal-offset: {{ settings.collection_card_shadow_horizontal_offset | default: 0 | divided_by: 10.0 }}rem;
        --collection-card-shadow-vertical-offset: {{ settings.collection_card_shadow_vertical_offset | default: 4 | divided_by: 10.0 }}rem;
        --collection-card-shadow-blur-radius: {{ settings.collection_card_shadow_blur | default: 5 | divided_by: 10.0 }}rem;

        --blog-card-image-padding: {{ settings.blog_card_image_padding | default: 0 | divided_by: 10.0 }}rem;
        --blog-card-corner-radius: {{ settings.blog_card_corner_radius | default: 16 | divided_by: 10.0 }}rem;
        --blog-card-text-alignment: {{ settings.blog_card_text_alignment | default: 'left' }};
        --blog-card-border-width: {{ settings.blog_card_border_thickness | default: 0 | divided_by: 10.0 }}rem;
        --blog-card-border-opacity: {{ settings.blog_card_border_opacity | default: 10 | divided_by: 100.0 }};
        --blog-card-shadow-opacity: {{ settings.blog_card_shadow_opacity | default: 0 | divided_by: 100.0 }};
        --blog-card-shadow-visible: {% if settings.blog_card_shadow_opacity > 0 %}1{% else %}0{% endif %};
        --blog-card-shadow-horizontal-offset: {{ settings.blog_card_shadow_horizontal_offset | default: 0 | divided_by: 10.0 }}rem;
        --blog-card-shadow-vertical-offset: {{ settings.blog_card_shadow_vertical_offset | default: 4 | divided_by: 10.0 }}rem;
        --blog-card-shadow-blur-radius: {{ settings.blog_card_shadow_blur | default: 5 | divided_by: 10.0 }}rem;

        --badge-corner-radius: {{ settings.badge_corner_radius | default: 40 | divided_by: 10.0 }}rem;

        --popup-border-width: {{ settings.popup_border_thickness | default: 1 }}px;
        --popup-border-opacity: {{ settings.popup_border_opacity | default: 10 | divided_by: 100.0 }};
        --popup-corner-radius: {{ settings.popup_corner_radius | default: 16 }}px;
        --popup-shadow-opacity: {{ settings.popup_shadow_opacity | default: 5 | divided_by: 100.0 }};
        --popup-shadow-horizontal-offset: {{ settings.popup_shadow_horizontal_offset | default: 0 }}px;
        --popup-shadow-vertical-offset: {{ settings.popup_shadow_vertical_offset | default: 4 }}px;
        --popup-shadow-blur-radius: {{ settings.popup_shadow_blur | default: 5 }}px;

        --drawer-border-width: {{ settings.drawer_border_thickness | default: 1 }}px;
        --drawer-border-opacity: {{ settings.drawer_border_opacity | default: 10 | divided_by: 100.0 }};
        --drawer-shadow-opacity: {{ settings.drawer_shadow_opacity | default: 0 | divided_by: 100.0 }};
        --drawer-shadow-horizontal-offset: {{ settings.drawer_shadow_horizontal_offset | default: 0 }}px;
        --drawer-shadow-vertical-offset: {{ settings.drawer_shadow_vertical_offset | default: 4 }}px;
        --drawer-shadow-blur-radius: {{ settings.drawer_shadow_blur | default: 5 }}px;

        --spacing-sections-desktop: {{ spacing_sections_safe }}px;
        --spacing-sections-mobile: {% if spacing_sections_safe < 24 %}{{ spacing_sections_safe }}{% else %}{{ spacing_sections_safe | times: 0.7 | round | at_least: 20 }}{% endif %}px;

        --grid-desktop-vertical-spacing: {{ grid_v_safe }}px;
        --grid-desktop-horizontal-spacing: {{ grid_h_safe }}px;
        --grid-mobile-vertical-spacing: {{ grid_v_safe | divided_by: 2 }}px;
        --grid-mobile-horizontal-spacing: {{ grid_h_safe | divided_by: 2 }}px;

        --text-boxes-border-opacity: {{ settings.text_boxes_border_opacity | default: 10 | divided_by: 100.0 }};
        --text-boxes-border-width: {{ settings.text_boxes_border_thickness | default: 0 }}px;
        --text-boxes-radius: {{ settings.text_boxes_radius | default: 0 }}px;
        --text-boxes-shadow-opacity: {{ settings.text_boxes_shadow_opacity | default: 0 | divided_by: 100.0 }};
        --text-boxes-shadow-visible: {% if settings.text_boxes_shadow_opacity > 0 %}1{% else %}0{% endif %};
        --text-boxes-shadow-horizontal-offset: {{ settings.text_boxes_shadow_horizontal_offset | default: 0 }}px;
        --text-boxes-shadow-vertical-offset: {{ settings.text_boxes_shadow_vertical_offset | default: 4 }}px;
        --text-boxes-shadow-blur-radius: {{ settings.text_boxes_shadow_blur | default: 5 }}px;

        --buttons-radius: {{ buttons_radius_safe }}px;
        --buttons-radius-outset: {% if buttons_radius_safe > 0 %}{{ buttons_radius_safe | plus: buttons_border_thick_safe }}{% else %}0{% endif %}px;
        --buttons-border-width: {% if buttons_border_op_safe > 0 %}{{ buttons_border_thick_safe }}{% else %}0{% endif %}px;
        --buttons-border-opacity: {{ buttons_border_op_safe | divided_by: 100.0 }};
        --buttons-shadow-opacity: {{ buttons_shadow_op_safe | divided_by: 100.0 }};
        --buttons-shadow-visible: {% if buttons_shadow_op_safe > 0 %}1{% else %}0{% endif %};
        --buttons-shadow-horizontal-offset: {{ settings.buttons_shadow_horizontal_offset | default: 0 }}px;
        --buttons-shadow-vertical-offset: {{ settings.buttons_shadow_vertical_offset | default: 4 }}px;
        --buttons-shadow-blur-radius: {{ settings.buttons_shadow_blur | default: 5 }}px;
        --buttons-border-offset: {% if buttons_radius_safe > 0 or buttons_shadow_op_safe > 0 %}0.3{% else %}0{% endif %}px;

        --inputs-radius: {{ inputs_radius_safe }}px;
        --inputs-border-width: {{ inputs_border_thick_safe }}px;
        --inputs-border-opacity: {{ inputs_border_op_safe | divided_by: 100.0 }};
        --inputs-shadow-opacity: {{ inputs_shadow_op_safe | divided_by: 100.0 }};
        --inputs-shadow-horizontal-offset: {{ settings.inputs_shadow_horizontal_offset | default: 0 }}px;
        --inputs-margin-offset: {% if inputs_shadow_v_safe != 0 and inputs_shadow_op_safe > 0 %}{{ inputs_shadow_v_safe | abs }}{% else %}0{% endif %}px;
        --inputs-shadow-vertical-offset: {{ inputs_shadow_v_safe }}px;
        --inputs-shadow-blur-radius: {{ settings.inputs_shadow_blur | default: 5 }}px;
        --inputs-radius-outset: {% if inputs_radius_safe > 0 %}{{ inputs_radius_safe | plus: inputs_border_thick_safe }}{% else %}0{% endif %}px;

        --variant-pills-radius: {{ settings.variant_pills_radius | default: 40 }}px;
        --variant-pills-border-width: {{ settings.variant_pills_border_thickness | default: 1 }}px;
        --variant-pills-border-opacity: {{ settings.variant_pills_border_opacity | default: 55 | divided_by: 100.0 }};
        --variant-pills-shadow-opacity: {{ settings.variant_pills_shadow_opacity | default: 0 | divided_by: 100.0 }};
        --variant-pills-shadow-horizontal-offset: {{ settings.variant_pills_shadow_horizontal_offset | default: 0 }}px;
        --variant-pills-shadow-vertical-offset: {{ settings.variant_pills_shadow_vertical_offset | default: 4 }}px;
        --variant-pills-shadow-blur-radius: {{ settings.variant_pills_shadow_blur | default: 5 }}px;
      }

      *,
      *::before,
      *::after {
        box-sizing: inherit;
      }

      html {
        box-sizing: border-box;
        font-size: calc(var(--font-body-scale) * 62.5%);
        height: 100%;
      }

      body {
        display: flex;
        flex-direction: column;
        min-height: 100%;
        margin: 0;
        font-size: 1.5rem;
        letter-spacing: 0.06rem;
        line-height: calc(1 + 0.8 / var(--font-body-scale));
        font-family: var(--font-body-family);
        font-style: var(--font-body-style);
        font-weight: var(--font-body-weight);
      }

      @media screen and (min-width: 750px) {
        body {
          font-size: 1.6rem;
        }
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {%- comment -%} [UBC-MOD] Isolated UBC head assets & typography bridge {%- endcomment -%}
    {%- render 'ubc-head-bridge' -%}
    <link rel="stylesheet" href="{{ 'component-cart-items.css' | asset_url }}" media="print" onload="this.media='all'">

    {%- if settings.cart_type == 'drawer' -%}
      {{ 'component-cart-drawer.css' | asset_url | stylesheet_tag }}
      {{ 'component-cart.css' | asset_url | stylesheet_tag }}
      {{ 'component-totals.css' | asset_url | stylesheet_tag }}
      {{ 'component-price.css' | asset_url | stylesheet_tag }}
      {{ 'component-discounts.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    {%- if settings.ubc_use_custom_brand_fonts == false -%}
      {%- unless settings.type_body_font.system? -%}
        {% comment %}theme-check-disable AssetPreload{% endcomment %}
        <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>
        {% comment %}theme-check-enable AssetPreload{% endcomment %}
      {%- endunless -%}
      {%- unless settings.type_header_font.system? -%}
        {% comment %}theme-check-disable AssetPreload{% endcomment %}
        <link rel="preload" as="font" href="{{ settings.type_header_font | font_url }}" type="font/woff2" crossorigin>
        {% comment %}theme-check-enable AssetPreload{% endcomment %}
      {%- endunless -%}
    {%- endif -%}

    {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
      {{ 'component-localization-form.css' | asset_url | stylesheet_tag: preload: true }}
      <script src="{{ 'localization-form.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if settings.predictive_search_enabled -%}
      <link
        rel="stylesheet"
        href="{{ 'component-predictive-search.css' | asset_url }}"
        media="print"
        onload="this.media='all'"
      >
    {%- endif -%}

    <script>
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
  </head>

  <body
    class="gradient{% if settings.animations_hover_elements != blank and settings.animations_hover_elements != 'none' %} animate--hover-{{ settings.animations_hover_elements }}{% else %} animate--hover-default{% endif %}"
    data-ubc-edition="{{ settings.ubc_edition | default: 'classic' | escape }}"
  >
    {%- if settings.ubc_show_edition_switcher != false -%}
      <script>
        (function () {
          try {
            var m = /[?&]edition=(classic|spring|july_4|campus|veterans|black_friday|christmas)\b/.exec(window.location.search);
            var ed = m ? m[1] : sessionStorage.getItem('ubc_edition_override');
            if (m) {
              try { sessionStorage.setItem('ubc_edition_override', m[1]); } catch (e) {}
            }
            if (ed === 'classic' || ed === 'spring' || ed === 'july_4' || ed === 'campus' || ed === 'veterans' || ed === 'black_friday' || ed === 'christmas') {
              document.body.setAttribute('data-ubc-edition', ed);
            }
          } catch (e) {}
        })();
      </script>
    {%- endif -%}
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {%- if settings.cart_type == 'drawer' -%}
