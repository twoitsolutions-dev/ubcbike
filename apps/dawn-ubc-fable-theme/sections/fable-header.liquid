{%- comment -%}
  UBC Dawn Ecommerce v23 — Storewide Header, Edition Topbar, Shopify `link_list` Navigation & Mobile Drawer
  - Dynamic `tel:` href synced to `section.settings.phone` (topbar + mobile drawer).
  - Native Shopify Navigation (`section.settings.menu` / `mobile_menu`) support with curated zero-404 UBC fallback.
  - Native Shopify Markets SEO language links (`localization.available_languages` / `/es`) with JS fallback when single-locale.
{%- endcomment -%}
{%- liquid
  assign edition = settings.ubc_edition | default: 'classic'

  assign raw_phone = section.settings.phone | default: '(813) 971-2277'
  assign phone_digits = raw_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' | remove: '+'
  if phone_digits.size == 10
    assign phone_tel = '+1' | append: phone_digits
  elsif phone_digits != blank
    assign phone_tel = '+' | append: phone_digits
  else
    assign phone_tel = '+18139712277'
  endif

  assign home_anchor = ''
  if template.name != 'index'
    assign home_anchor = routes.root_url
    unless home_anchor == '/'
      assign home_anchor = home_anchor | append: '/'
    endunless
  endif

  assign story_href = home_anchor | append: '#family'
  if pages['our-story'] != blank
    assign story_href = pages['our-story'].url
  endif

  assign locations_href = home_anchor | append: '#stores'
  if pages['locations'] != blank
    assign locations_href = pages['locations'].url
  endif

  assign ebike_href = home_anchor | append: '#ebikes'
  if collections['electric-bikes'] != blank
    assign ebike_href = collections['electric-bikes'].url
  endif

  assign road_href = home_anchor | append: '#finder'
  if collections['road-bikes'] != blank
    assign road_href = collections['road-bikes'].url
  endif

  assign mtb_href = home_anchor | append: '#finder'
  if collections['mountain-bikes'] != blank
    assign mtb_href = collections['mountain-bikes'].url
  endif

  assign hybrid_href = home_anchor | append: '#finder'
  if collections['hybrid-bikes'] != blank
    assign hybrid_href = collections['hybrid-bikes'].url
  endif

  assign all_bikes_href = routes.all_products_collection_url
  if collections['bikes'] != blank
    assign all_bikes_href = collections['bikes'].url
  endif

  assign drawer_menu = section.settings.mobile_menu | default: section.settings.menu
-%}
