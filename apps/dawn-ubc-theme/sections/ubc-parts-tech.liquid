{%- comment -%}
  UBC Technologies & Spare Parts Circle Slider (Pin 4 Top)
  - Giant watermark + dot-matrix grid
  - Left kicker, bold uppercase heading, copy, pill CTA
  - Right floating 3D component cutout over coral circle halo + prev/next + dots
{%- endcomment -%}
<section class="ub-tech" data-ub-tech aria-label="{{ section.settings.heading | escape }}">
  <span class="ub-tech__watermark" aria-hidden="true">{{ section.settings.watermark | escape }}</span>

  <div class="ub-shell">
    {%- for block in section.blocks -%}
      {%- assign slide_idx = forloop.index0 -%}
      {%- assign part_asset = block.settings.part_asset | default: 'ubc-part-motor.webp' -%}
      <div
        class="ub-tech__grid{% if forloop.first %} is-active{% endif %}"
        data-ub-slide
        {% unless forloop.first %}hidden{% endunless %}
        {{ block.shopify_attributes }}
      >
        <div>
          <p class="ub-tech__kicker">{{ block.settings.kicker | default: section.settings.kicker | escape }}</p>
          <h2 class="ub-tech__title">{{ block.settings.title | default: section.settings.heading | escape }}</h2>
          <p class="ub-tech__desc">{{ block.settings.description | escape }}</p>

          <a
            href="{{ block.settings.button_url | default: section.settings.button_url | default: routes.all_products_collection_url }}"
            class="ub-pill-btn"
          >
            <span>{{ section.settings.button_label | escape }}</span>
            <span aria-hidden="true">+</span>
          </a>
        </div>

        <div>
          <div class="ub-tech__visual">
            <button type="button" class="ub-round-arrow" data-ub-prev aria-label="Previous component">
              &lsaquo;
            </button>

            <div class="ub-tech__halo" aria-hidden="true"></div>

            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 760
                | image_tag:
                  class: 'ub-tech__img',
                  width: 760,
                  height: 540,
                  loading: 'lazy',
                  alt: block.settings.title
              }}
            {%- else -%}
              <img
                src="{{ part_asset | asset_url }}"
                class="ub-tech__img"
                width="760"
                height="540"
                loading="lazy"
                alt="{{ block.settings.title | escape }}"
              >
            {%- endif -%}

            <button type="button" class="ub-round-arrow" data-ub-next aria-label="Next component">
              &rsaquo;
            </button>
          </div>

          {%- if section.blocks.size > 1 -%}
            <div class="ub-tech__dots" role="tablist" aria-label="Select component">
              {%- for dot_block in section.blocks -%}
                <button
                  type="button"
                  class="ub-tech__dot"
                  data-ub-go="{{ forloop.index0 }}"
                  {% if forloop.index0 == slide_idx %}aria-current="true"{% endif %}
                  aria-label="{{ dot_block.settings.title | escape }}"
                ></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "UBC Parts & Tech Circle",
  "tag": "section",
  "class": "section-ubc-parts-tech",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "watermark",
      "label": "Background watermark",
      "default": "COMPONENTS"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Default kicker",
      "default": "Genuine Parts & Drivetrain Lab"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Default heading",
      "default": "SPARE PARTS FOR YOUR BIKE"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SEE MORE"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "component",
      "name": "Component slide",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Slide kicker",
          "default": "Genuine Parts & Drivetrain Lab"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Component heading",
          "default": "SPARE PARTS FOR YOUR BIKE"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Component story",
          "default": "Direct real-time catalog integration with QBP, J&B Importers, and Specialized USA. Stocked in our Tampa bay or ordered on demand in 3–5 business days without inflated markups."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom component cutout (optional)"
        },
        {
          "type": "text",
          "id": "part_asset",
          "label": "Bundled component asset",
          "default": "ubc-part-motor.webp"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Slide link override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UBC Parts & Tech Circle",
      "blocks": [
        {
          "type": "component"
        }
      ]
    }
  ]
}
{% endschema %}
