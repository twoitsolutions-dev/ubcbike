                      when 'campus'
                        assign ed_img = 'ubc-pop-campus.jpg'
                        assign ed_badge = 'USF Campus'
                        assign ed_badge_es = 'Campus USF'
                        assign ed_title = '10% Student & Staff Discount Every Day'
                        assign ed_title_es = '10% Descuento Diario Estudiantes USF'
                        assign ed_desc = 'Show your valid student or faculty ID in-store for everyday savings across bikes, locks & gear.'
                        assign ed_desc_es = 'Presenta tu ID de estudiante o profesor en tienda para ahorrar en bicis, candados y equipo.'
                        assign ed_cta = 'Shop Campus Bikes'
                        assign ed_cta_es = 'Ver Bicis Urbanas'
                        assign ed_url = hybrid_href
                      when 'veterans'
                        assign ed_img = 'ubc-pop-veterans.jpg'
                        assign ed_badge = 'Veterans & Police'
                        assign ed_badge_es = 'Veteranos y Policía'
                        assign ed_title = '10% Everyday Military & First Responder Discount'
                        assign ed_title_es = '10% Descuento Diario Militares y Policía'
                        assign ed_desc = 'Our family honors active military, veterans & law enforcement with everyday in-store savings.'
                        assign ed_desc_es = 'Honramos a militares activos, veteranos y policías con descuento permanente en tienda.'
                        assign ed_cta = 'Browse Store Catalog'
                        assign ed_cta_es = 'Ver Catálogo'
                    endcase
                  -%}
                  <a class="mega-promo" href="{{ ed_url }}">
                    <div class="mega-promo-media">
                      <img src="{{ ed_img | asset_url }}" width="290" height="140" alt="{{ ed_title | escape }}" loading="lazy">
                      <span class="mega-promo-badge" data-es="{{ ed_badge_es | escape }}">{{ ed_badge | escape }}</span>
                    </div>
                    <div class="mega-promo-body">
                      <strong data-es="{{ ed_title_es | escape }}">{{ ed_title | escape }}</strong>
                      <p data-es="{{ ed_desc_es | escape }}">{{ ed_desc | escape }}</p>
                      <span class="mega-promo-cta">
                        <span data-es="{{ ed_cta_es | escape }}">{{ ed_cta | escape }}</span>
                        <svg aria-hidden="true"><use href="#i-arrow"/></svg>
                      </span>
                    </div>
                  </a>
                {%- else -%}
                <div>
                  <h4 data-es="Bicicletas y Eléctricas">Bikes &amp; Electric</h4>
                  <ul>
                    <li><a href="{{ ebike_href }}" data-es="Bicicletas Eléctricas">Electric Bikes</a></li>
                    <li><a href="{{ road_href }}" data-es="Bicis de Ruta y Gravel">Road &amp; Gravel Bikes</a></li>
                    <li><a href="{{ mtb_href }}" data-es="Bicis de Montaña">Mountain Bikes</a></li>
                    <li><a href="{{ hybrid_href }}" data-es="Híbridas y Confort">Hybrid &amp; Comfort Bikes</a></li>
                    <li><a href="{% if collections['kids-bikes'] != blank %}{{ collections['kids-bikes'].url }}{% else %}{{ all_bikes_href }}{% endif %}" data-es="Bicis para Niños y BMX">Kids &amp; BMX Bikes</a></li>
                    <li><a href="{{ all_bikes_href }}" data-es="Todas las Bicis">All Bikes</a></li>
                  </ul>
                </div>
                <div>
                  <h4 data-es="Componentes y Llantas">Components &amp; Tires</h4>
                  <ul>
                    <li><a href="{% if collections['tires-tubes'] != blank %}{{ collections['tires-tubes'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Llantas y Tubos">Tires &amp; Tubes</a></li>
                    <li><a href="{% if collections['tubes'] != blank %}{{ collections['tubes'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Cámaras">Inner Tubes</a></li>
                    <li><a href="{% if collections['parts-components'] != blank %}{{ collections['parts-components'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Piezas y Transmisión">Parts &amp; Drivetrain</a></li>
                    <li><a href="{% if collections['saddles'] != blank %}{{ collections['saddles'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Sillines">Saddles</a></li>
                    <li><a href="{% if collections['pedals'] != blank %}{{ collections['pedals'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Pedales y Calas">Pedals &amp; Cleats</a></li>
                    <li><a href="{% if collections['tools-workshop'] != blank %}{{ collections['tools-workshop'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Herramientas y Bombas">Tools &amp; Bike Care</a></li>
                  </ul>
                </div>
                <div>
                  <h4 data-es="Accesorios y Ropa">Helmets, Gear &amp; Apparel</h4>
                  <ul>
                    <li><a href="{% if collections['helmets'] != blank %}{{ collections['helmets'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Cascos y Seguridad">Helmets &amp; Safety</a></li>
                    <li><a href="{% if collections['lights-locks'] != blank %}{{ collections['lights-locks'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Luces, Bolsas y Candados">Lights, Bags &amp; Locks</a></li>
                    <li><a href="{% if collections['hydration-nutrition'] != blank %}{{ collections['hydration-nutrition'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Hidratación y Botellas">Hydration &amp; Bottles</a></li>
                    <li><a href="{% if collections['nutrition'] != blank %}{{ collections['nutrition'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Nutrición">Nutrition</a></li>
                    <li><a href="{% if collections['accessories-gear'] != blank %}{{ collections['accessories-gear'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Todos los Accesorios">All Accessories</a></li>
                    <li><a href="{% if collections['clothing'] != blank %}{{ collections['clothing'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Ropa Ciclista">Apparel</a></li>
                    <li><a href="{% if collections['cycling-shoes'] != blank %}{{ collections['cycling-shoes'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Zapatillas de Ciclismo">Cycling Shoes</a></li>
                  </ul>
                </div>
                <a class="mega-card" href="{{ routes.all_products_collection_url }}">
                  <div class="mega-card-media">
                    <img src="{{ 'spz-propero-4.png' | asset_url }}" width="180" height="140" alt="UBC In-Stock Catalog" loading="lazy">
                  </div>
                  <div class="mega-card-body">
                    <span class="mega-kicker" data-es="Catálogo Completo">Browse Full Catalog</span>
                    <strong data-es="Explora bicis, cascos, llantas y repuestos disponibles hoy en Tampa y Alafia.">Browse 1,350+ in-stock bikes, helmets, tires, parts &amp; gear ready today in Tampa &amp; Alafia.</strong>
                    <span class="mega-cta"><span data-es="Ver todo el catálogo">Browse All Items</span> <svg aria-hidden="true"><use href="#i-arrow"/></svg></span>
                  </div>
                </a>
                {%- endif -%}
              </div>
            </div>
          </li>
          <li>
            <a class="nav-accent" href="{% if collections['black-friday-deals'] != blank %}{{ collections['black-friday-deals'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">
              <i aria-hidden="true"></i>
              {%- if edition == 'black_friday' -%}
                <span data-es="Black Friday">Black Friday</span>
              {%- elsif edition == 'christmas' -%}
                <span data-es="Navidad">Holiday Deals</span>
              {%- elsif edition == 'july_4' -%}
                <span data-es="4 de Julio">July 4th Deals</span>
              {%- else -%}
                <span data-es="Ofertas">Deals</span>
              {%- endif -%}
            </a>
          </li>
          <li><a href="/pages/bike-service-repair" data-es="Taller">Service</a></li>
          <li><a href="/pages/bike-rentals" data-es="Rentas">Rentals</a></li>
          <li><a href="/pages/maps-trails" data-es="Mapas">Maps &amp; Trails</a></li>
          <li><a href="/pages/buyers-guide" data-es="Guía">Buyer's Guide</a></li>
          <li><a href="/pages/financing" data-es="Crédito">Financing</a></li>
          <li><a href="/pages/about-us" data-es="Nosotros">About UBC</a></li>
          <li><a href="/pages/locations" data-es="Sedes">Locations</a></li>
          <li><a href="/pages/contact-us" data-es="Contacto">Contact</a></li>
        {%- endif -%}
      </ul>

      <div class="fb-header-tools">
        <button class="fb-icon-btn" id="fbSearchBtn" type="button" aria-label="{{ 'general.search.search' | t }}" aria-expanded="false">
          <svg aria-hidden="true"><use href="#i-search"/></svg>
        </button>
        <a class="fb-icon-btn hide-m" href="{{ routes.account_url | default: routes.root_url }}" aria-label="{{ 'customer.account.title' | t }}">
          <svg aria-hidden="true"><use href="#i-user"/></svg>
        </a>
        <a
          class="fb-icon-btn fb-cart-btn"
          id="fable-cart-icon-trigger"
          href="{{ routes.cart_url }}"
          data-fable-cart-trigger
          role="button"
          aria-haspopup="dialog"
          aria-label="{{ 'templates.cart.cart' | t }}"
        >
          <svg aria-hidden="true"><use href="#i-bag"/></svg>
          <span class="fb-cart-badge" id="fable-cart-count" {% if cart == empty %}hidden{% endif %}>{{ cart.item_count }}</span>
        </a>
        <button class="fb-icon-btn fb-burger" id="fbBurger" type="button" aria-label="{{ 'sections.header.menu' | t }}" aria-expanded="false">
          <svg aria-hidden="true"><use href="#i-menu"/></svg>
        </button>
      </div>
    </div>

    <div class="fb-search-pop" id="fbSearchPop">
      <div class="fb-wrap">
        <form action="{{ routes.search_url }}" method="get" role="search">
          <label class="sr-only" for="fbQ">{{ 'general.search.search' | t }}</label>
          <input
            id="fbQ"
            name="q"
            type="search"
            enterkeyhint="search"
            maxlength="150"
            placeholder="Search by product, SKU, UPC barcode, or part # (e.g. Turbo Vado, 210000053951, 888818339389…)"
            data-es-placeholder="Buscar por nombre, SKU, código UPC o # de parte (ej. Turbo Vado, 210000053951…)"
            autocomplete="off"
          >
          <button class="fb-btn coral" type="submit"><span data-es="Buscar">{{ 'general.search.search' | t }}</span></button>
        </form>
        <div class="fb-search-live" id="fbSearchLive" hidden aria-live="polite"></div>
        <div class="fb-search-tags">
          <span data-es="Populares:">Popular:</span>
          <a href="{{ home_anchor }}#new-arrivals" data-na-jump="deals" data-es="Promociones">Active Promos</a>
          <a href="{{ routes.search_url }}?q=Helmet" data-es="Cascos MIPS">MIPS Helmets</a>
          <a href="{{ home_anchor }}#new-arrivals" data-na-jump="nutrition" data-es="Hidratación Skratch">Skratch Hydration</a>
          <a href="{{ home_anchor }}#service" data-es="Taller y Tune-Up">Walk-In Tune-Ups</a>
          <a href="{{ routes.search_url }}?q=Turbo">Specialized Turbo</a>
        </div>
      </div>
    </div>
  </header>

  <div class="fb-drawer on-dark" id="fbDrawer" aria-hidden="true">
    <div class="fb-drawer-top">
      <img src="{{ 'fable-logo-white.png' | asset_url }}" width="144" height="30" alt="{{ shop.name | escape }}">
      <div class="fb-drawer-top-actions">
        {%- if section.settings.enable_bilingual_toggle -%}
          {%- if localization.available_languages.size > 1 -%}
            <nav class="fb-lang fb-lang--drawer fb-lang--native" aria-label="{{ 'localization.language_label' | t }}">
              {%- for lang_opt in localization.available_languages -%}
                {%- assign code_short = lang_opt.iso_code | slice: 0, 2 | upcase -%}
                <a
                  href="{{ lang_opt.root_url }}"
                  lang="{{ lang_opt.iso_code }}"
                  hreflang="{{ lang_opt.iso_code }}"
                  {% if lang_opt.iso_code == localization.language.iso_code %}aria-current="true"{% endif %}
                >{{ code_short }}</a>
              {%- endfor -%}
            </nav>
          {%- else -%}
            <div class="fb-lang fb-lang--drawer" role="group" aria-label="Language">
              <button type="button" data-lang="en" aria-pressed="{% if request.locale.iso_code == 'es' %}false{% else %}true{% endif %}">EN</button>
              <button type="button" data-lang="es" aria-pressed="{% if request.locale.iso_code == 'es' %}true{% else %}false{% endif %}">ES</button>
            </div>
          {%- endif -%}
        {%- endif -%}
        <button class="fb-icon-btn fb-drawer-close" id="fbDrawerClose" type="button" aria-label="{{ 'accessibility.close' | t }}">
          <svg aria-hidden="true"><use href="#i-x"/></svg>
        </button>
      </div>
    </div>

    <div class="fb-drawer-catalog-top">
      <a class="fb-btn coral fb-drawer-browse-btn" href="{{ routes.all_products_collection_url }}">
        <svg aria-hidden="true"><use href="#i-bag"/></svg>
        <span data-es="Ver Todo el Catálogo">Browse Full Catalog</span>
      </a>
      <div class="fb-drawer-store-pills">
        <a href="/collections/in-stock-tampa" data-es="En Stock Tampa">Tampa Showroom</a>
        <a href="/collections/in-stock-alafia" data-es="En Stock Alafia">Alafia Park</a>
      </div>
      <details class="fb-drawer-cats" open>
        <summary>
          <span data-es="Comprar por Categoría">Shop by Category</span>
          <svg aria-hidden="true"><use href="#i-chev"/></svg>
        </summary>
        <div class="fb-drawer-cats-grid">
          <a href="{{ ebike_href }}" data-es="Bicis Eléctricas">Electric Bikes</a>
          <a href="{{ road_href }}" data-es="Ruta y Gravel">Road &amp; Gravel</a>
          <a href="{{ mtb_href }}" data-es="Bicis de Montaña">Mountain Bikes</a>
          <a href="{{ hybrid_href }}" data-es="Híbridas y Confort">Hybrid &amp; Comfort</a>
          <a href="{% if collections['kids-bikes'] != blank %}{{ collections['kids-bikes'].url }}{% else %}{{ all_bikes_href }}{% endif %}" data-es="Niños y BMX">Kids &amp; BMX</a>
          <a href="{{ all_bikes_href }}" data-es="Todas las Bicis">All Bikes</a>
          <a href="{% if collections['helmets'] != blank %}{{ collections['helmets'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Cascos y Seguridad">Helmets &amp; Safety</a>
          <a href="{% if collections['tires-tubes'] != blank %}{{ collections['tires-tubes'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Llantas y Tubos">Tires &amp; Tubes</a>
          <a href="{% if collections['parts-components'] != blank %}{{ collections['parts-components'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Piezas y Transmisión">Parts &amp; Drivetrain</a>
          <a href="{% if collections['lights-locks'] != blank %}{{ collections['lights-locks'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Luces y Candados">Lights &amp; Locks</a>
          <a href="{% if collections['accessories-gear'] != blank %}{{ collections['accessories-gear'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Accesorios">Accessories</a>
          <a href="{% if collections['clothing'] != blank %}{{ collections['clothing'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Ropa y Zapatillas">Apparel &amp; Shoes</a>
          <a href="{% if collections['hydration-nutrition'] != blank %}{{ collections['hydration-nutrition'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Hidratación">Hydration &amp; Fuel</a>
          <a href="{% if collections['tools-workshop'] != blank %}{{ collections['tools-workshop'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Herramientas">Tools &amp; Bike Care</a>
        </div>
      </details>
    </div>

    <nav aria-label="Mobile navigation">
      {%- if drawer_menu != blank and drawer_menu.links.size > 3 -%}
        {%- for link in drawer_menu.links -%}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
            <span>{{ link.title | escape }}</span>
            <svg aria-hidden="true" width="16" height="16"><use href="#i-arrow"/></svg>
          </a>
          {%- if link.links != blank -%}
            {%- for childlink in link.links -%}
              <a class="fb-drawer-sublink" href="{{ childlink.url }}"{% if childlink.current %} aria-current="page"{% endif %}>
                <span>&mdash; {{ childlink.title | escape }}</span>
              </a>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <a href="{% if collections['black-friday-deals'] != blank %}{{ collections['black-friday-deals'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">
          {%- if edition == 'black_friday' -%}
            <span data-es="Ofertas Black Friday">Black Friday</span><span>Deals</span>
          {%- elsif edition == 'christmas' -%}
            <span data-es="Ofertas Navidad">Holiday Deals</span><span>Dec 25</span>
          {%- elsif edition == 'july_4' -%}
            <span data-es="Ofertas 4 de Julio">July 4th Deals</span><span>Summer</span>
          {%- else -%}
            <span data-es="Ofertas">Deals</span><span data-es="Promos">Sale</span>
          {%- endif -%}
        </a>
        <a href="/pages/bike-service-repair"><span data-es="Taller">Service</span><span data-es="Sin Cita">Walk-In</span></a>
        <a href="/pages/bike-rentals"><span data-es="Rentas">Rentals</span><span>Alafia Park</span></a>
        <a href="/pages/maps-trails"><span data-es="Mapas y Senderos">Maps &amp; Trails</span><span>Trails</span></a>
        <a href="/pages/buyers-guide"><span data-es="Guía de Compra">Buyer's Guide</span><span>Sizing</span></a>
        <a href="/pages/financing"><span data-es="Crédito">Financing</span><span>0% APR</span></a>
        <a href="/pages/about-us"><span data-es="Nosotros">About UBC</span><span>Since 1972</span></a>
        <a href="/pages/locations"><span data-es="Sedes">Locations</span><span>Tampa + Lithia</span></a>
        <a href="/pages/contact-us"><span data-es="Contacto">Contact</span><span>Info</span></a>
      {%- endif -%}
    </nav>

    <div class="fb-drawer-foot">
      <a class="fb-btn outline fb-drawer-call-btn" href="tel:{{ phone_tel }}">
        <svg aria-hidden="true"><use href="#i-phone"/></svg>
        <span>{{ raw_phone | escape }}</span>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "UBC Ecommerce Header",
  "class": "shopify-section-fable-header",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Primary navigation menu (Shopify Navigation)"
    },
    {
      "type": "link_list",
      "id": "mobile_menu",
      "label": "Mobile drawer menu (optional override)"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Showroom phone number",
      "default": "(813) 971-2277"
    },
    {
      "type": "checkbox",
      "id": "enable_bilingual_toggle",
      "label": "Enable EN / ES language switcher",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "UBC Ecommerce Header"
    }
  ]
}
{% endschema %}
