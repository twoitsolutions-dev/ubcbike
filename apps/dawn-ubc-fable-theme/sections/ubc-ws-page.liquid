<style>
  .ubc-ws-prose {
    padding: clamp(2.2rem, 3.5vw, 3.6rem) !important;
    background: #FFFFFF !important;
    border: 1px solid rgba(20, 32, 45, 0.10) !important;
    border-radius: 18px !important;
    color: #14202D;
    font-size: 1.55rem;
    line-height: 1.72;
  }
  .ubc-ws-prose h1, .ubc-ws-prose h2, .ubc-ws-prose h3, .ubc-ws-prose h4 {
    color: #14202D;
    font-weight: 800;
    margin: 2.2rem 0 0.9rem;
    line-height: 1.25;
  }
  .ubc-ws-prose h1:first-child, .ubc-ws-prose h2:first-child, .ubc-ws-prose h3:first-child, .ubc-ws-prose p:first-child {
    margin-top: 0;
  }
  .ubc-ws-prose p {
    margin: 0 0 1.35rem;
    color: #2B3A4A;
  }
  .ubc-ws-prose p strong:first-child {
    color: #14202D;
    font-size: 1.65rem;
  }
  .ubc-ws-prose ul, .ubc-ws-prose ol {
    margin: 0.6rem 0 1.6rem 2rem;
    padding: 0;
  }
  .ubc-ws-prose li {
    margin-bottom: 0.55rem;
    color: #2B3A4A;
  }
  .ubc-ws-prose a {
    color: #E04F33;
    font-weight: 600;
    text-decoration: underline;
  }
</style>
{%- comment -%}
  UBC Workstand-Mirrored Page Layouts (Service, Contact, Locations, About, Reasons, Financing, Buyer's Guide)
  - Preserves 100% of Carlos's Workstand copy, store photos (`images[...]`), tune-up packages, and financing links.
  - Supports bilingual EN/ES translation via `ubc-fable.js`.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .ubc-ws-page {
    background-color: {{ section.settings.page_bg | default: '#FFFFFF' }};
    color: {{ section.settings.text_color | default: '#14202D' }};
    --ubc-page-card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --ubc-page-text: {{ section.settings.text_color | default: '#14202D' }};
    --ubc-page-accent: {{ section.settings.accent_color | default: '#E04F33' }};
    --ubc-page-btn-bg: {{ section.settings.button_bg | default: '#14202D' }};
    --ubc-page-card-radius: {{ section.settings.card_radius | default: 18 }}px;
    --ubc-page-btn-radius: {{ section.settings.button_radius | default: 99 }}px;
  }
  #shopify-section-{{ section.id }} .ubc-ws-card:not(.ubc-ws-card--dark),
  #shopify-section-{{ section.id }} .ubc-ws-prose {
    background: var(--ubc-page-card-bg) !important;
    border-radius: var(--ubc-page-card-radius) !important;
    color: var(--ubc-page-text);
  }
  #shopify-section-{{ section.id }} .ubc-ws-card--dark {
    background: #14202D !important;
    border-color: #14202D !important;
    border-radius: var(--ubc-page-card-radius) !important;
    color: #FFFFFF !important;
  }
  #shopify-section-{{ section.id }} .ubc-ws-card--dark h3 {
    color: #FFFFFF !important;
  }
  #shopify-section-{{ section.id }} .ubc-ws-card--dark .ubc-ws-note {
    color: rgba(255, 255, 255, 0.86) !important;
  }
  #shopify-section-{{ section.id }} .ubc-ws-kicker {
    color: var(--ubc-page-accent);
  }
  #shopify-section-{{ section.id }} .ubc-ws-btn:not(.ubc-ws-btn--ghost):not(.ubc-ws-btn--light) {
    background: var(--ubc-page-btn-bg);
    border-color: var(--ubc-page-btn-bg);
    border-radius: var(--ubc-page-btn-radius);
  }
  #shopify-section-{{ section.id }} .ubc-ws-btn--light {
    background: #FFFFFF !important;
    border-color: #FFFFFF !important;
    color: #14202D !important;
    border-radius: var(--ubc-page-btn-radius);
  }
  #shopify-section-{{ section.id }} .ubc-ws-btn--ghost {
    border-radius: var(--ubc-page-btn-radius);
    color: var(--ubc-page-text);
    border-color: var(--ubc-page-text);
  }
  #shopify-section-{{ section.id }} .ubc-ws-map {
    position: relative;
    z-index: 1;
    isolation: isolate;
  }
</style>
<div class="ubc-ws-page" data-ubc-ws-page="{{ section.settings.page_kind }}">
  {%- case section.settings.page_kind -%}

    {%- when 'service' -%}
      {%- liquid
        assign svc_down = page.content | downcase
        assign show_l1 = true
        assign show_l2 = true
        assign show_oh = true
        if page.content != blank
          unless svc_down contains 'level 1 tune' or svc_down contains '100'
            assign show_l1 = false
          endunless
          unless svc_down contains 'level 2' or svc_down contains '160'
            assign show_l2 = false
          endunless
          unless svc_down contains 'overhaul' or svc_down contains '250'
            assign show_oh = false
          endunless
        endif
        assign svc_cnt = 0
        if show_l1
          assign svc_cnt = svc_cnt | plus: 1
        endif
        if show_l2
          assign svc_cnt = svc_cnt | plus: 1
        endif
        if show_oh
          assign svc_cnt = svc_cnt | plus: 1
        endif
      -%}
      {%- assign hero_img = images['ubc-service-wheel-truing.jpg'] -%}
      <section class="ubc-ws-hero{% unless hero_img %} ubc-ws-hero--text-only{% endunless %}">
        <div>
          <span class="ubc-ws-kicker">1 Day on Most Repairs / No Appointment Needed / Walk-Ins Welcome</span>
          <h1 class="ubc-ws-h1">{{ page.title | default: 'Bike Service & Repair' }}</h1>
          <p class="ubc-ws-lead">Since 1972, we have focused most of our business on servicing our customers as well as their riding experience. Servicing your bike at the right interval will promote quality and longevity of your parts. We have trained technicians to meet or exceed the industry standard and with 13 - 28 years of experience, your bike will be cared for well. Most bicycle repairs will be completed within 24 hours, but walk-ins are always welcome.</p>
          <div class="ubc-ws-actions">
            <a class="ubc-ws-btn" href="tel:+18139712277">Call (813) 971-2277</a>
            <a class="ubc-ws-btn ubc-ws-btn--ghost" href="/pages/locations">How To Find Us</a>
          </div>
        </div>
        {%- if hero_img -%}
          <div class="ubc-ws-hero-media">
            {{ hero_img | image_url: width: 1100 | image_tag: loading: 'eager', alt: 'Bike Service & Repair at University Bicycle Center' }}
          </div>
        {%- endif -%}
      </section>

      {%- assign meta_pkgs = shop.metaobjects.ubc_service_package.values | sort: 'sort_order' -%}
      {%- if meta_pkgs.size > 0 -%}
      <section class="ubc-ws-section">
        <h2 class="ubc-ws-h2">Tune-Up Packages</h2>
        <div class="ubc-ws-grid{% if meta_pkgs.size <= 2 %} ubc-ws-grid--2{% endif %}">
          {%- for pkg in meta_pkgs -%}
            <article class="ubc-ws-card{% if pkg.featured.value %} ubc-ws-card--featured{% endif %}">
              <div>
                {%- if pkg.kicker.value != blank -%}<span class="ubc-ws-kicker">{{ pkg.kicker.value }}</span>{%- endif -%}
                <h3>{{ pkg.name.value }}</h3>
                <div class="ubc-ws-price">{{ pkg.price.value }}</div>
                {%- if pkg.summary.value != blank -%}<p class="ubc-ws-note">{{ pkg.summary.value }}</p>{%- endif -%}
                {%- if pkg.checklist.value != blank -%}
                  {%- assign chk_lines = pkg.checklist.value | newline_to_br | split: '<br />' -%}
                  <ul class="ubc-ws-list">
                    {%- for line in chk_lines -%}
                      {%- assign clean_line = line | strip -%}
                      {%- if clean_line != blank -%}<li>{{ clean_line }}</li>{%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
              <div>
                {%- if pkg.footnote.value != blank -%}<p class="ubc-ws-note">{{ pkg.footnote.value }}</p>{%- endif -%}
                {%- if pkg.cta_label.value != blank -%}
                  <a class="ubc-ws-btn" href="{{ pkg.cta_url.value | default: '/pages/contact-us' }}">{{ pkg.cta_label.value }}</a>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>
      </section>
      {%- elsif svc_cnt > 0 -%}
      <section class="ubc-ws-section">
        <h2 class="ubc-ws-h2">Tune-Up Packages</h2>
        <div class="ubc-ws-grid{% if svc_cnt <= 2 %} ubc-ws-grid--2{% endif %}">
          {%- if show_l1 -%}
          <article class="ubc-ws-card">
            <div>
              <h3>Level 1 Tune-Up</h3>
              <div class="ubc-ws-price">$100.00</div>
              <p class="ubc-ws-note">This service is a refresh of the parts, having clean and lubricated cables make the systems work better.</p>
              <ul class="ubc-ws-list">
                <li>Clean, Lube, and Trim Cables</li>
                <li>Adjust Headset &amp; Bottom Bracket</li>
                <li>Adjust Front and Rear Hubs</li>
                <li>Adjust Front and Rear Derailleurs &amp; Brakes</li>
                <li>True Wheels Laterally</li>
                <li>Oil Chain and Air Tires</li>
                <li>Clean Bike &amp; Safety Inspection</li>
              </ul>
            </div>
            <div>
              <p class="ubc-ws-note">Additional parts not included</p>
              <a class="ubc-ws-btn" href="/pages/contact-us">Book This Tune-Up</a>
            </div>
          </article>
          {%- endif -%}

          {%- if show_l2 -%}
          <article class="ubc-ws-card ubc-ws-card--featured">
            <div>
              <span class="ubc-ws-kicker">Most Popular</span>
              <h3>Level 2 Tune-Up</h3>
              <div class="ubc-ws-price">$160.00</div>
              <p class="ubc-ws-note">Choose this package if your drivetrain is dirty or if you need your wheels trued.</p>
              <ul class="ubc-ws-list">
                <li>Everything in Level 1 Tune-Up</li>
                <li>Full removal and detail cleaning of drive components</li>
                <li>Full Wheel True</li>
                <li>Safety Inspection</li>
              </ul>
            </div>
            <div>
              <p class="ubc-ws-note">Additional parts not included</p>
              <a class="ubc-ws-btn" href="/pages/contact-us">Book This Tune-Up</a>
            </div>
          </article>
          {%- endif -%}

          {%- if show_oh -%}
          <article class="ubc-ws-card">
            <div>
              <h3>Level 1 Overhaul</h3>
              <div class="ubc-ws-price">$250.00</div>
              <p class="ubc-ws-note">This service is extensive and is vital for the longevity of the parts.</p>
              <ul class="ubc-ws-list">
                <li>Clean, Lube, and Trim Cables</li>
                <li>Overhaul, Clean, and Grease Headset, Bottom Bracket &amp; Hub Bearings</li>
                <li>Full removal and detail cleaning of drive components</li>
                <li>Adjust Derailleurs &amp; Brakes</li>
                <li>Full Wheel True, Clean Bike &amp; Safety Inspection</li>
              </ul>
            </div>
            <div>
              <p class="ubc-ws-note">Additional parts not included</p>
              <a class="ubc-ws-btn" href="/pages/contact-us">Book This Tune-Up</a>
            </div>
          </article>
          {%- endif -%}
        </div>
      </section>
      {%- endif -%}

      <section class="ubc-ws-section">
        <h2 class="ubc-ws-h2">Maintenance Service</h2>
        <p class="ubc-ws-lead">Servicing your bike is very important for your safety and the longevity of the parts. Below is a common checklist and maintenance schedule.</p>
        <div class="ubc-ws-grid">
          <div class="ubc-ws-card">
            <h3>300-500 Miles or Every 2-3 Months</h3>
            <ul class="ubc-ws-list">
              <li>Clean the bike and inspect for cracks</li>
              <li>Clean chain, cassette cogs, chainrings, and derailleurs</li>
              <li>Check spoke tension</li>
              <li>Check crank, pedal, stem, handlebar &amp; seat bolts</li>
              <li>Lube pivot points with dry spray lube (keep off brake pads/rotors)</li>
              <li>Check cleats, pedals &amp; suspension lockout/rebound</li>
            </ul>
          </div>
          <div class="ubc-ws-card">
            <h3>1000-2500 Miles or Every 6 Months</h3>
            <ul class="ubc-ws-list">
              <li>Inspect tires for wear, cracks, or embedded debris</li>
              <li>Check headset, bottom bracket, and hubs</li>
              <li>Check brake pads, bar tape &amp; grips for wear</li>
              <li>Check chain, cassette, and chainrings for stretch/wear</li>
              <li>Deep clean drivetrain &amp; inspect suspension</li>
            </ul>
          </div>
          <div class="ubc-ws-card">
            <h3>2500-5000 Miles or Every Year</h3>
            <ul class="ubc-ws-list">
              <li>Replace grease in headset, bottom bracket, and hubs</li>
              <li>Inspect/replace cables and housings</li>
              <li>Replace brake pads and bleed disc brakes</li>
              <li>Inspect wheels, braking surfaces &amp; pedal bearings</li>
              <li>Full drivetrain clean &amp; safety overhaul</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="ubc-ws-hero ubc-ws-hero--text-only">
        <div>
          <h2 class="ubc-ws-h2">Schedule Your Bike Repair Now</h2>
          <p class="ubc-ws-lead">Bring your bike to our Tampa showroom or our Alafia River State Park shop — walk-ins are always welcome and most repairs are completed within 24 hours.</p>
          <div class="ubc-ws-actions">
            <a class="ubc-ws-btn" href="/pages/contact-us">Contact Us</a>
            <a class="ubc-ws-btn ubc-ws-btn--ghost" href="/pages/locations">How To Find Us</a>
          </div>
        </div>
      </section>

    {%- when 'locations' -%}
      {%- liquid
        assign loc_down = page.content | downcase
        assign show_tampa = true
        assign show_alafia = true
        if page.content != blank
          unless loc_down contains 'tampa' or loc_down contains 'fletcher'
            assign show_tampa = false
          endunless
          unless loc_down contains 'alafia' or loc_down contains 'lithia'
            assign show_alafia = false
          endunless
        endif
      -%}
      <section class="ubc-ws-hero ubc-ws-hero--text-only ubc-ws-hero--compact">
        <div>
          <span class="ubc-ws-kicker" data-es="Tampa y Lithia, Florida">Tampa &amp; Lithia, Florida</span>
          <h1 class="ubc-ws-h1" data-es="Cómo Encontrarnos">{{ page.title | default: 'How To Find Us' }}</h1>
          <p class="ubc-ws-lead" data-es="Visita cualquiera de nuestras dos tiendas en Tampa Bay para bicis nuevas, taller profesional, rentas y asesoría local de senderos.">Visit either of our two Tampa Bay locations for new bikes, professional walk-in repairs, trailhead rentals, and expert local riding advice.</p>
          <div class="ubc-ws-pills">
            <span class="ubc-ws-pill" data-es="2 Tiendas en Tampa Bay">2 Tampa Bay Locations</span>
            <span class="ubc-ws-pill" data-es="Taller Sin Cita · Tampa">Walk-In Workshop · Tampa</span>
            <span class="ubc-ws-pill" data-es="Rentas en Senderos · Alafia">Trailhead Rentals · Alafia</span>
          </div>
        </div>
      </section>

      {%- assign meta_locs = shop.metaobjects.ubc_store_location.values | sort: 'sort_order' -%}
      {%- if meta_locs.size > 0 -%}
      <section class="ubc-ws-section">
        <div class="ubc-ws-grid ubc-ws-grid--2">
          {%- for loc in meta_locs -%}
            {%- assign map_q = loc.address.value | url_encode -%}
            {%- assign tel_clean = loc.phone.value | remove: '(' | remove: ')' | remove: '-' | remove: ' ' | remove: '.' -%}
            <article class="ubc-ws-card ubc-ws-card--location">
              <div class="ubc-ws-loc-body">
                <div class="ubc-ws-loc-top">
                  {%- if loc.kicker.value != blank -%}<span class="ubc-ws-kicker">{{ loc.kicker.value }}</span>{%- endif -%}
                  {%- if loc.badge.value != blank -%}<span class="ubc-ws-badge">{{ loc.badge.value }}</span>{%- endif -%}
                </div>
                <h2 class="ubc-ws-h2">{{ loc.name.value }}</h2>
                <p class="ubc-ws-address">
                  {{ loc.address.value }}<br>
                  {%- if loc.phone.value != blank -%}<a href="tel:+1{{ tel_clean }}">{{ loc.phone.value }}</a>{%- endif -%}
                  {%- if loc.phone.value != blank and loc.email.value != blank -%}<span class="ubc-ws-sep" aria-hidden="true" style="margin:0 0.55rem;opacity:0.45;">&middot;</span>{%- endif -%}
                  {%- if loc.email.value != blank -%}<a href="mailto:{{ loc.email.value }}">{{ loc.email.value }}</a>{%- endif -%}
                </p>
                <div class="ubc-ws-map">
                  <iframe
                    title="{{ loc.name.value | escape }} Map"
                    src="https://maps.google.com/maps?q={{ map_q }}&t=&z=14&ie=UTF8&iwloc=&output=embed"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen></iframe>
                </div>
                {%- if loc.hours.value != blank -%}
                  {%- assign hr_lines = loc.hours.value | newline_to_br | split: '<br />' -%}
                  <div class="ubc-ws-hours">
                    {%- for hl in hr_lines -%}
                      {%- assign clean_hl = hl | strip -%}
                      {%- if clean_hl != blank -%}
                        {%- assign parts = clean_hl | split: '|' -%}
                        <div class="ubc-ws-hours-row"><span>{{ parts[0] | strip }}</span><strong>{{ parts[1] | strip }}</strong></div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                {%- if loc.highlights.value != blank -%}
                  {%- assign hi_lines = loc.highlights.value | newline_to_br | split: '<br />' -%}
                  <ul class="ubc-ws-list">
                    {%- for hi in hi_lines -%}
                      {%- assign clean_hi = hi | strip -%}
                      {%- if clean_hi != blank -%}<li>{{ clean_hi }}</li>{%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
              <div class="ubc-ws-actions">
                {%- if loc.maps_url.value != blank -%}
                  <a class="ubc-ws-btn" href="{{ loc.maps_url.value }}" target="_blank" rel="noopener">Get Directions</a>
                {%- endif -%}
                {%- if loc.stock_url.value != blank -%}
                  <a class="ubc-ws-btn ubc-ws-btn--ghost" href="{{ loc.stock_url.value }}">{{ loc.stock_label.value | default: 'Shop In-Store Stock' }}</a>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>
      </section>
      {%- else -%}
      <section class="ubc-ws-section">
        <div class="ubc-ws-grid ubc-ws-grid--2">
          {%- if show_tampa -%}
          <article class="ubc-ws-card ubc-ws-card--location">
            <div class="ubc-ws-loc-body">
              <div class="ubc-ws-loc-top">
                <span class="ubc-ws-kicker" data-es="Tienda Principal y Taller">Main Store &amp; Workshop</span>
                <span class="ubc-ws-badge" data-es="A 5 min de USF">5 min from USF</span>
              </div>
              <h2 class="ubc-ws-h2">University Bicycle Center</h2>
              <p class="ubc-ws-address">
                1220 E Fletcher Ave, Tampa, FL 33612<br>
                <a href="tel:+18139712277">(813) 971-2277</a><span class="ubc-ws-sep" aria-hidden="true" style="margin:0 0.55rem;opacity:0.45;">&middot;</span><a href="mailto:ubc@ubcbike.com">ubc@ubcbike.com</a>
              </p>

              <div class="ubc-ws-map">
                <iframe
                  title="University Bicycle Center Tampa Map"
                  src="https://maps.google.com/maps?q=1220+E+Fletcher+Ave+Tampa+FL+33612&t=&z=14&ie=UTF8&iwloc=&output=embed"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen></iframe>
              </div>

              <div class="ubc-ws-hours">
                <div class="ubc-ws-hours-row"><span data-es="Lunes – Viernes">Mon – Fri</span><strong>10:00am – 6:00pm</strong></div>
                <div class="ubc-ws-hours-row"><span data-es="Sábado">Saturday</span><strong>9:00am – 5:00pm</strong></div>
                <div class="ubc-ws-hours-row"><span data-es="Domingo">Sunday</span><strong data-es="Cerrado">Closed</strong></div>
              </div>

              <ul class="ubc-ws-list">
                <li data-es="Salón completo de bicis, e-bikes, cascos y accesorios">Full showroom of bikes, e-bikes, helmets &amp; gear</li>
                <li data-es="Taller profesional sin cita para todas las marcas">Walk-in repair workshop servicing all brands</li>
              </ul>
            </div>
            <div class="ubc-ws-actions">
              <a class="ubc-ws-btn" href="https://www.google.com/maps/dir/?api=1&destination=1220+E+Fletcher+Ave+Tampa+FL+33612" target="_blank" rel="noopener" data-es="Cómo Llegar">Get Directions</a>
              <a class="ubc-ws-btn ubc-ws-btn--ghost" href="/collections/in-stock-tampa" data-es="Ver Stock Tampa">Shop Tampa Stock</a>
            </div>
          </article>
          {%- endif -%}

          {%- if show_alafia -%}
          <article class="ubc-ws-card ubc-ws-card--location">
            <div class="ubc-ws-loc-body">
              <div class="ubc-ws-loc-top">
                <span class="ubc-ws-kicker" data-es="Rentas / Tienda / Servicio">Bicycle Rental / Store / Services</span>
                <span class="ubc-ws-badge" data-es="Alafia State Park">Alafia State Park</span>
              </div>
              <h2 class="ubc-ws-h2">UBC at Alafia River State Park</h2>
              <p class="ubc-ws-address">
                14326 S County Road 39, Lithia, FL 33547<br>
                <a href="tel:+18134598293">(813) 459-8293</a>
              </p>

              <div class="ubc-ws-map">
                <iframe
                  title="UBC Alafia River State Park Map"
                  src="https://maps.google.com/maps?q=14326+S+County+Road+39+Lithia+FL+33547&t=&z=13&ie=UTF8&iwloc=&output=embed"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen></iframe>
              </div>

              <div class="ubc-ws-hours">
                <div class="ubc-ws-hours-row"><span data-es="Miércoles – Viernes">Wed – Fri</span><strong>10:00am – 5:00pm</strong></div>
                <div class="ubc-ws-hours-row"><span data-es="Sábado – Domingo">Sat – Sun</span><strong>8:00am – 5:00pm</strong></div>
                <div class="ubc-ws-hours-row"><span data-es="Lunes – Martes">Mon – Tue</span><strong data-es="Cerrado (salvo festivos/cita)">Closed (holidays/appt)</strong></div>
              </div>

              <ul class="ubc-ws-list">
                <li data-es="Renta de bicis MTB y e-MTB directo en el sendero">MTB &amp; E-MTB rentals right at the trailhead</li>
                <li data-es="Sujeto al clima del parque estatal">Subject to state park weather &amp; trail conditions</li>
              </ul>
            </div>
            <div class="ubc-ws-actions">
              <a class="ubc-ws-btn" href="https://www.google.com/maps/dir/?api=1&destination=14326+S+County+Road+39+Lithia+FL+33547" target="_blank" rel="noopener" data-es="Cómo Llegar">Get Directions</a>
