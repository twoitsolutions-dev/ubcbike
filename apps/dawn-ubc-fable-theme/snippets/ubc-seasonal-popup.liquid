        desc: 'Protege tu bici en el campus con candados en U, luces USB, parrillas y bolsos — o presenta tu carnet USF en tienda para descuentos.',
        cta: 'Aplicar 15% y Ver Candados y Luces →',
        secLabel: 'Todos los Accesorios',
        secHref: '/collections/accessories-gear'
      }
    },
    veterans: {
      accent: '#B8862D',
      img: {{ img_manny | json }},
      code: 'HONOR15GEAR',
      redirect: '/collections/accessories-gear',
      en: {
        badgeBig: '15% OFF',
        badgeSub: 'Veterans & Police',
        eyebrow: 'Veteran-Founded by Manny · Since 1972',
        title: '15% Off Accessories · Honoring Veterans & Police',
        desc: 'Thank you for your service. Enjoy 15% off accessories, lights, locks, hydration & tools online — or show military/police ID in Tampa.',
        cta: 'Apply 15% & Shop Accessories →',
        secLabel: '',
        secHref: ''
      },
      es: {
        badgeBig: '15% OFF',
        badgeSub: 'Veteranos y Policías',
        eyebrow: 'Fundada por Manny (Veterano) · Desde 1972',
        title: '15% Off en Accesorios · Honor a Veteranos y Policías',
        desc: 'Gracias por tu servicio. Disfruta 15% off en accesorios, luces, candados, hidratación y herramientas online — o muestra tu ID militar/policial en Tampa.',
        cta: 'Aplicar 15% y Ver Accesorios →',
        secLabel: '',
        secHref: ''
      }
    }
  };

  var currentEd = 'classic';

  function getLang() {
    var pressed = document.querySelector('.fb-lang button[aria-pressed="true"]');
    if (pressed) return pressed.getAttribute('data-lang') === 'es' ? 'es' : 'en';
    try {
      if (localStorage.getItem('ubc-lang') === 'es') return 'es';
    } catch (e) {}
    return 'en';
  }

  function detectEdition() {
    try {
      var m = window.location.search.match(/[?&]edition=([a-z0-9_]+)/i);
      if (m && POPUPS[m[1]]) return m[1];
    } catch (e) {}
    if (document.getElementById('bf-deals')) return 'black_friday';
    var attr = document.body ? document.body.getAttribute('data-ubc-edition') : '';
    if (attr && POPUPS[attr]) return attr;
    return 'classic';
  }

  function renderPopup(edKey) {
    var key = POPUPS[edKey] ? edKey : 'classic';
    currentEd = key;
    var cfg = POPUPS[key];
    var lang = getLang();
    var copy = cfg[lang] || cfg.en;

    card.style.setProperty('--ubc-pop-accent', cfg.accent);
    var imgEl = document.getElementById('ubcPopImg');
    if (imgEl && imgEl.getAttribute('src') !== cfg.img) imgEl.setAttribute('src', cfg.img);

    document.getElementById('ubcPopBadgeBig').textContent = copy.badgeBig;
    document.getElementById('ubcPopBadgeSub').textContent = copy.badgeSub;
    document.getElementById('ubcPopEyebrow').textContent = copy.eyebrow;
    document.getElementById('ubcPopTitle').textContent = copy.title;
    document.getElementById('ubcPopDesc').textContent = copy.desc;
    document.getElementById('ubcPopCodeLabel').textContent = lang === 'es' ? 'Código para Accesorios' : 'Accessory Promo Code';
    document.getElementById('ubcPopCodeVal').textContent = cfg.code;
    document.getElementById('ubcPopCopy').textContent = lang === 'es' ? 'Copiar Código' : 'Copy Code';

    var ctaEl = document.getElementById('ubcPopCta');
    ctaEl.textContent = copy.cta;
    ctaEl.setAttribute('href', '/discount/' + encodeURIComponent(cfg.code) + '?redirect=' + encodeURIComponent(cfg.redirect));

    var secEl = document.getElementById('ubcPopSecondary');
    if (copy.secLabel && copy.secHref) {
      secEl.textContent = copy.secLabel;
      secEl.setAttribute('href', copy.secHref);
      secEl.style.display = 'inline';
    } else {
      secEl.style.display = 'none';
    }

    document.getElementById('ubcPopDismiss').textContent = lang === 'es'
      ? 'No gracias, seguir viendo'
      : 'No thanks, continue browsing';

    document.getElementById('ubcPopFine').textContent = lang === 'es'
      ? 'Aplica solo en Accesorios, Luces, Candados, Hidratación y Herramientas. No aplica a bicicletas, e-bikes ni artículos con precio MAP. 1 uso por cliente.'
      : 'Valid on Accessories, Lights, Locks, Hydration & Tools only. Excludes bikes, e-bikes & MAP-protected items. Limit 1 use per customer.';
  }

  function markSeen(edKey) {
    try {
      localStorage.setItem('ubc_popup_seen_' + edKey, String(Date.now()));
    } catch (e) {}
  }

  function wasSeenRecently(edKey) {
    try {
      var ts = Number(localStorage.getItem('ubc_popup_seen_' + edKey) || '0');
      if (!ts) return false;
      var sevenDays = 7 * 24 * 60 * 60 * 1000;
      return (Date.now() - ts) < sevenDays;
    } catch (e) {
      return false;
    }
  }

  function openPopup(edKey) {
    renderPopup(edKey || detectEdition());
    backdrop.classList.add('is-open');
    backdrop.setAttribute('aria-hidden', 'false');
    if (document.body) document.body.style.overflow = 'hidden';
  }

  function closePopup() {
    backdrop.classList.remove('is-open');
    backdrop.setAttribute('aria-hidden', 'true');
    if (document.body) document.body.style.overflow = '';
    markSeen(currentEd);
  }

  document.getElementById('ubcPopClose').addEventListener('click', closePopup);
  document.getElementById('ubcPopDismiss').addEventListener('click', closePopup);
  document.getElementById('ubcPopCta').addEventListener('click', function () {
    markSeen(currentEd);
  });
  backdrop.addEventListener('click', function (e) {
    if (e.target === backdrop) closePopup();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && backdrop.classList.contains('is-open')) closePopup();
  });

  var copyBtn = document.getElementById('ubcPopCopy');
  copyBtn.addEventListener('click', function () {
    var code = document.getElementById('ubcPopCodeVal').textContent;
    var isEs = getLang() === 'es';
    function done() {
      copyBtn.textContent = isEs ? '¡Copiado! ✓' : 'Copied! ✓';
      setTimeout(function () {
        copyBtn.textContent = isEs ? 'Copiar Código' : 'Copy Code';
      }, 2000);
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(code).then(done).catch(done);
    } else {
      try {
        var ta = document.createElement('textarea');
        ta.value = code;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      } catch (e) {}
      done();
    }
  });

  Array.prototype.forEach.call(document.querySelectorAll('.fb-lang button'), function (btn) {
    btn.addEventListener('click', function () {
      setTimeout(function () {
        if (backdrop.classList.contains('is-open')) renderPopup(currentEd);
      }, 40);
    });
  });

  window.ubcOpenPopup = openPopup;

  var path = window.location.pathname || '';
  if (path.indexOf('/cart') === 0 || path.indexOf('/checkouts') === 0) return;

  var forcePopup = /[?&]popup=1\b/i.test(window.location.search || '');
  var ed = detectEdition();
  if (forcePopup) {
    setTimeout(function () { openPopup(ed); }, 450);
  } else if (!wasSeenRecently(ed)) {
    setTimeout(function () {
      if (!wasSeenRecently(ed)) openPopup(ed);
    }, 4500);
  }
})();
</script>
