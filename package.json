{
  "name": "ubc-commerce-hub",
  "private": true,
  "version": "0.1.0",
  "description": "UBC Commerce Hub — TwoIT Solutions LLC",
  "type": "module",
  "main": "apps/api/dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/api"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env apps/api/dist/server.js",
    "hostinger:token": "node scripts/save-hostinger-token.mjs",
    "pack:hostinger-node": "npm run build && node scripts/pack-hostinger-node.mjs",
    "build": "tsc -b packages/shared packages/business-rules packages/demo-data packages/integrations packages/database apps/api && node scripts/build-admin.mjs",
    "typecheck": "tsc -b packages/shared packages/business-rules packages/demo-data packages/integrations packages/database apps/api",
    "db:check": "node --env-file-if-exists=.env scripts/db-check.mjs",
    "db:migrate": "node --env-file-if-exists=.env packages/database/dist/migrate.js",
    "db:seed": "node --env-file-if-exists=.env packages/database/dist/seed.js",
    "shopify:check": "node --env-file-if-exists=.env scripts/shopify-check.mjs",
    "shopify:webhooks": "node --env-file-if-exists=.env scripts/shopify-register-webhooks.mjs",
    "hub:password": "node --env-file-if-exists=.env scripts/set-hub-password.mjs",
    "lightspeed:connect": "node --env-file-if-exists=.env scripts/connect-lightspeed.mjs",
    "theme:check:fable": "node scripts/theme-check-fable.mjs",
    "dev": "node --env-file-if-exists=.env apps/api/dist/server.js",
    "worker": "node --env-file-if-exists=.env apps/api/dist/worker.js",
    "test": "vitest run",
    "test:unit": "vitest run packages/",
    "test:e2e": "npm run build:static-demo && node tests/e2e/run.mjs",
    "lint:admin": "eslint apps/admin/js",
    "build:static-demo": "npm run build && node scripts/build-static-demo.mjs",
    "test:e2e:api": "npm run build && node tests/e2e/api-smoke.mjs",
    "lint": "eslint apps/admin/js",
    "db:reset-demo": "node scripts/reset-demo-db.mjs",
    "theme:check": "node scripts/theme-check-fable.mjs",
    "upc:link": "node --env-file-if-exists=.env scripts/link-shopify-store.mjs",
    "upc:audit": "node --env-file-if-exists=.env scripts/audit-matrices-upc.mjs"
  },
  "devDependencies": {
    "@shopify/cli": "^5.0.1",
    "@shopify/theme-check-node": "^4.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.1.0",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
