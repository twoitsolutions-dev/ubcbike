            "*Excepto feriados o con cita agendada. Sujeto al clima en el sendero."
          ]
        }
      ]
    </script>
  </section>
</div>

{% schema %}
{
  "name": "UBC Store Locator",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Visit Us · Tampa & Lithia"
    },
    {
      "type": "text",
      "id": "google_maps_api_key",
      "label": "Google Maps JS API Key (optional)",
      "info": "Leave blank to use instant Google Maps mode with zero setup. Paste a Google Maps JavaScript API key to activate the live vector map with dual custom pins and Places address search."
    },
    {
      "type": "checkbox",
      "id": "enable_near_me",
      "label": "Enable Near Me & distance calculator on /pages/locations",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_page_link",
      "label": "Show link to /pages/locations",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "is_standalone_page",
      "label": "Standalone /pages/locations header",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "UBC Store Locator"
    }
  ]
}
{% endschema %}
