{%- comment -%}
  UBC Commerce Hub — Shopify Dawn Collection Card Availability Pill
  ==================================================================
  Drop into Dawn's `snippets/card-product.liquid` inside `.card__information`:
    {% render 'ubc-dawn-card-badge', card_product: card_product %}
{%- endcomment -%}
{%- if card_product and card_product != empty -%}
  {%- liquid
    assign v = card_product.selected_or_first_available_variant
    assign status = v.metafields.ubc.availability.value
    if status == blank
      if v.available and v.inventory_quantity > 0
        assign status = 'in_stock'
      elsif v.available
        assign status = 'special_order'
      else
        assign status = 'unavailable'
      endif
    endif
    assign pickup_only = v.metafields.ubc.click_and_collect_only.value
  -%}
  <div class="ubc-card-pills" style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-top:0.5rem;font-size:1.15rem;font-weight:600;">
    {%- if status == 'in_stock' -%}
      <span style="padding:0.2rem 0.7rem;border-radius:99px;background:#dcfce7;color:#166534;">In Stock at UBC</span>
    {%- elsif status == 'special_order' -%}
      <span style="padding:0.2rem 0.7rem;border-radius:99px;background:#ede9fe;color:#5b21b6;">Available to Order</span>
    {%- else -%}
      <span style="padding:0.2rem 0.7rem;border-radius:99px;background:#fee2e2;color:#991b1b;">Sold Out</span>
    {%- endif -%}
    {%- if pickup_only -%}
      <span style="padding:0.2rem 0.7rem;border-radius:99px;background:#fef3c7;color:#92400e;">In-Store Pickup</span>
    {%- endif -%}
  </div>
{%- endif -%}
