{%- comment -%}
  UBC Dawn Ecommerce v23 — Official UBC Ink Footer with Infinite-Resolution Vector SVG `SINCE 1972`
  - `SINCE 1972` monumental wordmark rendered as mathematical Bezier SVG paths in Official UBC Gold (#CCBB8D) stroke ONLY, zero fill.
  - Supports Shopify `link_list` menus per column + dynamic `tel:` phone href + `home_anchor` locale-safe routes.
{%- endcomment -%}
{%- liquid
  assign word_clean = section.settings.giant_word | default: 'SINCE 1972' | strip | upcase
  assign raw_phone = section.settings.phone | default: '(813) 971-2277'
  assign phone_digits = raw_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' | remove: '+'
  if phone_digits.size == 10
    assign phone_tel = '+1' | append: phone_digits
  elsif phone_digits != blank
    assign phone_tel = '+' | append: phone_digits
  else
    assign phone_tel = '+18139712277'
  endif

  assign home_anchor = ''
  if template.name != 'index'
    assign home_anchor = routes.root_url
    unless home_anchor == '/'
      assign home_anchor = home_anchor | append: '/'
    endunless
  endif

  assign story_href = home_anchor | append: '#family'
  if pages['our-story'] != blank
    assign story_href = pages['our-story'].url
  endif

  assign locations_href = home_anchor | append: '#stores'
  if pages['locations'] != blank
    assign locations_href = pages['locations'].url
  endif

  assign all_bikes_href = routes.all_products_collection_url
  if collections['bikes'] != blank
    assign all_bikes_href = collections['bikes'].url
  endif
-%}
<div class="fb-scope">
  <footer class="fb-footer on-dark">
    <div class="fb-wrap">
      <div class="foot-top">
        <div class="foot-brand">
          <img
            src="{{ 'fable-logo-white.png' | asset_url }}"
            width="184"
            height="38"
            alt="{{ shop.name | escape }}"
            loading="lazy"
          >
          <p data-es="Tres generaciones de tradición familiar ciclista en Tampa Bay desde 1972. Bicicletas, E-Bikes, scooters, cascos, nutrición, repuestos, taller sin cita y descuentos permanentes en tienda para Estudiantes, Veteranos y Policías.">
            Three generations of family-owned cycling passion in Tampa Bay since 1972. Bikes, e-bikes, scooters, helmets, nutrition, OEM parts, all-day walk-in repair, and everyday in-store discounts for Students, Veterans &amp; Police.
          </p>
          <div class="social" aria-label="Official social channels">
            <a href="https://www.instagram.com/ubcbike.tampa/" target="_blank" rel="noopener" aria-label="Instagram Tampa (@ubcbike.tampa)" title="Instagram Tampa (@ubcbike.tampa)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="0.8" fill="currentColor"/></svg>
            </a>
            <a href="https://www.instagram.com/ubcbike.alafia/" target="_blank" rel="noopener" aria-label="Instagram Alafia (@ubcbike.alafia)" title="Instagram Alafia (@ubcbike.alafia)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="0.8" fill="currentColor"/></svg>
            </a>
            <a href="https://www.facebook.com/pages/University-Bicycle-Center/100635673341641" target="_blank" rel="noopener" aria-label="Facebook" title="Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21h3z"/></svg>
            </a>
            <a href="https://www.youtube.com/@ubcbike" target="_blank" rel="noopener" aria-label="YouTube" title="YouTube">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.6 8.2a2.5 2.5 0 00-1.8-1.8C18.2 6 12 6 12 6s-6.2 0-7.8.4a2.5 2.5 0 00-1.8 1.8C2 9.8 2 12 2 12s0 2.2.4 3.8a2.5 2.5 0 001.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.5 2.5 0 001.8-1.8c.4-1.6.4-3.8.4-3.8s0-2.2-.4-3.8zM10 14.8V9.2l5 2.8-5 2.8z"/></svg>
            </a>
          </div>
        </div>

        <details class="foot-acc" open>
          <summary><h4 data-es="Tienda y Promos">{{ section.settings.col1_heading | escape }}</h4><svg aria-hidden="true"><use href="#i-chev"/></svg></summary>
          <ul>
            {%- if section.settings.footer_menu_1 != blank and section.settings.footer_menu_1.links.size > 0 -%}
              {%- for link in section.settings.footer_menu_1.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            {%- else -%}
              <li><a href="{{ home_anchor }}#new-arrivals" data-na-jump="deals" data-es="Promos y Combos Activos">Active Promos &amp; Bundles</a></li>
              <li><a href="{{ home_anchor }}#new-arrivals" data-na-jump="helmets" data-es="Cascos MIPS y Luces">Helmets, Lights &amp; Gear</a></li>
              <li><a href="{{ home_anchor }}#new-arrivals" data-na-jump="nutrition" data-es="Hidratación Skratch y GU">Hydration &amp; Nutrition</a></li>
              <li><a href="{{ home_anchor }}#new-arrivals" data-na-jump="parts" data-es="Llantas y Piezas OEM">Parts, Saddles &amp; Tires</a></li>
              <li><a href="{{ all_bikes_href }}" data-es="Bicicletas y E-Bikes">Bikes &amp; E-Bikes</a></li>
            {%- endif -%}
          </ul>
        </details>

        <details class="foot-acc" open>
          <summary><h4 data-es="Taller y Servicios">{{ section.settings.col2_heading | escape }}</h4><svg aria-hidden="true"><use href="#i-chev"/></svg></summary>
          <ul>
            {%- if section.settings.footer_menu_2 != blank and section.settings.footer_menu_2.links.size > 0 -%}
              {%- for link in section.settings.footer_menu_2.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            {%- else -%}
              <li><a href="/pages/bike-service-repair" data-es="Servicio y Reparación">Bike Service &amp; Repair</a></li>
              <li><a href="/pages/buyers-guide" data-es="Guía de Compra y Tallas">Buyer's Guide &amp; Size Chart</a></li>
              <li><a href="/pages/bike-rentals" data-es="Alquiler en Alafia River">Alafia Trail Rentals</a></li>
              <li><a href="/pages/financing" data-es="Financiamiento (Synchrony / Acima / Snap)">Financing Options</a></li>
              <li><a href="/pages/maps-trails" data-es="Mapas y Senderos">Maps &amp; Trails</a></li>
            {%- endif -%}
          </ul>
        </details>

        <details class="foot-acc" open>
          <summary><h4 data-es="Familia y Tiendas">{{ section.settings.col3_heading | escape }}</h4><svg aria-hidden="true"><use href="#i-chev"/></svg></summary>
          <ul>
            {%- if section.settings.footer_menu_3 != blank and section.settings.footer_menu_3.links.size > 0 -%}
              {%- for link in section.settings.footer_menu_3.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            {%- else -%}
              <li><a href="/pages/about-us" data-es="La Diferencia UBC">The UBC Difference</a></li>
              <li><a href="/pages/why-shop-at-ubc" data-es="5 Razones para Comprar en UBC">5 Reasons to Buy at UBC</a></li>
              <li><a href="/pages/locations" data-es="Cómo Llegar (Tampa y Alafia)">How To Find Us</a></li>
              <li><a href="/pages/contact-us" data-es="Contáctanos">Contact Us</a></li>
              <li><a href="tel:{{ phone_tel }}">{{ raw_phone | escape }}</a></li>
            {%- endif -%}
          </ul>
        </details>
      </div>
    </div>

    <div class="foot-word-wrap" aria-hidden="true">
      {%- if word_clean == 'SINCE 1972' -%}
        <svg
          class="foot-word-svg"
          viewBox="-24 -1840 8908 1900"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          role="presentation"
