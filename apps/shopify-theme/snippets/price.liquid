{%- comment -%} Usage: {% render 'price', product: product, variant: variant %} {%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign on_sale = false
  if target.compare_at_price > target.price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}">
  <span class="price-current">{{ target.price | money }}</span>
  <s class="price-compare"{% unless on_sale %} hidden{% endunless %}><span class="visually-hidden">{{ 'products.regular_price' | t }}</span><span data-price-compare>{% if on_sale %}{{ target.compare_at_price | money }}{% endif %}</span></s>
</div>
