{%- comment -%}
  Product page "spin": the product's first Shopify-hosted video (a 360° turntable clip, first frame = last frame =
  front view) becomes a drag-to-rotate stage; idle for 3 s and it turns by itself. Notched info card on the left,
  size + buy card on the right, pins on the product when it faces front, front/back views, fly-to-bag on add.
  Without a video (or without JS) the product photos are shown and every control still works natively.
{%- endcomment -%}
{%- assign v = product.selected_or_first_available_variant -%}
{%- assign spin_video = product.media | where: 'media_type', 'video' | first -%}
{%- assign spin_src = '' -%}
{%- if spin_video -%}
  {%- for source in spin_video.sources -%}
    {%- if source.format == 'mp4' and source.height <= 1080 -%}{%- assign spin_src = source.url -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign images = product.media | where: 'media_type', 'image' -%}
{%- assign added_label = 'ubc.products.added' | t -%}
<section class="spin" style="--spin-bg: {{ section.settings.background }};" data-spin{% if spin_src != '' %} data-spin-src="{{ spin_src }}"{% endif %}>
  <div class="spin-layout">
    <div class="spin-stage" data-spin-stage>
      {%- if images.size > 0 -%}
        {{ images[0] | image_url: width: 1400 | image_tag: class: 'spin-still', data-spin-still: '', loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 40vw, 100vw', alt: images[0].alt | default: product.title | escape }}
      {%- else -%}
        <div class="spin-still spin-still--drawn" data-spin-still>{% render 'ubc-bike-illustration' %}</div>
      {%- endif -%}
      <canvas class="spin-canvas" data-spin-canvas width="1080" height="1440" aria-hidden="true"></canvas>
      {%- for block in section.blocks -%}
        <div class="spin-pin" style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%;" {{ block.shopify_attributes }}>
          <button type="button" class="spin-pin-btn" aria-describedby="SpinTip-{{ block.id }}">
            <span class="visually-hidden">{{ block.settings.title | escape }}</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="12" height="12"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
          </button>
          <span class="spin-tip{% if block.settings.x > 50 %} spin-tip--left{% endif %}" role="tooltip" id="SpinTip-{{ block.id }}"><strong>{{ block.settings.title | escape }}</strong>{{ block.settings.text | escape }}</span>
        </div>
      {%- endfor -%}
      <p class="spin-readout" data-spin-readout hidden>
        <span>{{ 'ubc.motion.drag_to_rotate' | t }}</span>
        <span class="spin-track" aria-hidden="true"><span data-spin-dot></span></span>
        <span class="spin-deg" data-spin-deg aria-hidden="true">000°</span>
      </p>
    </div>

    <div class="spin-card spin-card--info">
      <nav class="spin-crumb" aria-label="{{ 'ubc.motion.breadcrumb' | t }}"><a href="{{ routes.root_url }}">{{ 'ubc.motion.home' | t }}</a> / {% if product.type != blank %}{{ product.type | escape }}{% else %}{{ product.vendor | escape }}{% endif %}</nav>
      <h1 class="spin-name">{{ product.title | escape }}</h1>
      <div class="spin-price-row">
        <p class="spin-price">{{ v.price | money }}{% if v.compare_at_price > v.price %} <s><span class="visually-hidden">{{ 'ubc.products.regular_price' | t }}</span>{{ v.compare_at_price | money }}</s>{% endif %}</p>
        {% render 'ubc-availability', variant: v, detailed: true %}
      </div>
      <div class="spin-acc" data-spin-acc>
        {%- if product.description != blank -%}
          <details open><summary>{{ 'ubc.motion.description' | t }}<span aria-hidden="true"></span></summary><div class="spin-acc-body rte">{{ product.description }}</div></details>
        {%- endif -%}
        {%- if section.settings.fit != blank -%}
          <details><summary>{{ 'ubc.motion.fit' | t }}<span aria-hidden="true"></span></summary><div class="spin-acc-body rte">{{ section.settings.fit }}</div></details>
        {%- endif -%}
        {%- if section.settings.service != blank -%}
          <details><summary>{{ 'ubc.motion.service' | t }}<span aria-hidden="true"></span></summary><div class="spin-acc-body rte">{{ section.settings.service }}</div></details>
        {%- endif -%}
        <details><summary>{{ 'ubc.motion.pickup' | t }}<span aria-hidden="true"></span></summary><div class="spin-acc-body rte"><p>{{ 'ubc.products.special_order_explainer' | t }}</p>{{ section.settings.pickup }}</div></details>
      </div>
      {%- if images.size > 1 -%}
        <div class="spin-views" data-spin-views>
          <button type="button" class="spin-view is-active" data-spin-view="0" data-src="{{ images[0] | image_url: width: 1400 }}">
            {{ images[0] | image_url: width: 140 | image_tag: loading: 'lazy', alt: '' }}<span class="visually-hidden">{{ 'ubc.motion.view_front' | t }}</span>
          </button>
          <button type="button" class="spin-view" data-spin-view="0.5" data-src="{{ images[1] | image_url: width: 1400 }}">
            {{ images[1] | image_url: width: 140 | image_tag: loading: 'lazy', alt: '' }}<span class="visually-hidden">{{ 'ubc.motion.view_back' | t }}</span>
          </button>
        </div>
      {%- endif -%}
    </div>

    <div class="spin-card spin-card--buy">
      {%- form 'product', product, class: 'spin-form', data-quick-add: '', data-fly: '', data-added-label: added_label -%}
        {%- if product.has_only_default_variant -%}
          <input type="hidden" name="id" value="{{ v.id }}">
        {%- else -%}
          <fieldset class="spin-sizes" data-spin-sizes>
            <legend>{{ product.options.first | escape }}</legend>
            <span class="spin-hl" aria-hidden="true" data-spin-hl></span>
            {%- for variant in product.variants -%}
              <label class="spin-size">
                <input type="radio" name="id" value="{{ variant.id }}"{% if variant.id == v.id %} checked{% endif %}{% unless variant.available %} disabled{% endunless %} data-price="{{ variant.price | money | escape }}">
                <span>{{ variant.title | escape }}</span>
              </label>
            {%- endfor -%}
          </fieldset>
        {%- endif -%}
        {%- if section.settings.size_note != blank -%}<p class="spin-note">{{ section.settings.size_note | escape }}</p>{%- endif -%}
        <input type="hidden" name="quantity" value="1">
        <div class="spin-actions">
          <button type="button" class="spin-save" data-spin-save="{{ product.handle | escape }}" aria-pressed="false">
            <span class="spin-save-off">{{ 'ubc.motion.save' | t }}</span><span class="spin-save-on">{{ 'ubc.motion.saved' | t }}</span>
          </button>
          <button type="submit" class="spin-add" data-spin-add{% unless v.available %} disabled{% endunless %}>
            <span class="spin-add-roll"><span>{%- if v.available -%}{{ 'ubc.products.add_to_cart' | t }}{%- else -%}{{ 'ubc.products.sold_out' | t }}{%- endif -%}</span><span aria-hidden="true">{{ added_label }}</span></span>
          </button>
        </div>
        <p class="form-message" data-form-message role="status"></p>
      {%- endform -%}
      {%- if section.settings.buy_note != blank -%}<p class="spin-note">{{ section.settings.buy_note | escape }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product — 360° spin",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#E4E5E1", "info": "Match the backdrop colour of the turntable video" },
    { "type": "richtext", "id": "fit", "label": "Fit & sizing", "default": "<p>Not sure which size? Come in for a free fitting and test ride.</p>" },
    { "type": "richtext", "id": "service", "label": "Assembly & service", "default": "<p>Assembled, adjusted and safety-checked by UBC mechanics before pickup.</p>" },
    { "type": "richtext", "id": "pickup", "label": "Pickup & returns (extra text)" },
    { "type": "text", "id": "size_note", "label": "Note under sizes", "default": "Free fitting in store." },
    { "type": "text", "id": "buy_note", "label": "Note under the buttons" }
  ],
  "blocks": [
    {
      "type": "pin",
      "name": "Pin",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Frame" },
        { "type": "text", "id": "text", "label": "Text", "default": "Describe this detail using the manufacturer's specs." },
        { "type": "range", "id": "x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Horizontal position (front view)", "default": 50 },
        { "type": "range", "id": "y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Vertical position (front view)", "default": 50 }
      ]
    }
  ]
}
{% endschema %}
