<section class="section container services">
  <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
  <div class="services-grid">
    {%- for block in section.blocks -%}
      <div class="service" {{ block.shopify_attributes }}>
        <h3>{{ block.settings.title | escape }}</h3>
        <div>{{ block.settings.text }}</div>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ 'general.learn_more' | t }}</a>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Services",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Service, rentals and pickup" }],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Bike service" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tune-ups and repairs by UBC mechanics.</p>" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services",
      "blocks": [
        { "type": "service", "settings": { "title": "Bike service & repairs", "text": "<p>Tune-ups, repairs and fittings by UBC mechanics.</p>" } },
        { "type": "service", "settings": { "title": "Rentals", "text": "<p>Rent a bike by the day or week.</p>" } },
        { "type": "service", "settings": { "title": "Pickup or delivery", "text": "<p>Free pickup at UBC. Special-order items arrive in a few days; we tell you the estimate before you buy.</p>" } }
      ]
    }
  ]
}
{% endschema %}
