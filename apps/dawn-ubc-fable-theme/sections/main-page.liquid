{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .ubc-std-page {
    background: #FFFFFF;
    color: #14202D;
    font-family: var(--ubc-font-body, "Barlow", sans-serif);
  }
  .ubc-std-page__wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .ubc-std-page .ubc-ws-hero {
    margin-bottom: 2.8rem;
  }
  .ubc-std-page .ubc-ws-title {
    font-family: var(--label, "Barlow Condensed", sans-serif) !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    font-size: clamp(2.4rem, 3.8vw, 3.8rem) !important;
    line-height: 1.08 !important;
    color: #14202D !important;
    margin: 0 0 1.2rem !important;
    letter-spacing: 0.02em !important;
  }
  .ubc-std-page .ubc-ws-lead {
    font-family: var(--ubc-font-body, "Barlow", sans-serif) !important;
    font-size: 1.65rem;
    line-height: 1.62;
    color: #4A5A6A;
    margin: 0 0 2rem;
    max-width: 64ch;
  }
  .ubc-std-page .ubc-ws-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .ubc-std-page .ubc-ws-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1.1rem 2.2rem;
    border-radius: 999px;
    font-family: var(--ubc-font-body, "Barlow", sans-serif);
    font-size: 1.45rem;
    font-weight: 700;
    text-decoration: none;
    background: #14202D;
    color: #FFFFFF;
    border: 1.5px solid #14202D;
    transition: transform 0.16s ease, background-color 0.16s ease;
  }
  .ubc-std-page .ubc-ws-btn:hover {
    background: #213549;
    border-color: #213549;
    color: #FFFFFF;
    transform: translateY(-1px);
  }
  .ubc-std-page .ubc-ws-btn--ghost {
    background: #FFFFFF;
    color: #14202D;
    border: 1.5px solid rgba(20, 32, 45, 0.28);
  }
  .ubc-std-page .ubc-ws-btn--ghost:hover {
    background: #F3F1E7;
    border-color: #14202D;
    color: #14202D;
  }
  .ubc-std-page__content {
    background: #FFFFFF;
    border: 1px solid rgba(20, 32, 45, 0.1);
    border-radius: 20px;
    padding: clamp(2rem, 3.2vw, 3.4rem);
    box-shadow: 0 12px 30px -24px rgba(20, 32, 45, 0.22);
  }
  .ubc-std-page__content .rte {
    font-family: var(--ubc-font-body, "Barlow", sans-serif);
    color: #14202D;
  }
{%- endstyle -%}

{%- liquid
  assign is_rentals = false
  assign is_tradein = false
  if page.handle == 'bike-rentals' or page.handle contains 'rental'
    assign is_rentals = true
  elsif page.handle contains 'trade-in'
    assign is_tradein = true
  endif
  assign rentals_img = images['ubc-difference-storefront.jpg']
-%}

<div class="ubc-std-page section-{{ section.id }}-padding">
  <div class="ubc-std-page__wrap">
    {%- if is_rentals -%}
      <header class="ubc-ws-hero">
        <div>
          <span class="ubc-ws-kicker">ALAFIA RIVER STATE PARK / TRAILHEAD MTB &amp; E-MTB RENTALS / WALK-INS &amp; BOOKINGS</span>
          <h1 class="ubc-ws-title">{{ page.title | escape }}</h1>
          <p class="ubc-ws-lead">
            Roll straight from our trailhead shop inside Alafia River State Park onto 20+ miles of Florida's best singletrack. Full-suspension mountain bikes, e-MTBs, and helmets prepped daily by UBC mechanics — no bike rack needed.
          </p>
          <div class="ubc-ws-actions">
            <a class="ubc-ws-btn" href="tel:+18134598293">Call Alafia (813) 459-8293</a>
            <a class="ubc-ws-btn ubc-ws-btn--ghost" href="/pages/alafia-interactive-map">Alafia Interactive Map</a>
            <a class="ubc-ws-btn ubc-ws-btn--ghost" href="/pages/locations">Hours &amp; Directions</a>
          </div>
        </div>
        <div class="ubc-ws-hero-media">
          <img src="{{ 'alafia-mtb-action.jpg' | asset_url }}" alt="Mountain biker riding Florida singletrack at Alafia River State Park" loading="eager" width="960" height="540" style="width:100%;height:100%;object-fit:cover;border-radius:14px;display:block;">
        </div>
      </header>

      <section style="margin:24px 0 28px;" aria-label="Inside our Alafia River State Park trailhead shop">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px;">
          <figure style="margin:0;background:#FFFFFF;border:1px solid rgba(20,32,45,0.1);border-radius:16px;overflow:hidden;">
            <div style="aspect-ratio:16/10;overflow:hidden;background:#14202D;">
              <img src="{{ 'ubc-alafia-container.jpg' | asset_url }}" alt="UBC Alafia River State Park trailhead rental container shop" loading="lazy" width="1600" height="1200" style="width:100%;height:100%;object-fit:cover;display:block;">
            </div>
            <figcaption style="padding:14px 16px;">
              <strong style="display:block;font-family:'Barlow Condensed',sans-serif;font-size:18px;letter-spacing:0.03em;text-transform:uppercase;color:#14202D;" data-es="Tienda Oficial en el Parque">Trailhead Outpost Shop</strong>
              <span style="display:block;margin-top:4px;font-size:13.5px;line-height:1.45;color:#475569;" data-es="Nuestra sede oficial de rentas UBC justo dentro de Alafia River State Park.">Our official UBC rental outpost right inside Alafia River State Park.</span>
            </figcaption>
          </figure>

          <figure style="margin:0;background:#FFFFFF;border:1px solid rgba(20,32,45,0.1);border-radius:16px;overflow:hidden;">
            <div style="aspect-ratio:16/10;overflow:hidden;background:#14202D;">
              <img src="{{ 'ubc-alafia-deck.jpg' | asset_url }}" alt="Alafia trailhead wooden deck, rental price board, and air station" loading="lazy" width="1400" height="1866" style="width:100%;height:100%;object-fit:cover;object-position:center 38%;display:block;">
            </div>
            <figcaption style="padding:14px 16px;">
              <strong style="display:block;font-family:'Barlow Condensed',sans-serif;font-size:18px;letter-spacing:0.03em;text-transform:uppercase;color:#14202D;" data-es="Deck de Rentas y Estación de Aire">Rental Deck &amp; Air Station</strong>
              <span style="display:block;margin-top:4px;font-size:13.5px;line-height:1.45;color:#475569;" data-es="MTB doble suspensión, e-MTBs, estación de aire y repuestos a pasos del sendero.">Full-suspension MTBs, e-MTBs, air station, and trail essentials steps from the dirt.</span>
            </figcaption>
          </figure>

          <figure style="margin:0;background:#FFFFFF;border:1px solid rgba(20,32,45,0.1);border-radius:16px;overflow:hidden;">
            <div style="aspect-ratio:16/10;overflow:hidden;background:#14202D;">
              <img src="{{ 'ubc-alafia-riders.jpg' | asset_url }}" alt="Riders gathered at Alafia River State Park trails" loading="lazy" width="1024" height="768" style="width:100%;height:100%;object-fit:cover;object-position:center 22%;display:block;">
            </div>
            <figcaption style="padding:14px 16px;">
              <strong style="display:block;font-family:'Barlow Condensed',sans-serif;font-size:18px;letter-spacing:0.03em;text-transform:uppercase;color:#14202D;" data-es="Comunidad de Sendero">Tampa Bay Trail Community</strong>
              <span style="display:block;margin-top:4px;font-size:13.5px;line-height:1.45;color:#475569;" data-es="Rodadas en grupo, fines de semana y ciclistas de toda Florida saliendo directo a los trails.">Weekend group rides and riders from across Florida rolling straight onto the trails.</span>
            </figcaption>
          </figure>
        </div>
      </section>
    {%- elsif is_tradein -%}
      <header class="ubc-ws-hero ubc-ws-hero--text-only ubc-ws-hero--compact">
        <div>
          <div style="margin-bottom:12px;">
            <img src="{{ 'logo-bicycle-blue-book.png' | asset_url }}" alt="BicycleBlueBook.com" loading="eager" width="180" height="36" style="max-height:36px;width:auto;display:block;">
          </div>
          <span class="ubc-ws-kicker">OFFICIAL BICYCLEBLUEBOOK.COM PARTNER / INSTANT IN-STORE CREDIT / TAMPA SHOWROOM</span>
          <h1 class="ubc-ws-title">{{ page.title | escape }}</h1>
          <p class="ubc-ws-lead">
            Get an instant valuation for your current bicycle using the official BicycleBlueBook.com calculator below, then bring your bike to University Bicycle Center Tampa (1220 E Fletcher Ave) to apply your credit toward a new bike, e-bike, or gear.
          </p>
          <div class="ubc-ws-actions">
            <a class="ubc-ws-btn" href="tel:+18139712277">Call Tampa (813) 971-2277</a>
            <a class="ubc-ws-btn ubc-ws-btn--ghost" href="/pages/locations">How To Find Us</a>
            <a class="ubc-ws-btn ubc-ws-btn--ghost" href="/pages/financing">0% APR Financing</a>
          </div>
        </div>
      </header>
    {%- else -%}
      <header class="ubc-ws-hero ubc-ws-hero--text-only ubc-ws-hero--compact">
        <div>
          <span class="ubc-ws-kicker">UNIVERSITY BICYCLE CENTER / TAMPA &amp; ALAFIA SINCE 1972</span>
          <h1 class="ubc-ws-title">{{ page.title | escape }}</h1>
          <div class="ubc-ws-actions">
            <a class="ubc-ws-btn" href="tel:+18139712277">Call (813) 971-2277</a>
            <a class="ubc-ws-btn ubc-ws-btn--ghost" href="/pages/locations">How To Find Us</a>
          </div>
        </div>
      </header>
    {%- endif -%}

    {%- if page.content != blank -%}
      <div class="ubc-std-page__content">
        <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ page.content }}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
