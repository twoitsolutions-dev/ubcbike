                    <li><a href="{% if collections['tires-tubes'] != blank %}{{ collections['tires-tubes'].url }}{% else %}{{ home_anchor }}#new-arrivals{% endif %}" data-es="Llantas y Tubos">Tires &amp; Tubes</a></li>
                    <li><a href="{% if collections['tubes'] != blank %}{{ collections['tubes'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Cámaras">Inner Tubes</a></li>
                    <li><a href="{% if collections['parts-components'] != blank %}{{ collections['parts-components'].url }}{% else %}{{ home_anchor }}#new-arrivals{% endif %}" data-es="Piezas y Transmisión">Parts &amp; Drivetrain</a></li>
                    <li><a href="{% if collections['saddles'] != blank %}{{ collections['saddles'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Sillines">Saddles</a></li>
                    <li><a href="{% if collections['pedals'] != blank %}{{ collections['pedals'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Pedales y Calas">Pedals &amp; Cleats</a></li>
                    <li><a href="{{ routes.collections_url }}/parts-components" data-es="Todos los Componentes">All Components</a></li>
                  </ul>
                </div>
                <div>
                  <h4 data-es="Accesorios y Ropa">Accessories &amp; Apparel</h4>
                  <ul>
                    <li><a href="{% if collections['helmets'] != blank %}{{ collections['helmets'].url }}{% else %}{{ home_anchor }}#new-arrivals{% endif %}" data-es="Cascos y Seguridad">Helmets</a></li>
                    <li><a href="{% if collections['eyewear'] != blank %}{{ collections['eyewear'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Gafas de Sol">Eyewear</a></li>
                    <li><a href="{% if collections['hydration-nutrition'] != blank %}{{ collections['hydration-nutrition'].url }}{% else %}{{ home_anchor }}#new-arrivals{% endif %}" data-es="Hidratación y Nutrición">Hydration &amp; Nutrition</a></li>
                    <li><a href="{% if collections['tools-workshop'] != blank %}{{ collections['tools-workshop'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Herramientas y Bombas">Tools &amp; Pumps</a></li>
                    <li><a href="{% if collections['accessories-gear'] != blank %}{{ collections['accessories-gear'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Todos los Accesorios">All Accessories</a></li>
                    <li><a href="{% if collections['clothing'] != blank %}{{ collections['clothing'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Ropa Ciclista">Apparel</a></li>
                    <li><a href="{% if collections['cycling-shoes'] != blank %}{{ collections['cycling-shoes'].url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-es="Zapatillas de Ciclismo">Shoes</a></li>
                  </ul>
                </div>
                <a class="mega-card" href="{{ routes.collections_url }}/all">
                  <div class="mega-card-media">
                    <img src="{{ 'spz-propero-4.png' | asset_url }}" width="180" height="140" alt="UBC In-Stock Catalog" loading="lazy">
                  </div>
                  <div class="mega-card-body">
                    <span class="mega-kicker" data-es="Catálogo UBC">UBC Pro-Shop</span>
                    <strong data-es="Explora bicis, cascos, llantas y repuestos disponibles hoy en Tampa y Alafia.">Browse in-stock bikes, helmets, tires, parts &amp; gear ready for pickup or shipping.</strong>
                    <span class="mega-cta"><span data-es="Ver catálogo">Shop All Items</span> <svg aria-hidden="true"><use href="#i-arrow"/></svg></span>
                  </div>
                </a>
              </div>
            </div>
          </li>
          <li><a href="/pages/bike-service-repair" data-es="Servicio">Service</a></li>
          <li><a href="/pages/bike-rentals" data-es="Rentas">Rentals</a></li>
          <li><a href="/pages/maps-trails" data-es="Mapas y Senderos">Maps &amp; Trails</a></li>
          <li><a href="/pages/buyers-guide" data-es="Guía">Buyer's Guide</a></li>
          <li><a href="/pages/about-us" data-es="Nosotros">About UBC</a></li>
          <li><a href="/pages/financing" data-es="Financiamiento">Financing</a></li>
          <li><a href="/pages/locations" data-es="Tiendas">Locations</a></li>
          <li><a href="/pages/contact-us" data-es="Contacto">Contact</a></li>
        {%- endif -%}
      </ul>

      <div class="fb-header-tools">
        <button class="fb-icon-btn" id="fbSearchBtn" type="button" aria-label="{{ 'general.search.search' | t }}" aria-expanded="false">
          <svg aria-hidden="true"><use href="#i-search"/></svg>
        </button>
        <a class="fb-icon-btn hide-m" href="{{ routes.account_url | default: routes.root_url }}" aria-label="{{ 'customer.account.title' | t }}">
          <svg aria-hidden="true"><use href="#i-user"/></svg>
        </a>
        <a
          class="fb-icon-btn fb-cart-btn"
          id="fable-cart-icon-trigger"
          href="{{ routes.cart_url }}"
          data-fable-cart-trigger
          role="button"
          aria-haspopup="dialog"
          aria-label="{{ 'templates.cart.cart' | t }}"
        >
          <svg aria-hidden="true"><use href="#i-bag"/></svg>
          <span class="fb-cart-badge" id="fable-cart-count" {% if cart == empty %}hidden{% endif %}>{{ cart.item_count }}</span>
        </a>
        <button class="fb-icon-btn fb-burger" id="fbBurger" type="button" aria-label="{{ 'sections.header.menu' | t }}" aria-expanded="false">
          <svg aria-hidden="true"><use href="#i-menu"/></svg>
        </button>
      </div>
    </div>

    <div class="fb-search-pop" id="fbSearchPop">
      <div class="fb-wrap">
        <form action="{{ routes.search_url }}" method="get" role="search">
          <label class="sr-only" for="fbQ">{{ 'general.search.search' | t }}</label>
          <input
            id="fbQ"
            name="q"
            type="search"
            enterkeyhint="search"
            maxlength="150"
            placeholder="Search 20,000+ items (MIPS helmets, GP5000 tires, Skratch, Turbo e-bikes…)"
            data-es-placeholder="Buscar en 20,000+ productos (cascos MIPS, llantas GP5000, Skratch, E-Bikes…)"
            autocomplete="off"
          >
          <button class="fb-btn coral" type="submit"><span data-es="Buscar">{{ 'general.search.search' | t }}</span></button>
        </form>
        <div class="fb-search-tags">
          <span data-es="Populares:">Popular:</span>
          <a href="{{ home_anchor }}#new-arrivals" data-na-jump="deals" data-es="Promociones">Active Promos</a>
          <a href="{{ routes.search_url }}?q=Helmet" data-es="Cascos MIPS">MIPS Helmets</a>
          <a href="{{ home_anchor }}#new-arrivals" data-na-jump="nutrition" data-es="Hidratación Skratch">Skratch Hydration</a>
          <a href="{{ home_anchor }}#service" data-es="Taller y Tune-Up">Walk-In Tune-Ups</a>
          <a href="{{ routes.search_url }}?q=Turbo">Specialized Turbo</a>
        </div>
      </div>
    </div>
  </header>

  <div class="fb-drawer on-dark" id="fbDrawer" aria-hidden="true">
    <div class="fb-drawer-top">
      <img src="{{ 'fable-logo-white.png' | asset_url }}" width="144" height="30" alt="{{ shop.name | escape }}">
      <div class="fb-drawer-top-actions">
        {%- if section.settings.enable_bilingual_toggle -%}
          {%- if localization.available_languages.size > 1 -%}
            <nav class="fb-lang fb-lang--drawer fb-lang--native" aria-label="{{ 'localization.language_label' | t }}">
              {%- for lang_opt in localization.available_languages -%}
                {%- assign code_short = lang_opt.iso_code | slice: 0, 2 | upcase -%}
                <a
                  href="{{ lang_opt.root_url }}"
                  lang="{{ lang_opt.iso_code }}"
                  hreflang="{{ lang_opt.iso_code }}"
                  {% if lang_opt.iso_code == localization.language.iso_code %}aria-current="true"{% endif %}
                >{{ code_short }}</a>
              {%- endfor -%}
            </nav>
          {%- else -%}
            <div class="fb-lang fb-lang--drawer" role="group" aria-label="Language">
              <button type="button" data-lang="en" aria-pressed="{% if request.locale.iso_code == 'es' %}false{% else %}true{% endif %}">EN</button>
              <button type="button" data-lang="es" aria-pressed="{% if request.locale.iso_code == 'es' %}true{% else %}false{% endif %}">ES</button>
            </div>
          {%- endif -%}
        {%- endif -%}
        <button class="fb-icon-btn fb-drawer-close" id="fbDrawerClose" type="button" aria-label="{{ 'accessibility.close' | t }}">
          <svg aria-hidden="true"><use href="#i-x"/></svg>
        </button>
      </div>
    </div>

    <nav aria-label="Mobile navigation">
      {%- if drawer_menu != blank and drawer_menu.links.size > 3 -%}
        {%- for link in drawer_menu.links -%}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
            <span>{{ link.title | escape }}</span>
            <svg aria-hidden="true" width="16" height="16"><use href="#i-arrow"/></svg>
          </a>
          {%- if link.links != blank -%}
            {%- for childlink in link.links -%}
              <a class="fb-drawer-sublink" href="{{ childlink.url }}"{% if childlink.current %} aria-current="page"{% endif %}>
                <span>&mdash; {{ childlink.title | escape }}</span>
              </a>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <a href="{{ home_anchor }}#new-arrivals">
          {%- if edition == 'black_friday' -%}
            <span data-es="Ofertas Black Friday">Black Friday Promos</span><span>Deals</span>
          {%- elsif edition == 'christmas' -%}
            <span data-es="Regalos y Promos Navidad">Holiday Gifts &amp; Promos</span><span>Dec 25</span>
          {%- elsif edition == 'july_4' -%}
            <span data-es="Ofertas 4 de Julio">July 4th Promos</span><span>Summer</span>
          {%- else -%}
            <span data-es="Promos, Eventos y Novedades">Deals, Events &amp; New</span><span data-es="Nuevo">20k+</span>
          {%- endif -%}
        </a>
        <a href="/pages/bike-service-repair"><span data-es="Servicio y Reparación">Bike Service &amp; Repair</span><span data-es="Sin Cita">Walk-In</span></a>
        <a href="/pages/bike-rentals"><span data-es="Alquiler en Alafia River">Alafia River Rentals</span><span>Park</span></a>
        <a href="/pages/maps-trails"><span data-es="Mapas y Senderos">Maps &amp; Trails</span><span>Trails</span></a>
        <a href="/pages/buyers-guide"><span data-es="Guía de Compra">Buyer's Guide</span><span>Sizing</span></a>
        <a href="/pages/about-us"><span data-es="La Diferencia UBC">The UBC Difference</span><span>1972</span></a>
        <a href="/pages/why-shop-at-ubc"><span data-es="5 Razones para Comprar en UBC">5 Reasons to Buy at UBC</span><span>50+ yrs</span></a>
        <a href="/pages/financing"><span data-es="Financiamiento 0% APR">Financing</span><span>0% APR</span></a>
        <a href="/pages/locations"><span data-es="Tiendas y Cómo Llegar">How To Find Us</span><span>Tampa + Lithia</span></a>
        <a href="/pages/contact-us"><span data-es="Contáctanos">Contact Us</span><span>Info</span></a>
      {%- endif -%}
    </nav>

    <div class="fb-drawer-foot">
      <a class="fb-btn coral" href="tel:{{ phone_tel }}">
        <svg aria-hidden="true"><use href="#i-phone"/></svg>
        <span>{{ raw_phone | escape }}</span>
      </a>
      <a class="fb-btn ghost-light" href="{{ routes.all_products_collection_url }}">
        <span data-es="Ver todo el catálogo">Browse Full Catalog</span>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "UBC Ecommerce Header",
  "class": "shopify-section-fable-header",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Primary navigation menu (Shopify Navigation)"
    },
    {
      "type": "link_list",
      "id": "mobile_menu",
      "label": "Mobile drawer menu (optional override)"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Showroom phone number",
      "default": "(813) 971-2277"
    },
    {
      "type": "checkbox",
      "id": "enable_bilingual_toggle",
      "label": "Enable EN / ES language switcher",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "UBC Ecommerce Header"
    }
  ]
}
{% endschema %}
