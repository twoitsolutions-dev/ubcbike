      <div class="fb-topbar-right">
        <a class="fb-topbar-phone" href="tel:{{ phone_tel }}">{{ raw_phone | escape }}</a>
        {%- if section.settings.enable_bilingual_toggle -%}
          {%- if localization.available_languages.size > 1 -%}
            <nav class="fb-lang fb-lang--native" aria-label="{{ 'localization.language_label' | t }}">
              {%- for lang_opt in localization.available_languages -%}
                {%- assign code_short = lang_opt.iso_code | slice: 0, 2 | upcase -%}
                <a
                  href="{{ lang_opt.root_url }}"
                  lang="{{ lang_opt.iso_code }}"
                  hreflang="{{ lang_opt.iso_code }}"
                  {% if lang_opt.iso_code == localization.language.iso_code %}aria-current="true"{% endif %}
                >{{ code_short }}</a>
              {%- endfor -%}
            </nav>
          {%- else -%}
            <div class="fb-lang" role="group" aria-label="Language">
              <button type="button" data-lang="en" aria-pressed="{% if request.locale.iso_code == 'es' %}false{% else %}true{% endif %}">EN</button>
              <button type="button" data-lang="es" aria-pressed="{% if request.locale.iso_code == 'es' %}true{% else %}false{% endif %}">ES</button>
            </div>
          {%- endif -%}
        {%- endif -%}
