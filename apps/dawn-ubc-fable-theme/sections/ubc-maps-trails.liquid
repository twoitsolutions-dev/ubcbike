<style>
  .ubc-mt {
    font-family: var(--body, "Barlow", -apple-system, BlinkMacSystemFont, sans-serif);
    color: #14202D;
    background: #FEFDF3;
    line-height: 1.45;
  }
  .ubc-mt, .ubc-mt * { box-sizing: border-box; }
  .ubc-mt h1, .ubc-mt h2, .ubc-mt h3, .ubc-mt p { margin: 0; }

  /* Mobile-first container */
  .ubc-mt-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px 20px 56px;
  }

  /* Unified 2-Column UBC Page Hero Card (matches Bike Service & Repair) */
  .ubc-mt-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: center;
    padding: clamp(22px, 3.5vw, 38px);
    margin-bottom: 24px;
    background: #FFFFFF;
    border: 1px solid rgba(20, 32, 45, 0.1);
    border-radius: 20px;
    box-shadow: 0 18px 40px -28px rgba(20, 32, 45, 0.25);
  }
  @media (min-width: 820px) {
    .ubc-mt-hero {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 32px;
    }
  }
  .ubc-mt-hero-media {
    border-radius: 14px;
    overflow: hidden;
    background: #14202D;
    aspect-ratio: 16 / 10;
  }
  .ubc-mt-hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ubc-mt-kicker {
    font-family: var(--label, "Barlow Condensed", sans-serif);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #E04F33;
    margin-bottom: 6px;
  }
  .ubc-mt-hero h1 {
    font-family: var(--display, "Anton", sans-serif);
    font-weight: 400;
    font-size: clamp(34px, 5vw, 52px);
    letter-spacing: 0.01em;
    color: #14202D;
    line-height: 1.04;
  }
  .ubc-mt-hero p {
    font-size: 16px;
    color: #4A5A6A;
    margin-top: 10px;
    max-width: 62ch;
    line-height: 1.55;
  }
  .ubc-mt-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 16px;
  }
  .ubc-mt-btn--navy {
    background: #14202D;
    color: #FFFFFF;
    border: 1.5px solid #14202D;
  }
  .ubc-mt-btn--navy:hover {
    background: #213549;
    border-color: #213549;
    color: #FFFFFF;
  }
  .ubc-mt-btn--ghost {
    background: #FFFFFF;
    color: #14202D;
    border: 1.5px solid rgba(20, 32, 45, 0.28);
  }
  .ubc-mt-btn--ghost:hover {
    background: #F3F1E7;
    border-color: #14202D;
    color: #14202D;
  }

  /* Controls row: 2 clean tabs + Book Bike Rental CTA */
  .ubc-mt-bar {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 20px;
  }
  .ubc-mt-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: #F1F5F9;
    padding: 4px;
    border-radius: 999px;
    border: 1px solid rgba(20, 32, 45, 0.1);
  }
  .ubc-mt-tab {
    border: none;
    background: transparent;
    color: #475569;
    font-family: var(--label, "Barlow Condensed", sans-serif);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 10px 16px;
    min-height: 44px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .ubc-mt-tab.is-active {
    background: #14202D;
    color: #FFFFFF;
    box-shadow: 0 3px 10px rgba(20, 32, 45, 0.16);
  }

  .ubc-mt-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 18px;
    min-height: 42px;
    border-radius: 999px;
    font-family: var(--label, "Barlow Condensed", sans-serif);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.14s ease, background 0.14s ease;
    white-space: nowrap;
  }
  .ubc-mt-btn:hover { transform: translateY(-1px); }
  .ubc-mt-btn--accent {
    background: #E04F33;
    color: #FFFFFF !important;
    box-shadow: 0 4px 14px rgba(224, 79, 51, 0.25);
  }
  .ubc-mt-btn--accent:hover { background: #c94025; }
  .ubc-mt-btn--dark {
    background: #14202D;
    color: #FFFFFF !important;
  }
  .ubc-mt-btn--dark:hover { background: #1e3144; }
  .ubc-mt-btn--outline {
    background: #FFFFFF;
    color: #14202D !important;
    border: 1.5px solid rgba(20, 32, 45, 0.18);
  }
  .ubc-mt-btn--sm { padding: 8px 14px; min-height: 38px; font-size: 13.5px; }

  .ubc-mt-pane { display: none; }
  .ubc-mt-pane.is-active { display: block; }

  /* Featured Alafia Spotlight — Mobile-first stack */
  .ubc-mt-featured {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 22px 20px;
    border-radius: 18px;
    background: linear-gradient(135deg, #14202D 0%, #1D3145 100%);
    color: #FFFFFF;
    margin-bottom: 16px;
    box-shadow: 0 12px 30px rgba(20, 32, 45, 0.13);
  }
  .ubc-mt-feat-badge {
    display: inline-block;
    font-family: var(--label, "Barlow Condensed", sans-serif);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(224, 79, 51, 0.22);
    color: #FF8E77;
    border: 1px solid rgba(224, 79, 51, 0.45);
    padding: 3px 10px;
    border-radius: 999px;
    margin-bottom: 8px;
  }
  .ubc-mt-featured h2 {
    font-family: var(--display, "Anton", sans-serif);
    font-weight: 400;
    font-size: clamp(24px, 5vw, 32px);
    letter-spacing: 0.015em;
    color: #FFFFFF;
    margin-bottom: 6px;
  }
  .ubc-mt-featured p {
    font-size: 14.5px;
    color: #CBD5E1;
    margin-bottom: 14px;
    max-width: 540px;
  }
  .ubc-mt-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .ubc-mt-feat-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .ubc-mt-stat {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 10px 8px;
    text-align: center;
  }
  .ubc-mt-stat strong {
    display: block;
    font-family: var(--display, "Anton", sans-serif);
    font-weight: 400;
    font-size: 20px;
    color: #FFFFFF;
  }
  .ubc-mt-stat span {
    font-family: var(--label, "Barlow Condensed", sans-serif);
    font-size: 11.5px;
    color: #94A3B8;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-weight: 700;
  }

  /* Interactive Parks Grid — 1 col mobile -> 2 col tablet -> 3 col desktop */
  .ubc-mt-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .ubc-mt-card {
    border: 1px solid rgba(20, 32, 45, 0.11);
    border-radius: 16px;
    padding: 18px;
    background: #FFFFFF;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .ubc-mt-card:hover {
    border-color: rgba(20, 32, 45, 0.28);
    box-shadow: 0 8px 22px rgba(20, 32, 45, 0.06);
  }
  .ubc-mt-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }
  .ubc-mt-loc {
    font-family: var(--label, "Barlow Condensed", sans-serif);
    font-size: 12.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748B;
  }
  .ubc-mt-dots { display: inline-flex; gap: 4px; align-items: center; }
  .ubc-mt-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .ubc-mt-dot.g { background: #16A34A; }
  .ubc-mt-dot.b { background: #2563EB; }
  .ubc-mt-dot.k { background: #111827; }
  .ubc-mt-dot.r { background: #DC2626; }
  .ubc-mt-card h3 {
    font-family: var(--display, "Anton", sans-serif);
    font-weight: 400;
    font-size: 21px;
    letter-spacing: 0.01em;
    color: #14202D;
    margin-bottom: 5px;
  }
  .ubc-mt-card p { font-size: 14px; color: #475569; }

  .ubc-mt-card--featured {
    background: linear-gradient(145deg, #14202D 0%, #1E3347 100%);
    border-color: #14202D;
    color: #FFFFFF;
    box-shadow: 0 10px 26px rgba(20, 32, 45, 0.14);
  }
  .ubc-mt-card--featured .ubc-mt-loc { color: #FF8E77; }
  .ubc-mt-card--featured h3 { color: #FFFFFF; }
  .ubc-mt-card--featured p { color: #CBD5E1; }

  /* Downloadable / Printable Grid — 1 col mobile -> 2 col desktop */
  .ubc-mt-dl-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .ubc-mt-dl-item {
    display: flex;
    align-items: center;
    gap: 14px;
    background: #FFFFFF;
    border: 1px solid rgba(20, 32, 45, 0.11);
    border-radius: 14px;
    padding: 12px 14px;
  }
  .ubc-mt-thumb {
    width: 72px;
    height: 72px;
    border-radius: 10px;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid rgba(20, 32, 45, 0.1);
    background: #E2E8F0;
  }
  .ubc-mt-dl-info { flex: 1; min-width: 0; }
  .ubc-mt-dl-info h3 {
    font-family: var(--display, "Anton", sans-serif);
    font-weight: 400;
    font-size: 19px;
    letter-spacing: 0.01em;
    color: #14202D;
    margin-bottom: 2px;
  }
  .ubc-mt-dl-info p { font-size: 13px; color: #64748B; margin-bottom: 8px; }
  .ubc-mt-dl-btns { display: flex; gap: 8px; flex-wrap: wrap; }

  @media (min-width: 700px) {
    .ubc-mt-wrap { padding: 32px 24px 60px; }
    .ubc-mt-hero { flex-direction: row; justify-content: space-between; align-items: flex-end; }
    .ubc-mt-bar { flex-direction: row; justify-content: space-between; align-items: center; }
    .ubc-mt-tabs { display: inline-grid; grid-template-columns: auto auto; }
    .ubc-mt-tab { padding: 10px 24px; }
    .ubc-mt-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ubc-mt-dl-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1000px) {
    .ubc-mt-featured { flex-direction: row; align-items: center; justify-content: space-between; padding: 28px 30px; }
    .ubc-mt-feat-stats { width: 340px; flex-shrink: 0; }
    .ubc-mt-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  }
</style>

