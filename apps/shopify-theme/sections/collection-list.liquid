<section class="section container">
  {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <ul class="tiles">
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      <li class="tile" {{ block.shopify_attributes }}>
        <a href="{% if c != blank %}{{ c.url }}{% else %}{{ routes.collections_url }}{% endif %}">
          {%- if c.featured_image -%}
            {{ c.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: c.title | escape }}
          {%- endif -%}
          <span>{% if c != blank %}{{ c.title | escape }}{% else %}{{ block.settings.label | escape }}{% endif %}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Category tiles",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label (when no collection)", "default": "Category" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "collection", "settings": { "label": "Bikes" } },
        { "type": "collection", "settings": { "label": "Electric Bikes" } },
        { "type": "collection", "settings": { "label": "Parts" } },
        { "type": "collection", "settings": { "label": "Accessories" } }
      ]
    }
  ]
}
{% endschema %}
