    {%- when 'guide' -%}
      {%- assign hero_img = images['ubc-guide-hero.jpg'] -%}
      <section class="ubc-ws-hero{% unless hero_img %} ubc-ws-hero--text-only{% endunless %}">
        <div>
          <span class="ubc-ws-kicker">How to Choose the Right Bicycle?</span>
          <h1 class="ubc-ws-h1">{{ page.title | default: "Buyer's Guide" }}</h1>
          <p class="ubc-ws-lead">Simplify your bike-buying process with key questions: Riding Companions, Preferred Terrain, Past Enjoyment, Address Dislikes, and Budget &amp; Preference.</p>
          <div class="ubc-ws-actions">
            <a class="ubc-ws-btn" href="/collections/bikes">Shop Bikes</a>
            <a class="ubc-ws-btn ubc-ws-btn--ghost" href="/pages/locations">How To Find Us</a>
          </div>
        </div>
        {%- if hero_img -%}
          <div class="ubc-ws-hero-media">
            {{ hero_img | image_url: width: 1100 | image_tag: loading: 'eager', alt: "UBC Bicycle Buyer's Guide" }}
          </div>
        {%- endif -%}
      </section>

      <section class="ubc-ws-section">
        <h2 class="ubc-ws-h2">Types of Bicycles</h2>
        <div class="ubc-ws-grid">
          {%- assign meta_bt = shop.metaobjects.ubc_bike_type_guide.values | sort: 'sort_order' -%}
          {%- if meta_bt.size > 0 -%}
            {%- for bt in meta_bt -%}
              {%- assign bt_img = blank -%}
              {%- if bt.image_filename.value != blank -%}{%- assign bt_img = images[bt.image_filename.value] -%}{%- endif -%}
              <article class="ubc-ws-card">
                {%- if bt_img != blank -%}<div class="ubc-ws-card-media">{{ bt_img | image_url: width: 700 | image_tag: loading: 'lazy', alt: bt.name.value }}</div>{%- endif -%}
                <h3>{{ bt.name.value }}</h3>
                {%- if bt.summary.value != blank -%}<p class="ubc-ws-note">{{ bt.summary.value }}</p>{%- endif -%}
                {%- if bt.cta_url.value != blank -%}
                  <a class="ubc-ws-btn ubc-ws-btn--ghost" href="{{ bt.cta_url.value }}">{{ bt.cta_label.value | default: 'Explore' }}</a>
                {%- endif -%}
              </article>
            {%- endfor -%}
          {%- else -%}
          {%- assign img_road = images['Road_Bikes.jpg'] -%}
          <article class="ubc-ws-card">
            {%- if img_road -%}<div class="ubc-ws-card-media">{{ img_road | image_url: width: 700 | image_tag: loading: 'lazy', alt: 'Road Bikes' }}</div>{%- endif -%}
            <h3>Road Bikes</h3>
            <p class="ubc-ws-note">Fast and easy to pedal on pavement with dropped handlebars and endurance geometry options.</p>
            <a class="ubc-ws-btn ubc-ws-btn--ghost" href="/collections/road-bikes">Shop Road Bikes</a>
          </article>

          {%- assign img_hybrid = images['Hybrid_Bikes.jpg'] -%}
          <article class="ubc-ws-card">
            {%- if img_hybrid -%}<div class="ubc-ws-card-media">{{ img_hybrid | image_url: width: 700 | image_tag: loading: 'lazy', alt: 'Hybrid Bikes' }}</div>{%- endif -%}
            <h3>Hybrid Bikes</h3>
            <p class="ubc-ws-note">Almost as fast as road bikes and as comfortable as mountain bikes — great for commuting, fitness, and errands.</p>
            <a class="ubc-ws-btn ubc-ws-btn--ghost" href="/collections/hybrid-bikes">Shop Hybrid Bikes</a>
          </article>

          {%- assign img_mtb = images['Mountain_Bikes.jpg'] -%}
          <article class="ubc-ws-card">
            {%- if img_mtb -%}<div class="ubc-ws-card-media">{{ img_mtb | image_url: width: 700 | image_tag: loading: 'lazy', alt: 'Mountain Bikes' }}</div>{%- endif -%}
            <h3>Mountain Bikes</h3>
            <p class="ubc-ws-note">Built for off-road trails, dirt, and rocky paths with wider tires and suspension in XC, trail, and enduro styles.</p>
            <a class="ubc-ws-btn ubc-ws-btn--ghost" href="/collections/mountain-bikes">Shop Mountain Bikes</a>
          </article>

          {%- assign img_comfort = images['Comfort_Bikes.jpg'] -%}
          <article class="ubc-ws-card">
            {%- if img_comfort -%}<div class="ubc-ws-card-media">{{ img_comfort | image_url: width: 700 | image_tag: loading: 'lazy', alt: 'Comfort Bikes' }}</div>{%- endif -%}
            <h3>Comfort Bikes</h3>
            <p class="ubc-ws-note">Upright riding position, wide handlebars, plush seat, and flat-resistant tires for relaxed riding.</p>
            <a class="ubc-ws-btn ubc-ws-btn--ghost" href="/collections/hybrid-bikes">Shop Comfort Bikes</a>
          </article>

          {%- assign img_cruiser = images['Cruiser_Bikes.jpg'] -%}
          <article class="ubc-ws-card">
            {%- if img_cruiser -%}<div class="ubc-ws-card-media">{{ img_cruiser | image_url: width: 700 | image_tag: loading: 'lazy', alt: 'Cruiser Bikes' }}</div>{%- endif -%}
            <h3>Cruiser Bikes</h3>
            <p class="ubc-ws-note">Designed for fun and neighborhood or coastal rides at a relaxed pace.</p>
            <a class="ubc-ws-btn ubc-ws-btn--ghost" href="/collections/hybrid-bikes">Shop Cruisers</a>
          </article>

          {%- assign img_rec = images['Recumbent_Bikes.jpg'] -%}
          <article class="ubc-ws-card">
            {%- if img_rec -%}<div class="ubc-ws-card-media">{{ img_rec | image_url: width: 700 | image_tag: loading: 'lazy', alt: 'Recumbent Bikes' }}</div>{%- endif -%}
            <h3>Recumbent Bikes</h3>
            <p class="ubc-ws-note">Known for ergonomic comfort and impressive aerodynamic speed.</p>
            <a class="ubc-ws-btn ubc-ws-btn--ghost" href="/pages/contact-us">Ask Our Team</a>
          </article>
        {%- endif -%}
        </div>
      </section>

      <section class="ubc-ws-section">
        <h2 class="ubc-ws-h2">Bike Size Chart</h2>
        <p class="ubc-ws-note" style="margin-bottom:1.2rem;">General reference for most road, gravel, urban, and hybrid bikes. Visit us for a professional fitting.</p>
        <div class="ubc-ws-table-wrap">
          <table class="ubc-ws-table">
            <thead>
              <tr><th>Rider Height</th><th>Frame Size</th><th>Road / Gravel (cm)</th><th>Mountain / Hybrid</th></tr>
            </thead>
            <tbody>
              {%- assign meta_sizes = shop.metaobjects.ubc_size_chart_row.values | sort: 'sort_order' -%}
              {%- if meta_sizes.size > 0 -%}
                {%- for sz in meta_sizes -%}
                  <tr><td>{{ sz.rider_height.value }}</td><td>{{ sz.frame_size.value }}</td><td>{{ sz.road_gravel_cm.value }}</td><td>{{ sz.mtb_hybrid.value }}</td></tr>
                {%- endfor -%}
              {%- else -%}
                <tr><td>4'10" – 5'2"</td><td>XS</td><td>44 – 49 cm</td><td>13" – 14"</td></tr>
                <tr><td>5'2" – 5'6"</td><td>S</td><td>50 – 52 cm</td><td>15" – 16"</td></tr>
                <tr><td>5'6" – 5'10"</td><td>M</td><td>54 cm</td><td>17" – 18"</td></tr>
                <tr><td>5'10" – 6'1"</td><td>L</td><td>56 – 58 cm</td><td>19" – 20"</td></tr>
                <tr><td>6'1" – 6'5"+</td><td>XL / XXL</td><td>60 – 61+ cm</td><td>21"+</td></tr>
              {%- endif -%}
            </tbody>
          </table>
        </div>
      </section>

  {%- endcase -%}
  {%- if section.settings.show_global_page_content and section.settings.page_kind != 'about' and page.content != blank -%}
    <section class="ubc-ws-section">
      <article class="ubc-ws-card ubc-ws-prose">
        {{ page.content }}
      </article>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "UBC Page Layout",
  "settings": [
    {
      "type": "select",
      "id": "page_kind",
      "label": "Page Layout",
      "default": "about",
      "options": [
        { "value": "service", "label": "Bike Service & Repair" },
        { "value": "contact", "label": "Contact Us" },
        { "value": "locations", "label": "Locations" },
        { "value": "about", "label": "About Us / UBC Difference" },
        { "value": "reasons", "label": "Why Shop At UBC (5 Reasons)" },
        { "value": "financing", "label": "Financing" },
        { "value": "guide", "label": "Buyer's Guide" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_global_page_content",
      "label": "Show global Shopify Page content (editable in Online Store → Pages)",
      "default": false,
      "info": "Content saved in Shopify Pages survives any future theme change. Always enabled on About Us."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "page_bg",
      "label": "Page background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#14202D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / kicker color",
      "default": "#E04F33"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Primary button color",
      "default": "#14202D"
    },
    {
      "type": "header",
      "content": "Shapes & Corners"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "label": "Card corner radius",
      "default": 18
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Button corner radius",
      "default": 40
    }
  ]
}
{% endschema %}
